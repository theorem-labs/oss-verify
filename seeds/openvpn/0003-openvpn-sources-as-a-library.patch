0003-openvpn-sources-as-a-library.patch
Build adaptation.

diff --git a/src/openvpn/Makefile.am b/src/openvpn/Makefile.am
index 7fd12b4828e1610451dc6629fe8011c14011fb5f..1ff1eecb230ee29b328c1d22574680cb111c4a82 100644
--- a/src/openvpn/Makefile.am
+++ b/src/openvpn/Makefile.am
@@ -39,9 +39,9 @@ if WIN32
 AM_CFLAGS += -municode -UUNICODE
 endif
 
-sbin_PROGRAMS = openvpn
+noinst_LTLIBRARIES = liboftopenvpn.la
 
-openvpn_SOURCES = \
+liboftopenvpn_la_SOURCES = \
 	argv.c argv.h \
 	auth_token.c auth_token.h \
 	base64.c base64.h \
@@ -157,7 +157,7 @@ openvpn_SOURCES = \
 	win32.h win32.c \
 	win32-util.h win32-util.c \
 	cryptoapi.h cryptoapi.c
-openvpn_LDADD = \
+liboftopenvpn_la_LIBADD = \
 	$(top_builddir)/src/compat/libcompat.la \
 	$(SOCKETS_LIBS) \
 	$(OPTIONAL_LIBCAPNG_LIBS) \
@@ -171,6 +171,6 @@ openvpn_LDADD = \
 	$(OPTIONAL_DL_LIBS) \
 	$(OPTIONAL_INOTIFY_LIBS)
 if WIN32
-openvpn_SOURCES += openvpn_win32_resources.rc wfp_block.c wfp_block.h
-openvpn_LDADD += -lgdi32 -lws2_32 -lwininet -lcrypt32 -liphlpapi -lwinmm -lfwpuclnt -lrpcrt4 -lncrypt -lsetupapi -lbcrypt
+liboftopenvpn_la_SOURCES += openvpn_win32_resources.rc wfp_block.c wfp_block.h
+liboftopenvpn_la_LIBADD += -lgdi32 -lws2_32 -lwininet -lcrypt32 -liphlpapi -lwinmm -lfwpuclnt -lrpcrt4 -lncrypt -lsetupapi -lbcrypt
 endif
