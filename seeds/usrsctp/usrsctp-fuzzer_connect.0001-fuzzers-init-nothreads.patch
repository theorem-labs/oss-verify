0001-fuzzers-init-nothreads.patch
Platform adaptation.

diff --git a/fuzzer/fuzzer_connect.c b/fuzzer/fuzzer_connect.c
index 0c9b0fde4da24dff6f3787f5f2c2c0fd084e7012..634ce361802139831656759d59669378597fc247 100644
--- a/fuzzer/fuzzer_connect.c
+++ b/fuzzer/fuzzer_connect.c
@@ -136,9 +136,9 @@ handle_upcall(struct socket *sock, void *arg, int flgs)
 int
 initialize_fuzzer(void) {
 #ifdef FUZZ_VERBOSE
-	usrsctp_init(0, conn_output, debug_printf_stack);
+	usrsctp_init_nothreads(0, conn_output, debug_printf_stack);
 #else // FUZZ_VERBOSE
-	usrsctp_init(0, conn_output, NULL);
+	usrsctp_init_nothreads(0, conn_output, NULL);
 #endif // FUZZ_VERBOSE
 
 	usrsctp_enable_crc32c_offload();
diff --git a/fuzzer/fuzzer_fragment.c b/fuzzer/fuzzer_fragment.c
index 9a04a2f70acc58ac5085f587836add9c77631a73..d4fe062f0c9f8b9a8c3887c3e5264001771d937a 100644
--- a/fuzzer/fuzzer_fragment.c
+++ b/fuzzer/fuzzer_fragment.c
@@ -106,7 +106,7 @@ conn_output(void *addr, void *buf, size_t length, uint8_t tos, uint8_t set_df)
 
 int
 initialize_fuzzer(void) {
-	usrsctp_init(0, conn_output, NULL);
+	usrsctp_init_nothreads(0, conn_output, NULL);
 
 	usrsctp_enable_crc32c_offload();
 
