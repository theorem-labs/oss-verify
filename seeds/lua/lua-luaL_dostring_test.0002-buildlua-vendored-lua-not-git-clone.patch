0002-buildlua-vendored-lua-not-git-clone.patch
Reproducible build.

diff --git a/cmake/BuildLua.cmake b/cmake/BuildLua.cmake
--- a/cmake/BuildLua.cmake
+++ b/cmake/BuildLua.cmake
@@ -68,12 +68,29 @@ macro(build_lua LUA_VERSION)
     set(LUA_LIBRARY ${PROJECT_BINARY_DIR}/lua-${LUA_VERSION}/source/liblua.a)
     set(LUA_EXECUTABLE ${LUA_SOURCE_DIR}/lua)
 
+                                                                   
+                                                                               
+                                                                                
+                                                                              
+                                                                              
+                                                                               
+                                                                         
+                                                                           
+                                                                          
+                                                                        
+                                                                          
+                                                                                
+    set(OFT_LUA_VENDORED_COMMIT 7579fc9d7ed90240487251dfb69168f8e64e9294)
+    set(OFT_LUA_VENDORED_DIR ${PROJECT_SOURCE_DIR}/oft-vendor/lua)
+    if(NOT "${LUA_VERSION}" STREQUAL "${OFT_LUA_VENDORED_COMMIT}")
+        message(FATAL_ERROR "oft: LUA_VERSION=${LUA_VERSION} but the vendored lua tree is ${OFT_LUA_VENDORED_COMMIT}; re-vendor oft-vendor/lua as the pin does")
+    endif()
+    if(NOT EXISTS ${OFT_LUA_VENDORED_DIR}/makefile OR NOT EXISTS ${OFT_LUA_VENDORED_DIR}/lapi.c)
+        message(FATAL_ERROR "oft: vendored lua tree missing or incomplete at ${OFT_LUA_VENDORED_DIR} (no makefile / lapi.c)")
+    endif()
+
     ExternalProject_Add(patched-lua
-        GIT_REPOSITORY https://github.com/lua/lua
-        GIT_TAG ${LUA_VERSION}
-        GIT_PROGRESS TRUE
-        GIT_SHALLOW FALSE
-        GIT_REMOTE_UPDATE_STRATEGY REBASE
+        URL ${OFT_LUA_VENDORED_DIR}
 
         SOURCE_DIR ${LUA_SOURCE_DIR}
         BINARY_DIR ${LUA_BINARY_DIR}
@@ -81,7 +98,7 @@ macro(build_lua LUA_VERSION)
         TMP_DIR ${LUA_BINARY_DIR}/tmp
         STAMP_DIR ${LUA_BINARY_DIR}/stamp
 
-        PATCH_COMMAND git reset --hard && cd <SOURCE_DIR> && patch -p1 -i ${LUA_PATCH_PATH}
+        PATCH_COMMAND patch -p1 -i ${LUA_PATCH_PATH}
         CONFIGURE_COMMAND ""
         BUILD_COMMAND cd <SOURCE_DIR> && make -j CC=${CMAKE_C_COMPILER}
                                                  MYCFLAGS=${CFLAGS}
