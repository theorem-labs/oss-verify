0001-cookie-fuzzer-log-close-not-dup2.patch
Platform adaptation.

diff --git a/fuzz/wget_cookie_fuzzer.c b/fuzz/wget_cookie_fuzzer.c
index e2a6d3c045e40143b3d5245f2bfb8b5b27c4b18a..7f9a665c003d002462b8af8cd179a7ce8a498ab0 100644
--- a/fuzz/wget_cookie_fuzzer.c
