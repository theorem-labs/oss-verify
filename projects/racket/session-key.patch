         [else (error "unknown format" format)]))))
 
+;; Derives a gensym session key for one build step from a `--sessionkey`
+;; base and strings that identify the step, or returns #f if the base
+;; is #f or empty; used by Racket's build, too
+(define (session-key-for base . parts)
+  (and base
+       (not (equal? base ""))
+       (~a "k"
+           (substring (string-sha256 (apply ~a (cons base
+                                                     (map (lambda (p) (~a "\0" p))
+                                                          parts))))
+                      0 24)
+           "-")))
+
 (define (make-run-scheme at-source at-dir lookup
                          host-scheme host-workarea host-m
                          [extra-source-dirs '()]
@@ -153,17 +167,10 @@
        (fd-write to (~s `(library-directories '(,@extra-library-dirs
                                                 ,(cons (at-source ".")
                                                        (at-dir "."))))))
-       (let ((session-key-base (lookup 'sessionKey)))
-         (define (session-key-for what)
-           (~a "k"
-               (substring (string-sha256 (~a session-key-base "\0"
-                                             (at-dir ".") "\0"
-                                             what))
-                          0 24)
-               "-"))
-         (when (and session-key-base (not (equal? session-key-base "")))
+       (let ((session-key (session-key-for (lookup 'sessionKey) (at-dir ".") what)))
+         (when session-key
            (fd-write to (~s `(,(string->symbol "#%$set-top-level-value!")
-                              '$session-key ,(session-key-for what))))))
+                              '$session-key ,session-key)))))
        (fd-write to (string-join (map ~s script)))
        (fd-close to)
        (thread-process-wait (hash-ref p 'process))
