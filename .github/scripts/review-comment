#!/usr/bin/env python3
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
"""Write the review comment of an enrollment pull request, or with --kind change of a change (review-change.md), as
build.yaml's comment job posts it.

    review-comment [--review <comment.md>] [--checks <checks.md>] [--head <sha>] [--run <url>] [--previous <comment>]
                   [--served <served>] [--refused] [--kind enrollment|change] [--verdict <verdict.json>]

It prints the comment: the marker that build.yaml's comment job finds it by, a metadata line, what this script writes
(the footer, a notice when the review is not current or did not run, a note where a text was cut), the report of
tools/check --checks as an indented code block, and last the review's comment to the maintainer. The review's text
comes from a model that read the pull request, and the checks text from the project's source, so each is screened on
its own: a text that holds what looks like a credential is refused (and the other kept), and each is cut to a length
that GitHub takes. A review that is nothing but HTML comments that name this script counts as no review.

Neither text is otherwise changed, character for character: Markdown code in them reaches GitHub as written, and so
does an HTML comment, which hides nothing of this script's. What they cannot reach is what this script writes. It all
comes before them; the review comes last, so nothing it leaves open (an HTML comment, a tag, a code fence) has
anything after it to hide; and every line of the checks report is indented four spaces into a code block, which only
a line indented less can end, so nothing in the report can end it early or be read as HTML.

The commit the review is of and whether there is a review live in the metadata line only, the second line of the
comment, which this script alone writes. They are never read from the body, so a marker or a metadata line in either
text is inert. So with --previous and no usable review (the review of this push did not finish, or wrote nothing, or
wrote what is refused), it keeps the comment already posted, unchanged, below a metadata line, a notice that says it
is not current, naming the commit it is of and the commit that had no review, and the footer. Keeping a kept comment
again gives the same comment: what this script wrote above the old one is written afresh, not kept as part of it. A
comment that is the review of this same commit stays the review: as it was posted, or, if it was kept as not current,
written again as the review; but only when it names what answered it (metadata version 3). One posted before the
record existed is kept as not current, with a notice that says what answered it was not recorded.

--verdict is the review's verdict line as review-run took it out of the review (review.md, "The verdict line"): with a
review that is posted, this script writes it on the third line, `<!-- oss-verify-verdict {...} -->`, right after the
metadata line. Only that line is ever read as the verdict; one in the checks report or the review's text is inert. A
comment with no review, or a kept one, has none there.

--served is the record of what answered the review, which .github/scripts/review-served wrote beside it as Claude Code
reported it. The review is posted only when `review-served check` passes that record: the provider and model asked
for, at the provider's own API, answered every turn. Otherwise none of its text is posted, as with a review that is
refused; and when another endpoint, provider or model answered, or the review job refused the review (--refused: in CI
a refused review reaches this script as no text at all), the comment says that the review is not published. Every
comment says what answered, as that check says it: after the footer of a review, the providers and models with their
turns, a paragraph of its own that stays with the review when it is kept; in the notice of a review that is not
published, did not run or is not current, what answered this push's review, or why nothing shows it (no record, no
turn, or a provider or model that is another or that Claude Code did not name).
"""
import argparse
import pathlib
import re
import subprocess
import sys

MARKER = "<!-- oss-verify-review -->"
HEADING = "## Enrollment review"
# A change review's (--kind change, review-change.md): main() puts these in place of HEADING, FOOTER and
# NO_REVIEW_FOOTER. A posted comment is read under either heading; kept, it gets the heading of this run's kind and
# the footer of its own (FOOTERS), which names the file it was written from.
CHANGE_HEADING = "## Change review"
HEADINGS = (HEADING, CHANGE_HEADING)
# GitHub refuses a comment over 65,536 characters; stay below with a margin for the pieces this script adds.
MAX_COMMENT = 65_000
MAX_REVIEW = 40_000
MAX_CHECKS = 20_000
# What a credential looks like: a GitHub identity token (a JWT), an Anthropic token or key, a GitHub token. The scan
# below reads each run of token characters once, rather than a regular expression of these four alternatives, whose
# JWT branch reads the rest of the text again at every "eyJ" that no dot follows.
RUN = re.compile(r"[A-Za-z0-9_-]+")
GITHUB = re.compile(r"gh[opsu]_")
GITHUB_PAT = re.compile(r"github_pat_")
GITHUB_BODY = re.compile(r"[A-Za-z0-9]{20}")
GITHUB_PAT_BODY = re.compile(r"[A-Za-z0-9_]{20}")
ANTHROPIC = "sk-ant-"
JWT = "eyJ"
# The metadata line, always the second line of the comment and written by this script alone: the format version, the
# commit the review is of, and the status (review: a review is here; none: there is none; stale: a kept review that a
# later push's review did not replace). It is the only place the status and the commit are read from. The version is
# the layout: 1, the review first and the footer last (before this layout); 2, what this script writes first, then
# the checks, the review last; 3, the layout of 2, written since the record of .github/scripts/review-served existed:
# a review in it (status review or stale) names what answered it, after the footer. Only in a comment of version 2 or
# 3 is the first paragraph (after a notice) this script's. A review is current again, or kept as posted, only in a
# comment of version 3: one written before the record existed names nothing that answered it, whatever its text says.
META = re.compile(r"^<!-- oss-verify-meta v=(?P<version>[123])"
                  r"(?: head=(?P<head>[0-9a-f]{7,40}))?"
                  r" status=(?P<status>review|none|stale) -->$")
# The no-review paragraph that this script wrote before the metadata line existed, in full: a legacy comment that is
# exactly this has no review to keep. Any other legacy text is a review.
LEGACY_NO_REVIEW = re.compile(r"The review agent did not run on this push: [^\n]*\. "
                              r"A person at Theorem reviews the enrollment\.")


def comment_end(text, start, closes):
    """Where the HTML comment whose <!-- is at start ends, or -1 when nothing ends it. As HTML's tokenizer reads a
    comment (its comment start, comment end and comment end bang states), <!--> and <!---> are whole comments, and
    any other ends at the first --> or --!> after its <!--. closes holds, for each of --> and --!>, where it was last
    found (None: nowhere further on), so that each is searched for from a later place each time and the whole scan
    stays linear in the text."""
    body = start + 4
    if text.startswith(">", body):
        return body + 1
    if text.startswith("->", body):
        return body + 2
    ends = []
    for close in ("-->", "--!>"):
        if closes[close] is not None and closes[close] < body:
            found = text.find(close, body)
            closes[close] = found if found != -1 else None
        if closes[close] is not None:
            ends.append(closes[close] + len(close))
    return min(ends, default=-1)


def neutralize(text):
    """text with each HTML comment that names this script's prefix replaced by a space. It is used only to tell whether
    a review is nothing but such comments (then it is no review); what is posted is the review as written, since
    Markdown shows some of these spans as text (in code, or after a backslash) and the metadata is read from line 2
    only. One forward scan, linear in the text: a comment runs from <!-- to where HTML ends it (comment_end), and the
    space left in its place cannot join the text around it into a new one. A <!-- that nothing closes is left."""
    out, at, closes = [], 0, {"-->": -1, "--!>": -1}
    while (start := text.find("<!--", at)) != -1:
        end = comment_end(text, start, closes)
        if end == -1:
            break
        span = text[start:end]
        out += [text[at:start], " " if "oss-verify" in span.lower() else span]
        at = end
    return "".join(out) + text[at:]


def credential(text):
    """Whether text holds what looks like a credential. One pass: every check below is bounded, and each run of token
    characters is read a fixed number of times, so the cost is linear in the text."""
    runs = [(found.start(), found.group()) for found in RUN.finditer(text)]
    for index, (start, run) in enumerate(runs):
        # An Anthropic token or key: sk-ant- and at least 8 more token characters, all inside this run. The first
        # occurrence has the most of the run after it, so no later one needs trying.
        at = run.find(ANTHROPIC)
        if at != -1 and len(run) - at - len(ANTHROPIC) >= 8:
            return True
        # A GitHub token: its prefix and 20 more characters of the right kind, tried at each prefix (an earlier one can
        # fail where a later one matches). Each try reads at most 20 characters, and prefixes do not overlap.
        for prefix, body in ((GITHUB, GITHUB_BODY), (GITHUB_PAT, GITHUB_PAT_BODY)):
            for found in prefix.finditer(run):
                if body.match(run, found.end()):
                    return True
        # A JWT: eyJ, at least 10 more token characters, a dot, and at least 10 more. A dot ends a run, so the dot can
        # only be the character after this run, and the second part can only be the run after it.
        at = run.find(JWT)
        after = start + len(run)
        if (at != -1 and len(run) - at - len(JWT) >= 10 and text[after:after + 1] == "."
                and index + 1 < len(runs) and runs[index + 1][0] == after + 1 and len(runs[index + 1][1]) >= 10):
            return True
    return False


# CommonMark's line endings: a carriage return alone ends a line too.
LINE_END = re.compile(r"\r\n|\r|\n")
INDENT = "    "


def code_block(text, limit):
    """(block, whole): text as an indented code block of at most limit characters, and whether all of text is in it.
    Every line is put four spaces in, so every line is code: an indented code block ends only at a line indented less,
    and none is, and GitHub reads nothing in a code block as Markdown or HTML. Not a fenced block: GitHub's renderer
    closes a fence of more than 255 backticks at any line of 255 or more, so no fence is longer than every run."""
    lines, size = [], 0
    for line in LINE_END.split(text):
        line = INDENT + line
        if size + len(line) > limit:
            lines.append(line[:max(0, limit - size)].rstrip())
            return "\n".join(lines).rstrip(), False
        lines.append(line)
        size += len(line) + 1
    return "\n".join(lines), True


def meta_line(head, status, version=3):
    return f"<!-- oss-verify-meta v={version}{f' head={head}' if head else ''} status={status} -->"


# The verdict as review-run writes it: one JSON object on one line, with no > (written \u003e), so that it cannot end
# the HTML comment around it.
VERDICT = re.compile(r"\{[^\r\n>]*\}")


# Blank lines, as CommonMark has them: nothing but spaces and tabs.
LEADING_BLANK = re.compile(r"(?:[ \t]*\n)+")


def trim(text):
    """text without its leading blank lines and its trailing whitespace. Not strip(): the spaces that start the first
    line stay, since they can make it an indented code block."""
    found = LEADING_BLANK.match(text)
    return text[found.end() if found else 0:].rstrip()


def read_previous(previous):
    """The posted comment's (status, head, version, body, heading): status/head/version from the metadata line only,
    None when it is legacy; heading is the one it was posted under, enrollment's when it has none."""
    lines = previous.replace("\r\n", "\n").split("\n")
    status = head = version = None
    if len(lines) >= 2 and lines[0].strip() == MARKER:
        match = META.match(lines[1].strip())
        if match:
            status, head, version = match.group("status"), match.group("head"), match.group("version")
    # The earliest heading in the text is this script's: a review's own text can hold the other one further down.
    found = [(at, heading) for heading in HEADINGS if (at := previous.find("\n" + heading + "\n")) != -1]
    if found:
        start, heading = min(found)
        return status, head, version, trim(previous[start + len(heading) + 2:]), heading
    return status, head, version, trim(previous.replace(MARKER, "")), HEADINGS[0]


FOOTER = "<sub>Claude wrote this review{of} from `review.md`. It can be wrong. Each push replaces it.</sub>"
CHANGE_FOOTER = FOOTER.replace("`review.md`", "`review-change.md`")
FOOTERS = dict(zip(HEADINGS, (FOOTER, CHANGE_FOOTER)))
OLD_FOOTER = ("<sub>Claude wrote this review, following `{doc}`, and `tools/check --checks` measured the checks. It can "
              "be wrong. {of}Each push replaces it, or marks it not current if the push's review does not finish. It "
              "decides nothing: a person at Theorem reviews the enrollment.</sub>")
# The footer as this script writes it, or wrote it before, for any commit: a kept comment loses it from its front, and
# gets this one again.
FOOTER_WRITTEN = re.compile("|".join(r"(?:(?: of |It is the review of )`[0-9a-f]{7}`(?:\. )?)?".join(
    map(re.escape, footer.split("{of}"))) for footer in (FOOTER, CHANGE_FOOTER,
    OLD_FOOTER.replace("{doc}", "review.md"), OLD_FOOTER.replace("{doc}", ".claude/skills/review-enrollment/SKILL.md"))))
# The footer of a comment with no review: no AI review is there, so it says nothing of who wrote one.
NO_REVIEW_FOOTER = "<sub>`tools/check --checks` measured the checks. No AI review of this push is posted.</sub>"
CHANGE_NO_REVIEW_FOOTER = "<sub>No AI review of this push is posted.</sub>"
# What answered the review: after the footer of a review that is posted, and in the notice when there is none.
ANSWERED = "<sub>Answered by `{}`, as Claude Code reported it.</sub>"
ANSWERED_NOTICE = "What answered it, as Claude Code reported it: `{}`."
SERVED = pathlib.Path(__file__).resolve().with_name("review-served")
# The characters of what `review-served check` prints: names it has cleaned, and its own words. No backtick, so the
# line stays inside its code span.
SERVED_LINE = re.compile(r"[A-Za-z0-9 ,.:;@+?/*()\[\]'_-]{1,2000}")
CHECKS_SUMMARY = "<details><summary>What the breakage and coverage checks measured</summary>"
REVIEW_CUT = "The review is cut at {:,} characters: {}."
KEPT_WHERE = "the rest is in an earlier run of the review job"
# The sentence that ends the notice of a kept comment that a keep cut, as this script writes it. It is in the notice,
# which this script alone writes, so no text of the review can be read as it.
KEPT_CUT = re.compile(r" The review is cut at (?P<at>[0-9]{1,3}(?:,[0-9]{3})?) characters: " + re.escape(KEPT_WHERE)
                      + r"\.\Z")


def assemble(head, status, notes, checks="", review="", where="the rest is in the review job's log",
             review_limit=MAX_REVIEW, cut_at=None, cut_in_notice=False, version=3, verdict=""):
    """The comment, at most MAX_COMMENT characters: the marker and metadata, the heading, the notes (what this script
    writes), the checks report as a code block, and the review last. Only the checks and the review are cut, by
    slicing, and a note before them says where; nothing else in them changes. cut_at: where an earlier run cut the
    review, said again if this run need not cut it further. cut_in_notice: that note ends the first note, rather than
    being a paragraph of its own. verdict: the verdict line's JSON, on the third line."""
    notes = list(notes)
    checks, review = trim(checks), trim(review)
    blocks = [f"{MARKER}\n{meta_line(head, status, version)}" + (f"\n<!-- oss-verify-verdict {verdict} -->" if verdict
                                                                  else ""), HEADING, *notes]
    if checks:
        block, whole = code_block(checks, MAX_CHECKS)
        if not whole:
            blocks.append(f"The checks report is cut to fit in {MAX_CHECKS:,} characters: the rest is in the Build "
                          "check's summary.")
        blocks.append(f"{CHECKS_SUMMARY}\n\n{block}\n\n</details>")
    # Room for the review: what is left once every other block, the note it may need and the joins are counted.
    room = MAX_COMMENT - len("\n\n".join(blocks)) - len(REVIEW_CUT.format(10 ** 9, where)) - 6
    limit = max(0, min(review_limit, room))
    if len(review) > limit:
        review, cut_at = review[:limit].rstrip(), limit
    if cut_at is not None:
        if cut_in_notice:
            blocks[2] += " " + REVIEW_CUT.format(cut_at, where)
        else:
            blocks.insert(2 + len(notes), REVIEW_CUT.format(cut_at, where))
    if review:
        blocks.append(review)
    return "\n\n".join(blocks) + "\n"


def served(record):
    """(review-served check's exit status, the line that says what answered) for the record: 0 when the provider and
    model asked for answered every turn, 1 when another endpoint, provider or model answered, and 3 otherwise. A check
    that cannot run, or a line of another shape, shows nothing: 3."""
    try:
        checked = subprocess.run([sys.executable, str(SERVED), "check"], input=record, capture_output=True, text=True,
                                 timeout=60)
        code, line = checked.returncode, checked.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        code, line = 3, ""
    if code not in (0, 1, 3) or not SERVED_LINE.fullmatch(line) or credential(line):
        code, line = 3, "review-served could not check the record of what answered: it is not attributable"
    return code, line


def not_current(previous, head, run, answered=""):
    """The comment already posted, kept: as the review of head when it is that, else marked not the review of head;
    None when it holds no review to keep. answered: what answered head's review, a sentence of the notice."""
    status, of_head, version, body, posted_under = read_previous(previous)
    # A review is the review of head only when it names what answered it (version 3): one posted before review-served
    # existed names nothing, and is kept as not current rather than posted again as the review.
    recorded = version == "3"
    current = bool(head) and of_head == head and status in ("review", "stale") and recorded
    if current and status == "review":
        # A later run for the same commit (a rerun, or an edit of the pull request) wrote no review: this one is
        # still the review of it, kept as posted. GitHub keeps the comment's last newline and `gh --jq` adds one, so
        # one is put back, and a rerun does not add a line each time.
        return previous.rstrip("\n") + "\n"
    paragraphs = body.split("\n\n")
    cut_at = None
    if status == "stale":
        # The notice this script put first last time, and in it where that keep cut the old comment: both are written
        # again below, so the marks do not stack and the old comment is not cut again.
        cut = KEPT_CUT.search(paragraphs[0])
        cut_at = int(cut.group("at").replace(",", "")) if cut else None
        paragraphs = paragraphs[1:]
    # The footer, first after the notice in a comment of this layout (version 2), is written again below too. A review
    # that a keep had cut and that is current again carries the cut sentence at the end of its footer instead. In an
    # older layout the first paragraph is the review's, so nothing is read from it.
    while version in ("2", "3") and paragraphs:
        cut = KEPT_CUT.search(paragraphs[0])
        if not FOOTER_WRITTEN.fullmatch(paragraphs[0][:cut.start()] if cut else paragraphs[0]):
            break
        cut_at = int(cut.group("at").replace(",", "")) if cut else cut_at
        paragraphs = paragraphs[1:]
    body = trim("\n\n".join(paragraphs))
    if status == "none" or not body:
        return None
    if status is None:
        # Legacy, before the metadata line: keep it unless its first paragraph is exactly the no-review sentence this
        # script used to write.
        if LEGACY_NO_REVIEW.fullmatch(body.split("\n\n", 1)[0].strip()):
            return None
        of_head = None
    of = f"`{of_head[:7]}`" if of_head else "an earlier commit"
    footer = FOOTERS[posted_under].format(of=f" of `{of_head[:7]}`" if of_head else "")
    if current:
        # A kept review of this very commit (the pull request went back to it): it is current again.
        return assemble(of_head, "review", [footer], review=body, where=KEPT_WHERE, review_limit=MAX_COMMENT,
                        cut_at=cut_at, cut_in_notice=True)
    this = f"`{head[:7]}`" if head else "the last push"
    where = f" ([the run]({run}))" if run else ""
    unrecorded = "" if recorded else " What answered that review was not recorded."
    note = (f"**Not current:** this is the review of {of}.{unrecorded} The review of {this} did not finish with a "
            f"review that can be posted{where}.{' ' + answered if answered else ''}")
    # The old comment, its checks and review as they were posted, goes last and unchanged, so the notice and the footer
    # above it stay visible whatever it holds; only its length is cut, if it must be.
    return assemble(of_head, "stale", [note, footer], review=body, where=KEPT_WHERE, review_limit=MAX_COMMENT,
                    cut_at=cut_at, cut_in_notice=True, version=3 if recorded else 2)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--review", type=pathlib.Path, help="the review's comment.md")
    parser.add_argument("--checks", type=pathlib.Path, help="the report of tools/check --checks")
    parser.add_argument("--head", default="", help="the commit of the pull request that this run is of")
    parser.add_argument("--run", default="", help="the URL of this run")
    parser.add_argument("--previous", type=pathlib.Path, help="the comment already posted, kept if there is no review")
    parser.add_argument("--holds-credential", action="store_true",
                        help="only read standard input, and exit 0 if it holds what looks like a credential, 3 if not "
                             "(any other status is an error: a caller treats it as a credential)")
    parser.add_argument("--served", type=pathlib.Path,
                        help="the record of what answered the review; without one that passes, it is not posted")
    parser.add_argument("--refused", action="store_true",
                        help="the review job refused the review (review-run's exit 4): it is not published")
    parser.add_argument("--kind", choices=("enrollment", "change"), default="enrollment",
                        help="change: a change review, from review-change.md, with no checks report")
    parser.add_argument("--verdict", type=pathlib.Path, help="the review's verdict line, for the third line")
    options = parser.parse_args()
    if options.holds_credential:
        return 0 if credential(sys.stdin.buffer.read().decode("utf-8", errors="replace")) else 3
    if options.kind == "change":
        global HEADING, FOOTER, NO_REVIEW_FOOTER
        HEADING, FOOTER, NO_REVIEW_FOOTER = CHANGE_HEADING, CHANGE_FOOTER, CHANGE_NO_REVIEW_FOOTER
    head = options.head if re.fullmatch(r"[0-9a-f]{7,40}", options.head) else ""
    run = options.run if re.fullmatch(r"https://[A-Za-z0-9./_-]+", options.run) else ""

    review = options.review.read_text(encoding="utf-8", errors="replace") if options.review else ""
    verdict = options.verdict.read_text(encoding="utf-8", errors="replace").strip() if options.verdict else ""
    verdict = verdict if VERDICT.fullmatch(verdict) else ""
    why = ""
    if credential(review + "\n" + verdict):
        review, why = "", "its text held what looks like a credential, so it was not posted"
    review = trim(review)
    if not neutralize(review).strip():
        review = ""
    record = options.served.read_text(encoding="utf-8", errors="replace") if options.served \
        and options.served.is_file() else ""
    answered_status, answered = served(record)
    # Another endpoint, provider or model answered, the review job refused the review, or nothing shows which answered
    # a review that is here (in CI a refused review reaches this script as no text at all): none of its text is
    # posted, and the comment says that it is not published.
    withheld = answered_status == 1 or options.refused or bool(review) and answered_status != 0
    if withheld:
        review = ""
    notice = ANSWERED_NOTICE.format(answered)
    # No usable review (none, blank, refused, or nothing but this script's markers): keep the one already posted.
    if options.previous and not review:
        previous = options.previous.read_text(encoding="utf-8", errors="replace")
        if credential(previous):
            why = why or ("" if withheld else "it wrote no comment")
            why += ", and the last review held what looks like a credential, so it is not kept"
        else:
            kept = not_current(previous, head, run, notice)
            if kept is not None:
                sys.stdout.write(kept)
                return 0
    of = f" of `{head[:7]}`" if head else ""
    if review:
        notes, status = [FOOTER.format(of=of), ANSWERED.format(answered)], "review"
    else:
        this = f" (`{head[:7]}`)" if head else ""
        where = f" ([the run]({run}))" if run else ""
        if withheld:
            # why: none, a refused review text, or only the clause about the last review (", and ...").
            first = f"The review of this push{this} is not published" + (why if why.startswith(", ") else
                                                                         f": {why}" if why else "")
        else:
            first = f"The review agent did not run on this push{this}: {why or 'it wrote no comment'}"
        notes = [f"{first}{where}. {notice}", NO_REVIEW_FOOTER]
        status = "none"
    checks = options.checks.read_text(encoding="utf-8", errors="replace") if options.checks else ""
    if credential(checks):
        # The checks text comes from the project's source: refused on its own, so a safe review is still posted.
        checks = ("The report held what looks like a credential, so it was not posted. It is in the Build check's "
                  "summary.")
    sys.stdout.write(assemble(head, status, notes, checks=checks, review=review,
                              verdict=verdict if status == "review" else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
