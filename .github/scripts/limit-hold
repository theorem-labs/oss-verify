#!/usr/bin/env bash
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
#
# The newest hold of a pull request or an issue, for a rescreen (build.yaml's route, .github/scripts/review-rescreen):
#
#   GH_TOKEN=<read-only token> REPO=<owner/repo> .github/scripts/limit-hold <number>
#
# Only oss-verify[bot]'s comments that start with <!-- oss-verify-held --> are holds; of them, the one updated last is
# the newest. It prints `<time> <run> <account> <tries> <kind>` when that hold is one that review-rescreen.yml tries
# again: its marker <!-- oss-verify-held-<kind> <run> <tries> --> has the kind limit (OUTSIDE_HOURLY_LIMIT), cap (a
# screened review stopped at SCREENED_HOURLY_CAP) or transient (a screened review that failed or ran out of time),
# names the run whose event was held first, which is a run of build.yaml that a pull request's or an issue's event
# started, and <account> is the account that started it; <tries> counts the screened reviews of the item that failed
# so far (0 when the marker has none). It prints `<time> -` for any other newest hold (one of the screen, one a person
# decides on, or one whose run is not such a run, or that GitHub no longer has: a deleted run), and nothing when there
# is no hold comment. Any other read that fails exits 1.
set -euo pipefail
number=${1:?usage: limit-hold <number>}
[[ $number =~ ^[1-9][0-9]*$ ]] || { echo "limit-hold: not a number: $number" >&2; exit 1; }
hold=$(gh api --paginate "repos/$REPO/issues/$number/comments" --jq '.[]
  | select(.user.login == "oss-verify[bot]" and (.body | startswith("<!-- oss-verify-held -->")))
  | "\(.updated_at) \((.body
      | capture("\n<!-- oss-verify-held-(?<kind>limit|cap|transient) (?<run>[0-9]+)(?: (?<tries>[0-9]+))? -->\n")
      | "\(.run) \(.tries // "0") \(.kind)") // "-")"' \
  | sort | tail -n 1)
[ -n "$hold" ] || exit 0
read -r at run tries kind <<< "$hold"
if [ "$run" != - ]; then
  workflow=$(gh api "repos/$REPO/actions/workflows/build.yaml" --jq .id)
  if ! answer=$(gh api "repos/$REPO/actions/runs/$run" --jq '"\(.workflow_id) \(.event) \(.actor.login)"' 2>&1); then
    [[ $answer == *"(HTTP 404)"* ]] || { echo "limit-hold: run $run could not be read: $answer" >&2; exit 1; }
    answer=""
  fi
  read -r id event login <<< "$answer"
  if [[ $id == "$workflow" && ($event == pull_request_target || $event == issues) \
        && $login =~ ^[A-Za-z0-9-]+(\[bot\])?$ ]]; then
    echo "$at $run $login $tries $kind"
    exit 0
  fi
fi
echo "$at -"
