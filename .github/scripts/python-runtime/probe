#
# The job prebuilt of .github/workflows/toolchain-images.yaml runs this once for each image that it made:
#
#   .github/scripts/python-runtime/probe BASE_IMAGE DERIVED_IMAGE
#
# DERIVED_IMAGE is the image that .github/scripts/python-runtime/make made FROM BASE_IMAGE: BASE_IMAGE with one more
# layer, which holds the CPython runtime of each of the four Python builds in /opt/oft-py/prebuilt/<flav>-<key>/. For
# each of the two images, it builds the builder FROM the image (docker build --build-arg TOOLCHAIN=<image>
# infra/base-builder), as oss-verify check does. Then it builds the project image of tests/fixtures/python-example FROM
# that builder, with the fixture's Dockerfile and the build arguments that oss-verify check gives it, as
# tests/test_builder.py's PythonBuilder does. In it, it runs compile for each of the four builds, with OV_RECORD=1 and
# no network, as oss-verify check does (src/oss_verify/check_build.py, compile_build).
#
# It fails unless:
#   - /opt/oft-py/prebuilt of DERIVED_IMAGE holds exactly one directory <flav>-<key> for each of the four flavs (plain,
#     ubsan, asan, asanubsan), each with runtime/libpython3.11.a, records/compiles.jsonl and manifest, and nothing else;
#   - each build on DERIVED_IMAGE printed the line
#       oft-py: runtime <flav>: took the shipped runtime (/opt/oft-py/prebuilt/<flav>-<key>); ran no CPython configure or make
#     with the directory of its flav, and no line "oft-py: runtime <flav> built in";
#   - each build on BASE_IMAGE printed its line "oft-py: runtime <flav> built in";
#   - the $OUT of each build holds fuzz_example, at least one file of .stripped/, .records/compiles.jsonl with at least
#     one compile record of an object under /work/build/pyrt/ (the runtime's), and .records/flags.json;
#   - every file under the $OUT of each build, by its path and its SHA-256, and each symbolic link there, by its
#     target, is the same on both images: the fuzz targets and their stripped twins, the compile records, the link
#     records and their store, nosan/ and flags.json. The object of a compile record is its output, in its working
#     directory when the output is a relative path, as CPython's make gives it.
# Thus a build that takes the shipped runtime publishes the fuzz targets of a build that builds its own, and
# src/oss_verify/check_links.py reads the same records in both.
#
# What it finds goes to standard output, and to $GITHUB_STEP_SUMMARY when that is set. It exits non-zero when a build or
# a check fails, and 2 on a usage error.
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: probe BASE_IMAGE DERIVED_IMAGE" >&2
  exit 2
fi
base=$1 derived=$2
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=$(cd -- "$here/../../.." && pwd)
fixture=$root/tests/fixtures/python-example
work=$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/python-runtime-probe.XXXXXX")
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/out" "$work/log" "$work/cmp"
# compile hands $OUT to this owner at its end, so that this script can read and remove what it wrote.
owner="$(id -u):$(id -g)"
# The four builds: compile's SANITIZER, and the FLAV that compile gives it.
builds="none:plain undefined:ubsan address:asan address-undefined:asanubsan"
flavs="plain ubsan asan asanubsan"
# The build arguments of oss-verify check: the repository of the fixture's project.yaml, and a commit. PythonBuilder
# gives 40 zeros.
repo=$(awk '$1 == "repo:" { print $2 }' "$fixture/project.yaml")
commit=0000000000000000000000000000000000000000
# jq, on compiles.jsonl: the number of compile records whose object is under /work/build/pyrt/, the runtime's. The object
# is the output, or the working directory and the output when that is a relative path.
RUNTIME_RECORDS='[inputs | fromjson | if (.output | startswith("/")) then .output else .directory + "/" + .output end
  | select(startswith("/work/build/pyrt/"))] | length'

# say WORD...: the words, joined by spaces, as one line in the log and in the step summary.
say() {
  printf '%s\n' "$*"
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then printf '%s\n' "$*" >> "$GITHUB_STEP_SUMMARY"; fi
}

# report TITLE FILE: what FILE holds, under TITLE, in the log and in the step summary.
report() {
  printf '\n%s\n' "$1"
  cat "$2"
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    { printf '\n#### %s\n\n```\n' "$1"; cat "$2"; printf '```\n'; } >> "$GITHUB_STEP_SUMMARY"
  fi
}

# part FLAV PART TITLE: REPLY is "same, <n>" when $work/cmp/base-FLAV.PART and $work/cmp/derived-FLAV.PART are the same,
# n the number of their lines. Else it reports the difference under TITLE, sets failed, and REPLY is "differ".
part() {
  local n
  n=$(grep -c . "$work/cmp/base-$1.$2" || true)
  if diff "$work/cmp/base-$1.$2" "$work/cmp/derived-$1.$2" > "$work/diff.txt"; then
    REPLY="same, $n"
  else
    report "$1: $3 that differ (< base image, > derived image)" "$work/diff.txt"
    failed=1
    REPLY="differ"
  fi
}

tag() { echo "oss-verify-python-runtime/$1:$2"; }

# builder IMAGE KIND: the builder FROM IMAGE.
builder() {
  docker pull --quiet "$1" > /dev/null
  docker build --progress=plain --build-arg "TOOLCHAIN=$1" -t "$(tag builder "$2")" "$root/infra/base-builder"
}

# project KIND: the fixture's project image, FROM the builder of KIND. Its Dockerfile gets its sources with the network.
project() {
  docker build --progress=plain --build-arg "BASE_BUILDER=$(tag builder "$1")" --build-arg "REPO=$repo" \
    --build-arg "COMMIT=$commit" -t "$(tag python-example "$1")" -f "$fixture/Dockerfile" "$fixture"
}

# build KIND SANITIZER FLAV: compile in the project image of KIND, with no network and with OV_RECORD=1, into
# $work/out/KIND-FLAV. Its log goes to $work/log/KIND-FLAV.txt too.
build() {
  mkdir -p "$work/out/$1-$3"
  docker run --rm --init --network=none -e "SANITIZER=$2" -e "OV_OWNER=$owner" -e OV_RECORD=1 \
    -v "$work/out/$1-$3:/out" "$(tag python-example "$1")" compile 2>&1 | tee "$work/log/$1-$3.txt"
}

failed=0
for kind in base derived; do
  if [ "$kind" = base ]; then builder "$base" base; else builder "$derived" derived; fi
  project "$kind"
  for pair in $builds; do
    build "$kind" "${pair%%:*}" "${pair#*:}" ||
      { echo "compile failed: the ${pair#*:} build on the $kind image"; failed=1; }
  done
done

say ""
say "### the prebuilt CPython runtime"
say ""
say "- base image: \`$base\`"
say "- derived image: \`$derived\`"
say ""

# What /opt/oft-py/prebuilt of the derived image holds, each path relative to it.
if docker run --rm --network=none --entrypoint find "$(tag builder derived)" /opt/oft-py/prebuilt -mindepth 1 \
     > "$work/found.txt"; then
  sed 's|^/opt/oft-py/prebuilt/||' "$work/found.txt" | LC_ALL=C sort > "$work/prebuilt.txt"
else
  say "- the derived image has no /opt/oft-py/prebuilt that find can read"
  : > "$work/prebuilt.txt"
  failed=1
fi
others=$(cut -d/ -f1 "$work/prebuilt.txt" | grep -vxE '(plain|ubsan|asan|asanubsan)-[0-9a-f]{64}' | sort -u |
          tr '\n' ' ' || true)
if [ -n "$others" ]; then
  say "- /opt/oft-py/prebuilt of the derived image holds more than a directory <flav>-<key> of each flav: $others"
  failed=1
fi

: > "$work/results.txt"
for flav in $flavs; do
  dirs=$(cut -d/ -f1 "$work/prebuilt.txt" | grep -xE "$flav-[0-9a-f]{64}" | sort -u || true)
  count=$(printf '%s\n' "$dirs" | grep -c . || true)
  if [ "$count" != 1 ]; then
    say "- $flav: /opt/oft-py/prebuilt of the derived image has $count directories $flav-<key>, not one"
    failed=1
    dir=""
  else
    dir=$dirs
    for file in runtime/libpython3.11.a records/compiles.jsonl manifest; do
      grep -qxF "$dir/$file" "$work/prebuilt.txt" ||
        { say "- $flav: the derived image has no /opt/oft-py/prebuilt/$dir/$file"; failed=1; }
    done
  fi

  # The lines of the runtime in the log of each build.
  for kind in base derived; do
    [ -s "$work/log/$kind-$flav.txt" ] || { say "- $flav: the build on the $kind image printed nothing"; failed=1; }
  done
  if ! grep -qE "^oft-py: runtime $flav built in [0-9]+ s" "$work/log/base-$flav.txt"; then
    say "- $flav: the build on the base image printed no line \"oft-py: runtime $flav built in\""
    failed=1
  fi
  # The line names the one directory of this flav. Without one, the check above has failed already.
  took="oft-py: runtime $flav: took the shipped runtime (/opt/oft-py/prebuilt/$dir); ran no CPython configure or make"
  if [ -n "$dir" ] && ! grep -qxF "$took" "$work/log/derived-$flav.txt"; then
    say "- $flav: the build on the derived image printed no line \"$took\""
    failed=1
  fi
  if grep -E "^oft-py: runtime $flav built in " "$work/log/derived-$flav.txt" > "$work/built.txt"; then
    say "- $flav: the build on the derived image built its own runtime: $(cat "$work/built.txt")"
    failed=1
  fi

  # What the build on each image left in $OUT: each file by its path and its SHA-256, each link by its target.
  for kind in base derived; do
    out=$work/out/$kind-$flav cmp=$work/cmp/$kind-$flav
    for file in fuzz_example .records/compiles.jsonl .records/flags.json; do
      [ -s "$out/$file" ] ||
        { say "- $flav: the build on the $kind image left no $file, or an empty one, in \$OUT"; failed=1; }
    done
    : > "$cmp.files"
    if [ -d "$out" ]; then
      (cd "$out" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum &&
        find . -type l -printf '%p -> %l\n' | LC_ALL=C sort) > "$cmp.files"
    fi
  done
  [ "$(grep -c '  \./\.stripped/' "$work/cmp/base-$flav.files" || true)" -gt 0 ] ||
    { say "- $flav: the build on the base image left no stripped fuzz target in \$OUT/.stripped"; failed=1; }
  runtime=0
  if [ -s "$work/out/base-$flav/.records/compiles.jsonl" ]; then
    runtime=$(jq -R -n "$RUNTIME_RECORDS" "$work/out/base-$flav/.records/compiles.jsonl") ||
      { say "- $flav: jq cannot read each compile record of the build on the base image"; runtime=0; failed=1; }
  fi
  [ "$runtime" -gt 0 ] ||
    { say "- $flav: the build on the base image left no compile record of an object under /work/build/pyrt/"
      failed=1; }
  part "$flav" files "the files under \$OUT, by SHA-256,"
  files=$REPLY
  printf '| %s | %s | %s | %s | %s |\n' "$flav" "\`${dir:-none}\`" \
    "$(grep -m 1 -oE "built in [0-9]+ s" "$work/log/base-$flav.txt" || echo "not built")" "$runtime" "$files" \
    >> "$work/results.txt"
done

say ""
say "| build | shipped runtime of the derived image | runtime on the base image | records of the runtime" \
  "| every file under \$OUT (base and derived) |"
say "|---|---|---|---|---|"
while IFS= read -r line; do say "$line"; done < "$work/results.txt"
exit "$failed"
