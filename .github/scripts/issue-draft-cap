#!/usr/bin/env bash
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
#
# The hourly cap on the model runs that issues' own events start (build.yaml, the review job's step "Hold the draft
# at the hourly cap"):
#
#   GH_TOKEN=<token with actions: read> REPO=<owner>/<name> RUN_ID=<this run's id> CAP=<runs an hour> \
#     .github/scripts/issue-draft-cap
#
# This repository is public: anyone with a GitHub account can open an issue, and each issue's event starts a model
# run. This counts this workflow's other runs for an issue's own event (event issues, run name "Issue <n>") made in
# the last hour whose review job ran, in any state but skipped. Under CAP it exits 0, and the draft is made. At CAP or
# over, and when any read fails, it holds the draft: it prints a `::error::HELD: ...` annotation and exits 1, so the
# review job fails before its Review step and the run is red. A held run is never skipped as a pass. The inbound watch
# pages the CI/CD role for each run whose step of that name failed, and a person re-runs the job to make the draft.
set -uo pipefail
cap=${CAP:-6}
held() {
  echo "::error::HELD: $1 This issue's draft waits for a person, who re-runs this job to make it."
  exit 1
}
[[ $cap =~ ^[1-9][0-9]*$ ]] || held "the cap is not a number."
since=$(date -u -d '-1 hour' +%Y-%m-%dT%H:%M:%SZ) || held "the time an hour ago could not be read."
if ! runs=$(gh api --method GET --paginate "repos/$REPO/actions/workflows/build.yaml/runs" -f event=issues \
    -f created=">=$since" -F per_page=100 \
    --jq '.workflow_runs[] | select(.display_title | test("^Issue [0-9]+$")) | .id'); then
  held "the runs of the last hour could not be read."
fi
count=0
for id in $runs; do
  [[ $id =~ ^[0-9]+$ ]] || held "the runs API gave a run id that is not a number."
  [ "$id" = "${RUN_ID:-}" ] && continue
  # Its own assignment, so that a failed read holds instead of reading as no review.
  if ! ran=$(gh api "repos/$REPO/actions/runs/$id/jobs?per_page=100" \
      --jq '[.jobs[] | select(.name == "review" and .conclusion != "skipped")] | length'); then
    held "the jobs of run $id could not be read."
  fi
  [[ $ran =~ ^[0-9]+$ ]] || held "the jobs of run $id could not be read."
  if (( ran > 0 )); then
    count=$((count + 1))
  fi
  if (( count >= cap )); then
    held "$count issue drafts started in the last hour, at the cap of $cap."
  fi
done
echo "$count issue drafts started in the last hour, under the cap of $cap: this draft is made."
