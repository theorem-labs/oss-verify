#!/usr/bin/env python3
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
"""Keep the enrollment review's conversation from one push of a pull request to the next, sealed, so that only this
repository's review job can read it.

    REPO=<owner/name> PR=<number> NAME=<project> REVIEW_CONVERSATION_KEY=<base64 of 32 random bytes> \\
      review-session seal <directory> <file>
    GH_TOKEN=<token that can read the repository's Actions> REPO=... PR=... NAME=... REVIEW_CONVERSATION_KEY=... \\
      review-session restore <directory>

<directory> is review-run's REVIEW_SESSION: `session` (id=, head=, dir=) and the conversation, <id>.jsonl.

Why sealed, and why not the Actions cache: the conversation holds the review's reasoning, which no log or comment
shows. Every pull request's own run, a fork's too, can read the Actions caches of main: a pull_request run's cache
token grants read on refs/heads/main (measured on this repository in pull request #53, run 40290795197), and GitHub
says so ("Anyone who can open a pull request against your repository can read the contents of caches in the base
branch", https://docs.github.com/en/actions/reference/workflows-and-actions/dependency-caching). The review job runs
on pull_request_target, whose cache writes land in main's scope, and are refused there anyway (read-only by default
since https://github.blog/changelog/2026-06-26-read-only-actions-cache-for-untrusted-triggers). So the sealed
conversation is an artifact of the review's run, named enroll-review-<pull request>-<project>, which anyone signed in
to GitHub can download: it is sealed with AES-256-GCM under a key derived from the repository secret
REVIEW_CONVERSATION_KEY, which GitHub never gives a fork's pull_request run. The sealed data names the repository, the
pull request and the project, so a conversation opens only for the review of the same pull request and project.

seal writes <file> from <directory>. restore writes <directory> from the newest artifact of that name that a run of
build.yaml on pull_request_target or workflow_dispatch uploaded and that opens with the key; it skips any other (a
pull request's own run can upload an artifact of any name). With no such artifact, or without the key, it writes
nothing and the review starts fresh; either way it exits 0, and it says which.
"""
import base64
import io
import json
import os
import pathlib
import re
import subprocess
import sys
import zipfile

from cryptography.exceptions import InvalidTag
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.hazmat.primitives.kdf.hkdf import HKDF

VERSION = "oss-verify enroll-review conversation v1"
MAGIC = (VERSION + "\n").encode()
MEMBER = "conversation.sealed"
# The runs whose artifacts are this job's own: build.yaml, on the events that run the default branch's copy of it.
WORKFLOW = ".github/workflows/build.yaml"
EVENTS = ("pull_request_target", "workflow_dispatch")
# The newest artifacts tried, and the most bytes read of one.
TRIES = 10
MAX_BYTES = 64 << 20
ID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
HEAD = re.compile(r"[0-9a-f]{40}")
FOLDER = re.compile(r"-[A-Za-z0-9-]{1,200}")


def say(text):
    print(f"review-session: {text}", flush=True)


def context():
    repo, pr, name = os.environ.get("REPO", ""), os.environ.get("PR", ""), os.environ.get("NAME", "")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo):
        sys.exit("review-session: REPO is not owner/name")
    if not re.fullmatch(r"[0-9]+", pr):
        sys.exit("review-session: PR is not a number")
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,62}", name):
        sys.exit("review-session: NAME is not a project name")
    return repo, pr, name


def artifact_name(pr, name):
    return f"enroll-review-{pr}-{name}"


def associated(repo, pr, name):
    return f"{VERSION}\nrepository={repo}\npull request={pr}\nproject={name}\n".encode()


def key():
    """The AES-256 key, or None (with a warning) when the repository secret is not set."""
    text = os.environ.get("REVIEW_CONVERSATION_KEY", "").strip()
    if not text:
        print("::warning::The repository secret REVIEW_CONVERSATION_KEY is not set, so the review's conversation is "
              "neither restored nor kept, and each push gets a fresh review.", flush=True)
        return None
    try:
        raw = base64.b64decode(text, validate=True)
    except ValueError:
        sys.exit("review-session: REVIEW_CONVERSATION_KEY is not base64")
    if len(raw) < 32:
        sys.exit("review-session: REVIEW_CONVERSATION_KEY holds fewer than 32 bytes")
    return HKDF(algorithm=hashes.SHA256(), length=32, salt=None, info=VERSION.encode()).derive(raw)


def seal(directory, file):
    repo, pr, name = context()
    secret = key()
    if secret is None:
        return
    fields = dict(line.split("=", 1) for line in (directory / "session").read_text().splitlines() if "=" in line)
    conversation_id, head, folder = fields.get("id", ""), fields.get("head", ""), fields.get("dir", "")
    if not (ID.fullmatch(conversation_id) and HEAD.fullmatch(head) and FOLDER.fullmatch(folder)):
        sys.exit(f"review-session: {directory}/session does not name a whole conversation")
    plain = json.dumps({"id": conversation_id, "head": head, "dir": folder,
                        "conversation": (directory / f"{conversation_id}.jsonl").read_text()}).encode()
    nonce = os.urandom(12)
    file.parent.mkdir(parents=True, exist_ok=True)
    file.write_bytes(MAGIC + nonce + AESGCM(secret).encrypt(nonce, plain, associated(repo, pr, name)))
    say(f"sealed the conversation {conversation_id} of the review of {head} into {file}")


def unseal(blob, secret, repo, pr, name):
    """The conversation's fields, or None if the blob is not one sealed for this pull request and project."""
    if not blob.startswith(MAGIC) or len(blob) < len(MAGIC) + 12 + 16:
        return None
    nonce = blob[len(MAGIC):len(MAGIC) + 12]
    try:
        fields = json.loads(AESGCM(secret).decrypt(nonce, blob[len(MAGIC) + 12:], associated(repo, pr, name)))
    except (InvalidTag, ValueError):
        return None
    if not (isinstance(fields, dict) and isinstance(fields.get("conversation"), str)
            and ID.fullmatch(str(fields.get("id"))) and HEAD.fullmatch(str(fields.get("head")))
            and FOLDER.fullmatch(str(fields.get("dir")))):
        return None
    return fields


def gh(path):
    """The body of a GET of the GitHub API, through gh, which takes the token from GH_TOKEN in its environment."""
    return subprocess.run(["gh", "api", path], check=True, capture_output=True, timeout=120).stdout


def restore(directory):
    repo, pr, name = context()
    secret = key()
    if secret is None:
        return
    wanted = artifact_name(pr, name)
    try:
        listed = json.loads(gh(f"repos/{repo}/actions/artifacts?name={wanted}&per_page=100"))["artifacts"]
    except (subprocess.SubprocessError, ValueError, KeyError) as error:
        say(f"could not list the artifacts {wanted} ({type(error).__name__}): a fresh review")
        return
    listed = sorted((a for a in listed if a.get("name") == wanted and not a.get("expired")),
                    key=lambda a: a.get("created_at", ""), reverse=True)
    for artifact in listed[:TRIES]:
        run_id = (artifact.get("workflow_run") or {}).get("id")
        try:
            run = json.loads(gh(f"repos/{repo}/actions/runs/{int(run_id)}"))
            if run.get("path") != WORKFLOW or run.get("event") not in EVENTS \
                    or (run.get("repository") or {}).get("full_name") != repo:
                say(f"skipped the artifact {artifact.get('id')}: run {run_id} is not build.yaml on {' or '.join(EVENTS)}")
                continue
            if int(artifact.get("size_in_bytes", 0)) > MAX_BYTES:
                say(f"skipped the artifact {artifact.get('id')}: larger than {MAX_BYTES} bytes")
                continue
            with zipfile.ZipFile(io.BytesIO(gh(f"repos/{repo}/actions/artifacts/{int(artifact['id'])}/zip"))) as z:
                info = z.getinfo(MEMBER)
                blob = z.read(info) if info.file_size <= MAX_BYTES else b""
        except (subprocess.SubprocessError, ValueError, KeyError, TypeError, zipfile.BadZipFile) as error:
            say(f"could not read the artifact {artifact.get('id')} ({type(error).__name__})")
            continue
        fields = unseal(blob, secret, repo, pr, name)
        if fields is None:
            say(f"skipped the artifact {artifact.get('id')} of run {run_id}: it does not open with the key for "
                f"pull request #{pr} and {name}")
            continue
        directory.mkdir(parents=True, exist_ok=True)
        (directory / f"{fields['id']}.jsonl").write_text(fields["conversation"])
        (directory / "session").write_text(f"id={fields['id']}\nhead={fields['head']}\ndir={fields['dir']}\n")
        say(f"restored the conversation {fields['id']} of the review of {fields['head']}, from run {run_id}")
        return
    say(f"no sealed conversation of an earlier review of pull request #{pr} and {name}: a fresh review")


def main():
    arguments = sys.argv[1:]
    if arguments[:1] == ["seal"] and len(arguments) == 3:
        seal(pathlib.Path(arguments[1]), pathlib.Path(arguments[2]))
    elif arguments[:1] == ["restore"] and len(arguments) == 2:
        restore(pathlib.Path(arguments[1]))
    else:
        sys.exit(__doc__.split("\n\n")[1])


if __name__ == "__main__":
    main()
