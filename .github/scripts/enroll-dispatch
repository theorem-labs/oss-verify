#!/usr/bin/env python3
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
"""Decide what enroll-dispatch.yml does after a run of Build, Validate, Terms, Tests, Maintainer confirmed or Enrollment
merged completes.

    GH_TOKEN=... REPO=theorem-labs/oss-verify RUN_ID=<run> RUN_EVENT=<event> HEAD_SHA=<commit> \
      .github/scripts/enroll-dispatch

RUN_ID, RUN_EVENT and HEAD_SHA are the completed run's. It reads GitHub's API only, with a read-only token: nothing of
the pull request is checked out or run. It writes nine lines to $GITHUB_OUTPUT (and to standard output): decision,
label, pr, project and sha; one line, reason, that says why; and review_passed, review_passed_at and label_at, which
say what happens to the label review-passed (below). A dispatch for a merge writes one more, merged=true, which
enroll-dispatch.yml adds to the event's client_payload. The decision is:

  dispatch  the workflow sends the event enrollment-checked for pr, project and sha
  label     the workflow puts `label` on the pull request, and sends nothing:
              size-review      a plain binary is larger than SIZE_LIMIT, or its size could not be read (a binary the
                               loader maps no executable byte of is one)
              language-paused  the project's language is one whose projects are paused for now
              name-review      the project's name has a dot, which the statements repository's names cannot have
              maintainer-review  the pull request's author is not shown to maintain the repository that `repo`
                               names, by triage.py's maintainer check (the author, not primary_contact), or that
                               repository is not on github.com, or the check could not read it
                               (not when someone other than the author who can label, a member of theorem-labs
                               or one of its Apps, put maintainer-confirmed on after the head commit was pushed:
                               then the check is skipped)
  none      anything else; `reason` says what. Among them: the newest check run Enrollment review of the oss-verify
            App (REVIEW_APP) at the commit for the pull request (its external_id is the pull request's number) is not
            success, or there is none (not yet reviewed); a project.yaml whose language cannot be read. build.yaml's
            comment job writes that check run with the review comment; the Build run's completion runs this again. A
            check run of another pull request at the same commit is not counted.

Which commit, whose pull request, and whose record. A run of a pull request (pull_request_target or pull_request) is
about its head commit, and about the head it came from (the repository and branch of that run). A run of Build
started by hand on main (gh workflow run build.yaml -f pr=<n>) is about the commit its record names, and the head of
the pull request it names: that is how a maintainer has this look again at a pull request whose checks passed before
its Build wrote a record. Any other run, but a merge's (below), is none.

A merge. A run of Enrollment merged (MERGED_WORKFLOW: on pull_request_target, the base branch's copy, which is main's
for a pull request into main; or a replay by hand on main, gh workflow run enroll-merged.yml -f pr=<n>) is about the
pull request its title names ("merged #<n>"), and is decided by decide_merged: that pull request must be merged into
main and its files all under one projects/<name>/; every required check must have passed at its head commit, bound as
below to the head it came from; and the record (below) must be of that commit, pull request and project. Then the size
line, a paused language and the name rule label as above, and else the head commit is sent, with merged=true. The
review (the check run Enrollment review) and the maintainer check (maintainer-review) are not asked:
the person who merged decided them. A run that did not succeed (its job runs for a merge or a replay alone), of another
file, event or branch, or whose title names no pull request, is none. A merge after the statements started is sent
too: the statements repository skips a commit whose facts it made or whose build started in the last 24 hours.

Every required check is bound to its source: each check of REQUIRED_SOURCES, and any other the ruleset of main
requires (rules/branches/main), must have passed at that commit in a run of the workflow file and event
REQUIRED_SOURCES names, whose head commit is that commit and whose head is that head; of those runs, the newest
decides. A check run of the same name from any other run (a fork's own copy of a workflow, a run of another commit, a
second pull request at the same commit from another head) is not counted, and a required check with no entry in
REQUIRED_SOURCES is never passed. pull_request_target runs the default branch's workflow file whatever the pull request
holds, so project-builds, enrollment and terms-accepted cannot be made by the pull request. The record is the artifact
enrollment-record of the Build run whose project-builds check is the bound one (or of the run started by hand), which
build.yaml's record job wrote from project-builds' outputs; every value of it is checked against its shape.

The pull request of any other run is the one the record names. It must be open, into main, from that head, with that
commit as its head commit, and its files must all be under one projects/<name>/, the record's project; it is read again
after its files, and a pull request whose head moved meanwhile is none (the run for the new head decides). A draft pull
request is none: build.yaml runs again on ready_for_review, and that run's completion decides for the pull request once
it is ready.

A pull request that changes a project already enrolled is sent too: its facts are made again at the new commit.

The sizes are read from the ELF headers of the files the project's own build wrote, so a build that rewrites its
program headers can make them small. The statements repository measures its own build again. Its facts pull request
merges after its checks pass and an agent reviews it; no person reviews it.

The label review-passed says that an enrollment passed at its head commit: its statements were started, and Theorem
has no plan to merge or prove it now. enroll-dispatch.yml puts it on and takes it off, as review_passed says: on, off,
or empty for no change. review_passed_at is head for a change at a new head and for a renewal, closed for a close or a
merge, and else empty. label_at is the time of the newest labeled event that the decision judged, for a change at a
new head and for a renewal; the workflow takes the label off only when that event is still the newest. Events of its
former name, passes-not-merging, count as its own. The reason says why the label changes, or why it does not.

The run's pull request is the one the decision names; when a decision none names none (required checks not passed,
say), it is the open pull request into main from the run's head at its commit. A run changes the label only when its
commit is that pull request's head commit and the pull request is open; a late run for an older head changes nothing,
and nor does a none that binds no head (no commit id, a label other than maintainer-confirmed, a run of another
commit, another event). Then:

  The run passes: its decision is dispatch, which it gives only when the review's check run Enrollment review at the
  commit is success (an optional fail of F5 or F8 still gives success). The pull request is an enrollment: its files
  are under one projects/<name>/ (the decision dispatch shows that), and build.yaml's rule for trusted accounts does
  not trust its author, with a clear answer (a read that fails is not one).

  A run that passes for an enrollment puts the label on, unless an account other than the oss-verify App took it off
  that pull request before (an unlabeled event, at any time). When the label is on and older than the run's commit, it
  puts it on again, so that its labeled event is new.
  Any other run leaves the label off, and takes it off only when it is older than the run's commit. So a label stays
  whatever a later run for its own commit decides.

The label is older than the commit when its newest labeled event is before the commit was pushed (the later of the
commit's first Actions run from that head, or the completed run's creation when there is none, and the pull request's
newest force push), or when a pull_request_target run from that head at another of the pull request's commits (at any
other commit, when GitHub lists 250 of them) was made at or after that event. A run whose read of the pull request's
events fails changes nothing. A run of Enrollment merged, a skipped one too, takes the label off the closed pull
request its title names (merged or not) when it carries it, whatever else it decides, and never puts it on.
"""
from __future__ import annotations

import io
import json
import os
import re
import subprocess
import sys
import urllib.parse
import zipfile
from urllib.parse import quote

import yaml

# triage.py's maintainer check, the one the triage table shows as "Opened by an active maintainer".
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import triage  # noqa: E402

# The size line for statements that start with no person's decision, "Up to 1 MB" of a plain binary
# (dispatch://OSSV-141/ask/7c73eb21), the README's "less than 1 MB of code": 1 MB is 1,000,000 bytes here. It is
# applied to the larger of the .text section's size and the bytes the loader maps executable, which renaming or
# resizing a section does not change (tools/manifest.py, executable_bytes); the executable segments can hold
# read-only data too, so the measure errs toward a person's review, never away from it.
SIZE_LIMIT = 1_000_000
# Languages whose projects are paused for now. Go builds, but our tools write no theorem statements for it yet
# (docs/project-yaml.md, "language").
PAUSED_LANGUAGES = frozenset({"python", "go"})
# The workflow file and event each required check must come from. Each is required here whatever the ruleset says, and
# so is any other check the ruleset requires (which, with no source here, is never passed).
REQUIRED_SOURCES = {
    "project-builds": (".github/workflows/build.yaml", "pull_request_target"),
    "enrollment": (".github/workflows/validate.yaml", "pull_request_target"),
    "terms-accepted": (".github/workflows/terms.yaml", "pull_request_target"),
    "tests": (".github/workflows/tests.yaml", "pull_request"),
}
ACTIONS_APP = 15368  # GitHub Actions, the app of every check run above
BUILD_WORKFLOW = ".github/workflows/build.yaml"
RECORD_ARTIFACT = "enrollment-record"
RECORD_SCHEMA = "oss-verify enrollment record v1"
# The review's verdict: the check run REVIEW_CHECK that build.yaml's comment job writes on the reviewed commit with the
# review comment, as the oss-verify App (REVIEW_APP; gh api apps/oss-verify), with the pull request's number as its
# external_id. A check run of the same name from any other App, or of another pull request at the same commit, is not
# counted. Only its conclusion success starts statements; a pull request with no such check run at the commit is
# NOT_REVIEWED.
REVIEW_CHECK = "Enrollment review"
REVIEW_APP = 5447700
NOT_REVIEWED = "not yet reviewed"
# The label that someone other than the author, who can label (a member of theorem-labs, or one of its Apps), puts on an enrollment whose author the maintainer check does not show (a
# pull request that our bot opened at a maintainer's request, for one): with it, the check is skipped. Putting it on
# runs .github/workflows/maintainer-confirmed.yml, whose completion runs this again.
CONFIRMED_LABEL = "maintainer-confirmed"
CONFIRMED_WORKFLOW = ".github/workflows/maintainer-confirmed.yml"
# The workflow whose run says that a pull request was closed, and, in its title, which: its job runs for a merge (or a
# replay of one by hand) alone. Its completion runs this, which sends a merged enrollment (decide_merged).
MERGED_WORKFLOW = ".github/workflows/enroll-merged.yml"
MERGED_TITLE = re.compile(r"merged #([1-9][0-9]*)")
DEFAULT_BRANCH = "main"
# The API lists at most 3,000 files of a pull request; above that, the list is not the whole change.
MAX_LISTED_FILES = 3000
MAX_ARTIFACT_BYTES = 1 << 20
MAX_PROJECT_YAML_BYTES = 256 * 1024
# A project's directory name, as tools/validate.py's NAME takes it, and the statements repository's project names,
# which have no dot.
NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,62}")
STATEMENTS_NAME = re.compile(r"[a-z0-9][a-z0-9_-]{0,62}")
SHA = re.compile(r"[0-9a-f]{40}")
# The label that says an enrollment passed at its head commit: its checks and its review passed, its statements were
# started, and Theorem has no plan to merge or prove it now. The events of a pull request labelled before the label
# was renamed give its former name, so both names count in them.
REVIEW_PASSED = "review-passed"
REVIEW_PASSED_NAMES = frozenset({REVIEW_PASSED, "passes-not-merging"})
# The oss-verify App, whose token enroll-dispatch.yml writes the label with. A removal by any other account is a
# person's, and the label does not go on again.
APP_LOGIN = "oss-verify[bot]"
# build.yaml's rule for trusted accounts takes a login of this shape only.
LOGIN = re.compile(r"[A-Za-z0-9-]+(\[bot\])?")
TIME = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
# The checkout this script is in: build.yaml there holds ALLOWED_BOTS.
CHECKOUT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))


class Api:
    """GitHub's REST API through the gh command-line tool, which reads GH_TOKEN."""

    def run(self, path: str, *flags: str) -> bytes:
        return subprocess.run(["gh", "api", *flags, "--", path], check=True, capture_output=True).stdout

    def get(self, path: str):
        return json.loads(self.run(path))

    def pages(self, path: str) -> list:
        """Every page of a paginated answer, as a list of pages."""
        return json.loads(self.run(path, "--paginate", "--slurp"))

    def raw(self, path: str) -> bytes:
        return self.run(path, "-H", "Accept: application/vnd.github.raw")


def outcome(decision: str, reason: str, pr: int | None = None, project: str = "", sha: str = "",
            label: str = "") -> dict:
    return {"decision": decision, "label": label, "pr": "" if pr is None else str(pr), "project": project,
            "sha": sha, "reason": " ".join(reason.split()), "review_passed": "", "review_passed_at": "", "label_at": ""}


def run_id_of(repo: str, url: object) -> int | None:
    """The Actions run a check run's details_url names, if it is a run of this repository."""
    m = re.fullmatch(r"https://github\.com/%s/actions/runs/([0-9]+)/job/[0-9]+" % re.escape(repo), str(url or ""))
    return int(m.group(1)) if m else None


class Runs:
    """This repository's Actions runs, each read once."""

    def __init__(self, api: Api, repo: str):
        self.api, self.repo, self.seen = api, repo, {}

    def get(self, run_id: int) -> dict:
        if run_id not in self.seen:
            self.seen[run_id] = self.api.get(f"repos/{self.repo}/actions/runs/{run_id}")
        return self.seen[run_id]


def required_checks(api: Api, repo: str) -> list[tuple[str, int | None]]:
    """(context, integration id) of every status check the default branch's rules require, and every check of
    REQUIRED_SOURCES whether the rules list it or not: a ruleset that is off, or edited, lowers no bar here."""
    out = {context: ACTIONS_APP for context in REQUIRED_SOURCES}
    for rule in api.get(f"repos/{repo}/rules/branches/{DEFAULT_BRANCH}"):
        if rule.get("type") == "required_status_checks":
            for check in (rule.get("parameters") or {}).get("required_status_checks") or []:
                out[check["context"]] = check.get("integration_id") or out.get(check["context"])
    return sorted(out.items())


def head_of(run: dict) -> tuple[object, object]:
    """The repository and branch a run's pull request came from."""
    return (run.get("head_repository") or {}).get("full_name"), run.get("head_branch")


def head_of_pull(pull: dict) -> tuple[object, object]:
    """The repository and branch a pull request comes from."""
    at = pull.get("head") or {}
    return (at.get("repo") or {}).get("full_name"), at.get("ref")


def bound_checks(api: Api, runs: Runs, repo: str, sha: str, head: tuple) -> tuple[list[str], int | None]:
    """The required checks that have not passed at `sha` from their bound source, and the Actions run of the bound
    project-builds check (None if it has not passed). A check counts only from a run of its workflow file and event,
    at `sha`, of the pull request whose head is `head` (repository, branch): another pull request at the same commit
    from another head neither blocks this one nor speaks for it. A pull request from the same head (the same branch
    into another base) has the same runs, so its newest run decides for both. Of those, the newest decides."""
    check_runs = [c for page in api.pages(f"repos/{repo}/commits/{sha}/check-runs?filter=all&per_page=100")
                  for c in page.get("check_runs") or []]
    waiting, build_run = [], None
    for context, app in required_checks(api, repo):
        source = REQUIRED_SOURCES.get(context)
        if source is None:
            waiting.append(f"{context} (no known source)")
            continue
        found = None
        for check in sorted(check_runs, key=lambda c: c["id"], reverse=True):
            if check.get("name") != context or (app is not None and (check.get("app") or {}).get("id") != app):
                continue
            run_id = run_id_of(repo, check.get("details_url"))
            if run_id is None:
                continue
            run = runs.get(run_id)
            if (run.get("path"), run.get("event")) == source and run.get("head_sha") == sha and head_of(run) == head:
                found = (check, run_id)
                break
        if found is None:
            waiting.append(f"{context} (not run by {source[0]} on {source[1]})")
        elif found[0].get("status") != "completed" or found[0].get("conclusion") != "success":
            waiting.append(f"{context} ({found[0].get('conclusion') or found[0].get('status')})")
        elif context == "project-builds":
            build_run = found[1]
    return waiting, build_run


def build_record(api: Api, repo: str, run_id: int) -> tuple[dict | None, str]:
    """The record build.yaml's record job uploaded in this run: the JSON of record.json, the one file of its artifact
    RECORD_ARTIFACT; or None and why not."""
    artifacts = [a for page in api.pages(f"repos/{repo}/actions/runs/{run_id}/artifacts?name={RECORD_ARTIFACT}"
                                         "&per_page=100")
                 for a in page.get("artifacts") or [] if a.get("name") == RECORD_ARTIFACT and not a.get("expired")]
    if len(artifacts) != 1:
        return None, f"Build run {run_id} has {len(artifacts)} unexpired {RECORD_ARTIFACT} artifacts, not one"
    if int(artifacts[0].get("size_in_bytes") or 0) > MAX_ARTIFACT_BYTES:
        return None, f"Build run {run_id}'s {RECORD_ARTIFACT} is larger than {MAX_ARTIFACT_BYTES} bytes"
    data = api.raw(f"repos/{repo}/actions/artifacts/{artifacts[0]['id']}/zip")
    try:
        with zipfile.ZipFile(io.BytesIO(data)) as archive:
            names = archive.namelist()
            if set(names) != {"record.json"} or archive.getinfo("record.json").file_size > MAX_ARTIFACT_BYTES:
                return None, f"Build run {run_id}'s {RECORD_ARTIFACT} holds {names}, not record.json alone"
            return json.loads(archive.read("record.json")), ""
    except (zipfile.BadZipFile, ValueError) as error:
        return None, f"Build run {run_id}'s {RECORD_ARTIFACT} cannot be read: {error}"


def review_conclusion(api: Api, repo: str, head: str, number: int) -> str:
    """The conclusion of the newest check run REVIEW_CHECK of the oss-verify App at the commit `head` for pull request
    `number` (its status while it has none), or NOT_REVIEWED when there is none. A check run whose external_id is not
    `number`, another pull request's at the same commit, is not counted. filter=all: GitHub's default, latest, can
    give only another pull request's newer check run, and this pull request's own would not be read."""
    found = [c for page in api.pages(f"repos/{repo}/commits/{head}/check-runs?check_name={quote(REVIEW_CHECK)}"
                                     "&filter=all&per_page=100")
             for c in page.get("check_runs") or []
             if (c.get("app") or {}).get("id") == REVIEW_APP and c.get("external_id") == str(number)]
    if not found:
        return NOT_REVIEWED
    newest = max(found, key=lambda c: c["id"])
    return str(newest.get("conclusion") or newest.get("status"))


def size(value: object) -> bool:
    return value is None or (isinstance(value, int) and not isinstance(value, bool) and value >= 0)


def record_problem(record: object, sha: str | None) -> str:
    """Why the record cannot be used (for the commit `sha`, when it is known), or ''."""
    if not isinstance(record, dict) or record.get("schema") != RECORD_SCHEMA:
        return "the build record has another shape"
    pr, project = record.get("pr"), record.get("project")
    if not isinstance(pr, int) or isinstance(pr, bool) or pr < 1:
        return "the build record names no pull request"
    if not isinstance(project, str) or not NAME.fullmatch(project):
        return "the build record names no project"
    if not isinstance(record.get("sha"), str) or not SHA.fullmatch(record["sha"]) \
            or (sha is not None and record["sha"] != sha):
        return f"the build record is of commit {record.get('sha')!r}, not {sha}"
    sizes = record.get("sizes")
    if not isinstance(sizes, dict) or not sizes:
        return "the build record lists no binary"
    for target, builds in sizes.items():
        if not isinstance(builds, dict) or "plain" not in builds:
            return f"the build record has no plain build of {target!r}"
        for value in builds.values():
            if not isinstance(value, dict) or set(value) != {"text", "exec"} or not all(map(size, value.values())):
                return f"the build record gives {target!r} a size that is not a byte count"
    return ""


def oversized(record: dict) -> list[str]:
    """Each plain binary whose size (the larger of .text and the executable segments) is above SIZE_LIMIT or
    unknown, as text for the reason line. A binary that the loader maps no executable byte of cannot run as built:
    its headers do not say its size, which is unknown."""
    out = []
    for target, builds in sorted(record["sizes"].items()):
        text, exe = builds["plain"]["text"], builds["plain"]["exec"]
        if text is None or exe is None or exe == 0:
            out.append(f"{target}.plain (size unknown)")
        elif max(text, exe) > SIZE_LIMIT:
            out.append(f"{target}.plain ({text:,} bytes of .text, {exe:,} executable bytes)")
    return out


def the_project(files: list[dict]) -> tuple[str | None, str]:
    """The one project a pull request's files change, or None and why not."""
    if len(files) >= MAX_LISTED_FILES:
        return None, f"it changes {len(files)} files or more, more than the API lists"
    names, kept = set(), False
    for f in files:
        for path in (f.get("filename"), f.get("previous_filename")):
            if path is None:
                continue
            parts = str(path).split("/")
            if len(parts) < 3 or parts[0] != "projects" or not NAME.fullmatch(parts[1]):
                return None, f"it changes {path!r}, which is not under one projects/<name>/"
            names.add(parts[1])
        kept |= f.get("status") != "removed"
    if len(names) != 1:
        return None, f"it changes {len(names)} projects, not one"
    if not kept:
        return None, "it removes its project"
    return names.pop(), ""


def open_at(pull: dict, repo: str, sha: str, head: tuple | None) -> str:
    """Why the pull request is not open, ready for review, into the default branch at `sha`, from `head` (repository,
    branch) when it is given, or ''."""
    base, at = pull.get("base") or {}, pull.get("head") or {}
    if pull.get("state") != "open":
        return f"it is {pull.get('state')}"
    if pull.get("draft") is not False:
        return "it is a draft: marking it ready for review builds it again, and that run decides"
    if base.get("ref") != DEFAULT_BRANCH or (base.get("repo") or {}).get("full_name") != repo:
        return f"it targets {base.get('ref')!r}, not {DEFAULT_BRANCH}"
    if at.get("sha") != sha:
        return f"its head is {at.get('sha')}, not {sha}: the run for its head decides"
    if head is not None and head_of_pull(pull) != head:
        return f"it comes from {at.get('label')!r}, not from the head the checks were run for"
    return ""


def project_yaml(api: Api, repo: str, project: str, sha: str) -> dict | None:
    """projects/<project>/project.yaml at `sha`, or None if it cannot be read."""
    try:
        data = api.raw(f"repos/{repo}/contents/projects/{project}/project.yaml?ref={sha}")
        if len(data) > MAX_PROJECT_YAML_BYTES:
            return None
        config = yaml.safe_load(data)
    except (subprocess.CalledProcessError, yaml.YAMLError, RecursionError):
        return None
    return config if isinstance(config, dict) else None


def language(config: dict | None) -> str | None:
    """The language project.yaml gives, lower case, or None."""
    value = (config or {}).get("language")
    return value.lower() if isinstance(value, str) else None


def standing(config: dict, login: str) -> str:
    """'' when triage.py's maintainer check passes for `login` on the repository `repo` names, else why not. It checks
    the pull request's author, not primary_contact. A repository not on github.com, a fork (whose owner is anyone who
    forked it), or a read that fails, does not pass."""
    match = triage.GITHUB_REPO.fullmatch(config.get("repo") or "") if isinstance(config.get("repo"), str) else None
    if not match:
        return "its repo is not a github.com repository, so the author's role there cannot be read"
    owner, name, _ = match.groups()
    try:
        gh = triage.GitHub(os.environ.get("GH_TOKEN"))
        meta = gh.find(f"repos/{triage.quote(owner, safe='')}/{triage.quote(name, safe='')}")
        if meta is None:
            return f"{owner}/{name} is not found on GitHub, or not public"
        if meta.get("fork") is not False:
            parent = (meta.get("parent") or {}).get("full_name") or "another repository"
            return f"{meta['full_name']} is a fork of {parent}, so owning it shows nothing"
        mark, evidence = triage.maintainer_row(gh, meta["full_name"], meta, login)
    except Exception as error:  # noqa: BLE001 - any failed read holds the enrollment for a person
        return f"the author's role on {owner}/{name} could not be read: {type(error).__name__}"
    if mark != triage.OK:
        return f"{login or 'the author'} is not shown to maintain {meta['full_name']}: {evidence}"
    return ""


def confirmed_by(api: Api, repo: str, number: int, pull: dict, author: str, since: str) -> str:
    """Who put CONFIRMED_LABEL on the pull request, when it carries it, that was someone other than its author, and it
    was put on after `since` (when the Build run of the head commit was created, so after that commit was pushed: a
    confirmation covers the commits it saw, not a later change of `repo`); else ''. Only an account with at least triage
    access to this repository can add a label (GitHub's permission model): a member of the organisation, or one of its
    Apps. The pull request's own author does not count."""
    if not labelled(pull, CONFIRMED_LABEL):
        return ""
    try:
        events = [e for page in api.pages(f"repos/{repo}/issues/{number}/events?per_page=100") for e in page]
    except subprocess.CalledProcessError:
        return ""
    added = [e for e in events if e.get("event") == "labeled" and (e.get("label") or {}).get("name") == CONFIRMED_LABEL
             and isinstance(e.get("created_at"), str) and e["created_at"] > since]
    actor = ((added[-1].get("actor") or {}).get("login") or "") if added else ""
    return actor if actor and actor.lower() != author.lower() else ""


def label_for_a_person(where: str, lang: str, record: dict, number: int, project: str, sha: str) -> dict | None:
    """The label of the first thing a person decides by hand: a paused language, a name the statements repository
    cannot take, or a plain binary above SIZE_LIMIT (or of unknown size); else None."""
    if lang in PAUSED_LANGUAGES:
        return outcome("label", f"{where} is in {lang}, which is paused", number, project, sha, "language-paused")
    if not STATEMENTS_NAME.fullmatch(project):
        return outcome("label", f"{where}: the statements repository's project names have no dot", number, project,
                       sha, "name-review")
    over = oversized(record)
    if over:
        return outcome("label", f"{where} has a plain binary above {SIZE_LIMIT:,} bytes: {', '.join(over)}", number,
                       project, sha, "size-review")
    return None


def passes(result: dict) -> str:
    """'' when the run passes for REVIEW_PASSED, else why not: its decision is dispatch for an open pull request,
    which decision gives only when the newest REVIEW_CHECK check run of the commit is success (every check of review.md
    pass, or optional, as an optional fail of F5 or F8 is). decide_merged never asks it."""
    return "" if result["decision"] == "dispatch" else "the run sends nothing"


def trusted(api: Api, repo: str, login: str) -> bool | None:
    """build.yaml's rule for trusted accounts (its bash function trusted), with the same answers: True for an App of
    ALLOWED_BOTS, or an account that GitHub's collaborator permission API gives admin or write; False for any other
    account, and for a login of another shape; None when it could not be read. ALLOWED_BOTS is read from the env of
    build.yaml in this checkout, so that there is one list."""
    if not LOGIN.fullmatch(login):
        return False
    try:
        with open(os.path.join(CHECKOUT, BUILD_WORKFLOW), encoding="utf-8") as file:
            bots = str(yaml.safe_load(file)["env"]["ALLOWED_BOTS"]).split(",")
    except (OSError, yaml.YAMLError, KeyError, TypeError):
        return None
    if login in bots:
        return True
    if login.endswith("[bot]"):
        return False
    try:
        answer = api.get(f"repos/{repo}/collaborators/{login}/permission")
    except (subprocess.CalledProcessError, ValueError):
        return None
    if not isinstance(answer, dict):
        return None
    return answer.get("permission") in ("admin", "write")


def labelled(pull: dict, name: str = REVIEW_PASSED) -> bool:
    """Whether the pull request carries the label `name`."""
    return name in {(label or {}).get("name") for label in pull.get("labels") or []}


def time_of(value: object) -> str | None:
    """`value`, when it is a time as GitHub gives it (2026-11-11T20:44:39Z), else None."""
    return value if isinstance(value, str) and TIME.fullmatch(value) else None


def pull_of_head(api: Api, repo: str, sha: str, head: tuple) -> dict | None:
    """The open pull request into the default branch from `head` (repository, branch) whose head commit is `sha`, or
    None. It finds a fork's pull request too, which a workflow run does not name."""
    name, branch = head
    if not isinstance(name, str) or "/" not in name or not isinstance(branch, str):
        return None
    owner = urllib.parse.quote(name.split("/")[0], safe="")
    path = (f"repos/{repo}/pulls?state=open&base={DEFAULT_BRANCH}&head={owner}:{urllib.parse.quote(branch, safe='')}"
            "&per_page=100")
    for pull in (p for page in api.pages(path) for p in page):
        base, at = pull.get("base") or {}, pull.get("head") or {}
        if pull.get("state") == "open" and base.get("ref") == DEFAULT_BRANCH \
                and (base.get("repo") or {}).get("full_name") == repo and at.get("sha") == sha \
                and head_of_pull(pull) == head:
            return pull
    return None


def older_than_head(api: Api, repo: str, number: int, sha: str, head: tuple, label_at: str, events: list,
                    created: object) -> bool:
    """Whether the label put on at `label_at` is older than the run's head `sha`, from `head` (repository, branch), of
    pull request `number`: put on before the head was pushed, or followed by a pull_request_target run from that head
    at another of its commits (each label event starts a run of maintainer-confirmed.yml, on pull_request_target, at
    the head of that moment, so a label put on while the pull request was at another commit is followed by a run of
    that commit). The head was pushed at the later of its first run (the oldest of this repository's runs at `sha` from
    `head`; when there is none, `created`, the completed run's) and the pull request's newest force push.

    The runs after the label are read by branch name and event: a branch of this repository by the same name (main)
    can have more runs than the API lists, but none on pull_request_target, which every run from a pull request's head
    that counts here is on (build.yaml, validate.yaml, terms.yaml, maintainer-confirmed.yml, enroll-merged.yml).

    The same branch can be the head of another pull request, one closed before, say, whose runs at its own head (a
    label event on a closed pull request starts one too) say nothing of this label. So a run at another commit counts
    only when that commit is among the pull request's commits, which are read only when such a run exists. They hold
    every earlier head reached without a force push, and a force push is the first test. GitHub lists at most 250
    commits of a pull request: when it lists 250, every such run counts, which can take off a true label (the next
    passing run puts it back) but never leaves a false one. A branch built on another pull request's commits that are
    not in main still counts that pull request's runs at those commits, with the same effect."""
    first = [run["created_at"] for page in api.pages(f"repos/{repo}/actions/runs?head_sha={sha}&per_page=100")
             for run in page.get("workflow_runs") or []
             if run.get("head_sha") == sha and head_of(run) == head and time_of(run.get("created_at"))]
    if first:
        pushed = [min(first)]
    else:
        pushed = [created] if time_of(created) else []
    pushed += [e["created_at"] for e in events
               if e.get("event") == "head_ref_force_pushed" and time_of(e.get("created_at"))]
    if pushed and label_at < max(pushed):
        return True
    branch = urllib.parse.quote(head[1], safe="")
    later = (f"repos/{repo}/actions/runs?branch={branch}&event=pull_request_target&created=%3E%3D{label_at}"
             "&per_page=100")
    others = {run.get("head_sha") for page in api.pages(later) for run in page.get("workflow_runs") or []
              if head_of(run) == head and run.get("head_sha") != sha
              and (time_of(run.get("created_at")) or "") >= label_at}
    if not others:
        return False
    commits = {c["sha"] for page in api.pages(f"repos/{repo}/pulls/{number}/commits?per_page=100") for c in page
               if isinstance(c, dict) and isinstance(c.get("sha"), str)}
    return len(commits) >= 250 or bool(others & commits)


def review_passed(api: Api, repo: str, result: dict, pull: dict | None = None, sha: str | None = None,
                  head: tuple | None = None, created: object = None, merged: bool = False) -> dict:
    """`result` with what happens to REVIEW_PASSED: review_passed (on, off, or '' for no change), review_passed_at
    (head for a change at a new head or a renewal, closed for a close or a merge, else ''), label_at (the time of the
    newest labeled event judged, for a change at a new head or a renewal), the pull request's number when it changes,
    and a clause of the reason that says why it changes or does not.

    A run of MERGED_WORKFLOW (`merged`) takes it off the pull request it read, `pull`, when that is closed and carries
    it, and never puts it on. Any other run is about the commit `sha` from `head`, when it bound them, and about `pull`,
    the pull request it read last: when it read none, the open pull request into main from that head at that commit.
    When that pull request is not open at `sha` from `head`, the run for its head decides, and nothing changes. Else a
    run that passes (passes) for an enrollment, whose files the decision dispatch has shown are under one
    projects/<name>/ and whose author is not trusted (trusted, with a clear answer), puts the label on, unless an
    account other than APP_LOGIN took it off before; and puts it on again when it is older than the head
    (older_than_head, `created` the completed run's creation). Any other run takes it off only when it is older than
    the head. When the pull request's events (or its head's runs) cannot be read, nothing changes."""
    def say(clause: str, state: str = "", at: str = "", label_at: str = "", number: object = None) -> dict:
        out = dict(result, reason=" ".join(f"{result['reason']}; {REVIEW_PASSED} {clause}".split()))
        if state:
            out.update(pr=str(number), review_passed=state, review_passed_at=at, label_at=label_at)
        return out

    if merged:
        number = (pull or {}).get("number")
        if pull is None or pull.get("state") != "closed" or not labelled(pull) or not isinstance(number, int):
            return result
        return say(f"comes off: pull request {number} is closed", "off", "closed", number=number)
    if sha is None or head is None:
        return result   # the run binds no head
    if pull is None:
        try:
            pull = pull_of_head(api, repo, sha, head)
        except (subprocess.CalledProcessError, ValueError):
            return say(f"is left as it is: the open pull request from that head at {sha[:7]} could not be read")
        if pull is None:
            return result
    number, on = pull.get("number"), labelled(pull)
    if not isinstance(number, int) or pull.get("state") != "open" or (pull.get("head") or {}).get("sha") != sha \
            or head_of_pull(pull) != head:
        return say(f"is left as it is: the pull request is not open at {sha[:7]} from that head, and the run for its "
                   "head decides") if on else result
    author = str((pull.get("user") or {}).get("login") or "")

    def unearned() -> str:
        """Why the run does not earn the label (it does not pass, or build.yaml's rule trusts the author, or whether
        it does could not be read), or ''. The trust read is made only when the answer decides something."""
        why = passes(result)
        if why:
            return why
        trust = trusted(api, repo, author)
        if trust is True:
            return f"its author {author} is trusted by build.yaml's rule (write access, or an App of ALLOWED_BOTS)"
        if trust is None:
            return f"whether its author {author} is trusted could not be read"
        return ""

    if not on:
        why = unearned()
        if why:
            return say(f"is not put on: {why}") if result["decision"] == "dispatch" else result
    try:
        events = [e for page in api.pages(f"repos/{repo}/issues/{number}/events?per_page=100") for e in page
                  if isinstance(e, dict)]
    except (subprocess.CalledProcessError, ValueError):
        return say("is left as it is: the pull request's events could not be read")
    if not on:
        removed = [e for e in events if e.get("event") == "unlabeled"
                   and (e.get("label") or {}).get("name") in REVIEW_PASSED_NAMES
                   and str((e.get("actor") or {}).get("login") or "").lower() != APP_LOGIN]
        if removed:
            remover = (removed[-1].get("actor") or {}).get("login") or "an account"
            return say(f"is not put on: {remover} took it off at {removed[-1].get('created_at')}, and the run does "
                       "not put it back")
        return say(f"goes on: {sha[:7]} is sent, its {REVIEW_CHECK} check run is success, and its author {author} is "
                   "not trusted", "on", number=number)
    times = [e["created_at"] for e in events if e.get("event") == "labeled"
             and (e.get("label") or {}).get("name") in REVIEW_PASSED_NAMES and time_of(e.get("created_at"))]
    if not times:
        return say("is left as it is: no labeled event of it is found, so its age is not known")
    label_at = max(times)
    try:
        older = older_than_head(api, repo, number, sha, head, label_at, events, created)
    except (subprocess.CalledProcessError, ValueError):
        return say(f"is left as it is: the runs from that head could not be read, so whether its label of {label_at} "
                   f"is older than {sha[:7]} is not known")
    if not older:
        return say(f"stays: it was put on at {label_at}, for {sha[:7]}")
    why = unearned()
    if not why:
        return say(f"is put on again: it was put on at {label_at}, before {sha[:7]}, which passes", "on", "head",
                   label_at, number)
    return say(f"comes off: it was put on at {label_at}, before {sha[:7]}, and {why}", "off", "head", label_at, number)


def decide_merged(api: Api, repo: str, runs: Runs, run: dict) -> dict:
    """What a completed run of MERGED_WORKFLOW decides: dispatch, with merged=true, for the head commit of the pull
    request its title names, when that pull request is an enrollment merged into main whose required checks passed at
    that commit. The size line, a paused language and the name rule label as in decide; the review and the maintainer
    check are not asked, since the person who merged decided them. The pull request is read before the run's
    conclusion is: a close without a merge skips the run's job, and takes REVIEW_PASSED off (review_passed) as a merge
    does."""
    run_id, event = run.get("id"), run.get("event")
    # pull_request_target runs the base branch's copy of the file, whatever the pull request holds; a replay by hand must
    # be main's. A fork's own copy, run on its pull request, is not counted.
    if event != "pull_request_target" and (event, head_of(run)) != ("workflow_dispatch", (repo, DEFAULT_BRANCH)):
        name, branch = head_of(run)
        return outcome("none", f"run {run_id} is neither the base branch's {MERGED_WORKFLOW} on pull_request_target nor "
                       f"a replay of main's: it ran on {event} from {name}:{branch}")
    title = MERGED_TITLE.fullmatch(str(run.get("display_title") or ""))
    if title is None:
        return outcome("none", f"run {run_id}'s title {run.get('display_title')!r:.40} names no pull request")
    number = int(title.group(1))
    pull = api.get(f"repos/{repo}/pulls/{number}")
    return review_passed(api, repo, merged_decision(api, repo, runs, run, number, pull), pull, merged=True)


def merged_decision(api: Api, repo: str, runs: Runs, run: dict, number: int, pull: dict) -> dict:
    """decide_merged's decision for pull request `number`, as `pull` gives it."""
    run_id = run.get("id")
    if run.get("conclusion") != "success":
        return outcome("none", f"run {run_id} of {MERGED_WORKFLOW} is {run.get('conclusion')}, not success: its job "
                       "runs for a merge or a replay alone")
    replay = f"gh workflow run {os.path.basename(MERGED_WORKFLOW)} -f pr={number}"
    base = pull.get("base") or {}
    if pull.get("merged") is not True:
        return outcome("none", f"pull request {number} is not merged", number)
    if base.get("ref") != DEFAULT_BRANCH or (base.get("repo") or {}).get("full_name") != repo:
        return outcome("none", f"pull request {number} was merged into {base.get('ref')!r}, not {DEFAULT_BRANCH}",
                       number)
    sha, head = (pull.get("head") or {}).get("sha"), head_of_pull(pull)
    if not isinstance(sha, str) or not SHA.fullmatch(sha):
        return outcome("none", f"pull request {number}'s head {sha!r:.50} is not a commit id", number)
    files = [f for page in api.pages(f"repos/{repo}/pulls/{number}/files?per_page=100") for f in page]
    project, why = the_project(files)
    if project is None:
        return outcome("none", f"pull request {number} is not one enrollment: {why}", number, sha=sha)
    waiting, build_run = bound_checks(api, runs, repo, sha, head)
    if waiting:
        return outcome("none", f"required checks not passed at {sha[:7]}: {', '.join(waiting)}; once they pass, "
                       f"{replay} decides again", number, project, sha)
    record, why = build_record(api, repo, build_run)
    why = why or record_problem(record, sha)
    if not why and (record["pr"], record["project"]) != (number, project):
        why = f"the build record is of pull request {record['pr']} and projects/{record['project']}/"
    if why:
        return outcome("none", f"pull request {number}: {why}", number, project, sha)
    where = f"pull request {number}: projects/{project}/ at {sha[:7]}"
    lang = language(project_yaml(api, repo, project, sha))
    if lang is None:
        return outcome("none", f"{where}: its project.yaml cannot be read for its language; {replay} decides again",
                       number, project, sha)
    label = label_for_a_person(where, lang, record, number, project, sha)
    if label:
        return label
    merged_by = (pull.get("merged_by") or {}).get("login") or "unknown"
    return dict(outcome("dispatch", f"pull request {number} was merged by {merged_by}: the merge decides the review "
                        "and the maintainer check", number, project, sha), merged="true")


def decide(api: Api, repo: str, run_id: int, run_event: str, head_sha: str) -> dict:
    """What the completed run decides (the module's header says how), with what happens to REVIEW_PASSED."""
    runs = Runs(api, repo)
    if run_event in ("pull_request_target", "pull_request", "workflow_dispatch") \
            and runs.get(run_id).get("path") == MERGED_WORKFLOW:
        return decide_merged(api, repo, runs, runs.get(run_id))
    bound = {}
    result = decision(api, repo, runs, run_id, run_event, head_sha, bound)
    return review_passed(api, repo, result, **bound)


def decision(api: Api, repo: str, runs: Runs, run_id: int, run_event: str, head_sha: str, bound: dict) -> dict:
    """decide's decision for a run that is not a merge's. It puts in `bound` what review_passed needs, once it has
    read it: the commit and head the run is about (sha, head), the completed run's creation (created), and the pull
    request as it read it last (pull)."""
    if run_event in ("pull_request_target", "pull_request"):
        if not SHA.fullmatch(head_sha):
            return outcome("none", f"{head_sha!r} is not a commit id")
        trigger = runs.get(run_id)
        if trigger.get("path") == CONFIRMED_WORKFLOW and trigger.get("conclusion") != "success":
            return outcome("none", f"run {run_id} is a label other than {CONFIRMED_LABEL}")
        if trigger.get("head_sha") != head_sha:
            return outcome("none", f"run {run_id} is of {trigger.get('head_sha')}, not {head_sha}")
        sha, record, head = head_sha, None, head_of(trigger)
        bound.update(sha=sha, head=head, created=trigger.get("created_at"))
    elif run_event == "workflow_dispatch":
        run = runs.get(run_id)
        if (run.get("path"), run.get("head_branch"), (run.get("head_repository") or {}).get("full_name")) \
                != (BUILD_WORKFLOW, DEFAULT_BRANCH, repo):
            return outcome("none", f"run {run_id}, started by hand, is not of {BUILD_WORKFLOW} on {DEFAULT_BRANCH}")
        record, why = build_record(api, repo, run_id)
        why = why or record_problem(record, None)
        if why:
            return outcome("none", f"run {run_id}: {why}")
        sha = record["sha"]
        pull = api.get(f"repos/{repo}/pulls/{record['pr']}")
        head = head_of_pull(pull)
        bound.update(sha=sha, head=head, created=run.get("created_at"), pull=pull)
    else:
        return outcome("none", f"the run that completed was started by {run_event}, not by a pull request")
    waiting, build_run = bound_checks(api, runs, repo, sha, head)
    if waiting:
        return outcome("none", f"required checks not passed at {sha[:7]}: {', '.join(waiting)}", sha=sha)
    if record is None:
        record, why = build_record(api, repo, build_run)
        why = why or record_problem(record, sha)
        if why:
            return outcome("none", why, sha=sha)
    number, project = record["pr"], record["project"]
    bound["pull"] = api.get(f"repos/{repo}/pulls/{number}")
    why = open_at(bound["pull"], repo, sha, head)
    if why:
        return outcome("none", f"pull request {number}: {why}", number, project, sha)
    files = [f for page in api.pages(f"repos/{repo}/pulls/{number}/files?per_page=100") for f in page]
    changed, why = the_project(files)
    if changed is None or changed != project:
        why = why or f"it changes projects/{changed}/, the record's project is {project}"
        return outcome("none", f"pull request {number} is not one enrollment: {why}", number, project, sha)
    # The files were listed for whatever the head was when they were asked for: the head must still be `sha`.
    pull = bound["pull"] = api.get(f"repos/{repo}/pulls/{number}")
    why = open_at(pull, repo, sha, head)
    if why:
        return outcome("none", f"pull request {number}: {why}", number, project, sha)
    where = f"pull request {number}: projects/{project}/ at {sha[:7]}"
    config = project_yaml(api, repo, project, sha)
    lang = language(config)
    if lang is None:
        return outcome("none", f"{where}: its project.yaml cannot be read for its language; the next run decides",
                       number, project, sha)
    # Before the labels: a label that a person lifts by hand (size-review, say) must never be the only thing that
    # stands between a pull request whose review did not pass and its statements.
    conclusion = review_conclusion(api, repo, sha, number)
    if conclusion == NOT_REVIEWED:
        return outcome("none", f"{where}: {NOT_REVIEWED}: the oss-verify App wrote no {REVIEW_CHECK} check run on it",
                       number, project, sha)
    if conclusion != "success":
        return outcome("none", f"{where}: its newest {REVIEW_CHECK} check run is {conclusion}, not success", number,
                       project, sha)
    label = label_for_a_person(where, lang, record, number, project, sha)
    if label:
        return label
    author = (pull.get("user") or {}).get("login") or ""
    since = runs.get(build_run).get("created_at") if build_run is not None else None
    confirmed = confirmed_by(api, repo, number, pull, author, since) if isinstance(since, str) else ""
    why = "" if confirmed else standing(config, author)
    if why:
        return outcome("label", f"{where}: {why}", number, project, sha, "maintainer-review")
    return outcome("dispatch", f"{where} passed every required check, each plain binary has at most "
                   f"{SIZE_LIMIT:,} bytes of .text and of executable segments, and "
                   + (f"{confirmed} labelled it {CONFIRMED_LABEL}" if confirmed else "its author maintains its repository"),
                   number, project, sha)


def main() -> int:
    run_id = os.environ.get("RUN_ID", "")
    result = decide(Api(), os.environ["REPO"], int(run_id) if run_id.isdigit() else 0,
                    os.environ.get("RUN_EVENT", ""), os.environ.get("HEAD_SHA", ""))
    lines = "".join(f"{key}={value}\n" for key, value in result.items())
    path = os.environ.get("GITHUB_OUTPUT")
    if path:
        with open(path, "a", encoding="utf-8") as out:
            out.write(lines)
    sys.stdout.write(lines)
    return 0


if __name__ == "__main__":
    sys.exit(main())
