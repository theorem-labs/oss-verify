#!/usr/bin/env bash
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
#
# Whether build.yaml's comment job arms auto-merge for a change pull request (one that changes no file under
# projects/, review-change.md) that its run reviewed. An enrollment is never merged by automation: build.yaml never
# runs this for one. It prints `merge` or `hold:<reason>` on its first line, and after `merge` each required check run
# it counted, one per line (`<name> <state> <url>`), for the approval and the squash text. It writes nothing on GitHub.
# Any other ending (a read that fails) is no decision, and the caller holds. Run it from a checkout of this repository:
#
#   REPO=<owner/name> PR=<number> HEAD_SHA=<reviewed head> VERDICT=<the review job's verdict output> \
#     REFUSED=<true when review-run refused the review> SERVED=<the record of what answered> \
#     .github/scripts/merge-decide
#
# The reasons, in the order it checks them:
#   refused   review-run refused the review (exit 4).
#   not-run   no verdict: the review did not finish, or review-run refused its verdict line.
#   served    `review-served check` does not pass the record: the model asked for did not answer every turn.
#   head      the verdict is of another commit than HEAD_SHA.
#   moved     the pull request's head is no longer HEAD_SHA.
#   blocking  the verdict lists a blocking item: a failed check of review-change.md.
#   person    the verdict lists an item that a person decides: a change of behaviour or a new affordance, say.
#   trust     the change touches a path outside docs/, one of the docs that review.md reads as its rules
#             (project-yaml.md, build-contract.md, what-gets-proven.md), or a CODEOWNERS: only those docs merge by
#             themselves, since every other path is code that CI runs (tools/, infra/, .github/), a rule that the
#             reviews read (the review*.md files, the agent skills, README.md and CONTRIBUTING.md), or a project.
#             The paths are git's own diff from the merge base with the base branch to HEAD_SHA, from git's object
#             store, never GitHub's file list.
#   checks    a required check of the base branch's rules failed, or has no run at the head. Each is read from its
#             newest run at the head. A check still running does not hold: auto-merge waits for it. project-builds,
#             which this run reports after the comment job, counts as running.
set -euo pipefail

hold() { echo "hold:$1"; exit 0; }
[ "${REFUSED:-}" != true ] || hold refused
[ -n "${VERDICT:-}" ] || hold not-run
"$(dirname "$0")/review-served" check <<< "${SERVED:-}" > /dev/null 2>&1 || hold served
[ "$(jq -r .head <<< "$VERDICT")" = "$HEAD_SHA" ] || hold head
pull=$(gh api "repos/$REPO/pulls/$PR")
[ "$(jq -r .head.sha <<< "$pull")" = "$HEAD_SHA" ] || hold moved
[ "$(jq '.blocking | length' <<< "$VERDICT")" = 0 ] || hold blocking
[ "$(jq '.person | length' <<< "$VERDICT")" = 0 ] || hold person

base=$(jq -r .base.ref <<< "$pull")
merge_base=$(gh api "repos/$REPO/compare/$base...$HEAD_SHA" --jq .merge_base_commit.sha)
[[ $merge_base =~ ^[0-9a-f]{40}$ ]] || { echo "merge-decide: could not read the merge base" >&2; exit 1; }
git fetch -q --no-tags --depth=1 origin "$HEAD_SHA" "$merge_base"
paths=$(git diff --name-only --no-renames "$merge_base" "$HEAD_SHA")
if grep -qvE '^docs/' <<< "$paths" \
  || grep -qE '^docs/(project-yaml|build-contract|what-gets-proven)\.md$|(^|/)CODEOWNERS$' <<< "$paths"; then
  hold trust
fi

required=$(gh api "repos/$REPO/rules/branches/$base" \
  --jq '.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[]
        | [.context, (.integration_id // "" | tostring)] | @tsv')
counted=()
while IFS=$'\t' read -r name app; do
  [ -n "$name" ] || continue
  if [ "$name" = project-builds ]; then counted+=("project-builds running (this run)"); continue; fi
  # The newest run of the check at the head, from the app the rule names; | between its fields, since a run that is
  # not finished has no conclusion, and read would merge two tabs into one.
  run=$(gh api --method GET "repos/$REPO/commits/$HEAD_SHA/check-runs" -f check_name="$name" -f filter=latest \
          -f per_page=100 \
        | jq -r --arg app "$app" '[.check_runs[] | select($app == "" or (.app.id | tostring) == $app)]
            | max_by(.started_at) // empty | [.status, (.conclusion // ""), .html_url] | join("|")')
  [ -n "$run" ] || hold checks
  IFS='|' read -r status conclusion url <<< "$run"
  if [ "$status" != completed ]; then
    counted+=("$name running $url")
  elif [[ $conclusion =~ ^(success|neutral|skipped)$ ]]; then
    counted+=("$name $conclusion $url")
  else
    hold checks
  fi
done <<< "$required"
echo merge
printf '%s\n' "${counted[@]}"
