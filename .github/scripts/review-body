#!/usr/bin/env bash
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
#
# Prints the review comment of a pull request. build.yaml's comment job runs it in its step "Post the comment and record
# the verdict", and posts what it prints as it is.
#
#   HEAD_SHA=<reviewed commit> REVIEW=<the review's comment> CHECKS=<the checks' report, or empty> \
#     RULES=<review.md or review-change.md> [CONCLUSION=<success, failure or action_required>] \
#     [SCREENED=<the screen's checks that ran, comma-separated>] .github/scripts/review-body
#
# Line 1 is the marker <!-- oss-verify-review -->, by which the comment job finds its comment again; the last line is
# <!-- oss-verify-review-head <commit> -->, the whole reviewed commit, which the comment job reads before it holds a
# change pull request. For an enrollment (RULES review.md), line 2 is the first sentence: the fixed sentence of
# CONCLUSION, the conclusion of the check run Enrollment review that the same step records from the same verdicts
# (.github/scripts/review-verdict --sentence). A change review has none. Then the footer that names the commit and the
# rules file, the review's first 50,000 characters and, when CHECKS is not empty, the first 12,000 of the checks'
# report folded under it: GitHub refuses a comment over 65,536 characters. The review and the report are what a pull
# request can steer, so each goes through .github/scripts/review-neutralize first: no mention, no reference to an issue
# or pull request, no unclosed HTML comment that hides what follows it, and no line of theirs that holds a marker of
# this comment (so the review's and the report's text hold no marker line: the first line and the last are this
# script's own).
# When the screen read the pull request first (SCREENED, the screen job's output `checks`), the footer names the checks
# that ran, so a clean verdict from fewer checks does not read as one from all three. SCREENED is a list of names from
# .github/scripts/screen.py, or this fails.
set -euo pipefail

[[ ${HEAD_SHA:-} =~ ^[0-9a-f]{40}$ ]] || { echo "review-body: HEAD_SHA is not a commit id" >&2; exit 2; }
REVIEW=${REVIEW:-} CHECKS=${CHECKS:-} RULES=${RULES:-}
here=$(dirname "${BASH_SOURCE[0]}")
neutralize="$here/review-neutralize"
sentence=""
if [ "$RULES" = review.md ]; then
  # Its own assignment, so that a CONCLUSION review-verdict refuses fails this script (set -e).
  sentence=$("$here/review-verdict" --sentence "${CONCLUSION:-}")
fi
printf '<!-- oss-verify-review -->\n'
if [ -n "$sentence" ]; then printf '%s\n\n' "$sentence"; fi
screened=""
if [ -n "${SCREENED:-}" ]; then
  [[ $SCREENED =~ ^(model_armor|prompt_shields|claude)(,(model_armor|prompt_shields|claude))*$ ]] \
    || { echo "review-body: SCREENED is not a list of the screen's checks" >&2; exit 2; }
  names=$(tr ',' '\n' <<< "$SCREENED" | sed -e 's/^model_armor$/Google Cloud Model Armor/' \
    -e 's/^prompt_shields$/Azure AI Content Safety Prompt Shields/' -e 's/^claude$/a Claude model with no tools/' \
    | paste -sd ',' | sed 's/,/, /g')
  screened=" An automated screen passed it first; the checks that ran: $names."
fi
# shellcheck disable=SC2016 # the backticks are Markdown's
printf '<sub>Claude wrote this review of `%s` from `%s`. It can be wrong. Each push replaces it.%s</sub>\n\n' \
  "${HEAD_SHA:0:7}" "$RULES" "$screened"
printf '%s' "$REVIEW" | "$neutralize" --drop-markers 50000
printf '\n'
if [ -n "$CHECKS" ]; then
  printf '\n<details><summary>What the checks of the fuzz targets and of the binaries measured</summary>\n\n'
  printf '%s' "$CHECKS" | "$neutralize" --drop-markers 12000
  printf '\n\n</details>\n'
fi
# The last line names the whole reviewed commit, for the comment job, which holds no change pull request whose head a
# posted review names. Only this script writes it: --drop-markers takes every line that holds oss-verify-review out of
# the text above.
printf '\n<!-- oss-verify-review-head %s -->\n' "$HEAD_SHA"
