#!/usr/bin/env python3
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
"""Print text that a pull request can steer, read on standard input, as the review comment may carry it, cut at LIMIT
characters:

    .github/scripts/review-neutralize LIMIT < text

.github/scripts/review-body runs it on the review's text and on the checks' report, which shows names that the pull
request chooses. The comment job posts the comment as oss-verify[bot], so the comment must notify no one, link no issue
or pull request, and carry no verdict line but the job's own. This is gh-aw's output sanitization ("@mention
Neutralization" and "Bot Trigger Protection", https://github.github.com/gh-aw/introduction/architecture/), in four steps:

1. Each character reference (&#64; &#x40; &commat;, and a numeric one with no `;`, which an HTML parser decodes in a
   raw HTML block) whose characters are ASCII letters or digits or @ # / : . _ - is written as those characters, until
   none is left. Steps 3 and 4 then see each @, # and URL that GitHub would render. Every other reference stays as it
   is written, so code such as `p = &x;` or `&lt;stdio.h&gt;` is unchanged.
2. Each line that holds oss-verify-verdict, oss-verify-review or oss-verify-meta, in any case, is dropped: those are the
   marker and header lines of the comment, which the comment job and the inbound watcher read, and only review-body
   writes them.
3. A word joiner (U+2060), which shows as nothing, goes after every @, so that no @ is followed by a name: GitHub then
   renders no mention, in code or out of it (an @ after a backtick that ends a code span is a mention too).
4. A word joiner goes between # and a digit (#12, owner/repo#12), between GH- and a digit, and between the /issues/,
   /pull/, /pulls/ or /discussions/ of a github.com URL and its number: GitHub then renders no issue link and makes no
   cross-reference.

GitHub's markdown API renders &#64;octocat, &commat;octocat, `x`@octocat, #1, GH-1 and an issue URL as a mention or an
issue link, and renders none of them with the word joiner of steps 3 and 4 (measured on 2026-11-02;
tools/tests/test_check_checks.py, ModelText). The text is cut after these steps, so that the joiners cannot take the
comment over GitHub's limit of 65,536 characters."""
import html
import re
import sys

JOINER = "\u2060"
REFERENCE = re.compile(r"&(?:#[0-9]+|#[xX][0-9a-fA-F]+|[A-Za-z][A-Za-z0-9]*);?")
PLAIN = re.compile(r"[A-Za-z0-9@#/:._-]+")
MARKER = re.compile(r"oss-verify-(?:verdict|review|meta)", re.IGNORECASE)
BREAKS = (
    (re.compile(r"@"), "@" + JOINER),
    (re.compile(r"#(?=[0-9])"), "#" + JOINER),
    (re.compile(r"(GH-)(?=[0-9])", re.IGNORECASE), r"\1" + JOINER),
    (re.compile(r"(github\.com/[^/\s]+/[^/\s]+/(?:issues|pulls?|discussions)/)(?=[0-9])", re.IGNORECASE),
     r"\1" + JOINER),
)


def plain(match):
    decoded = html.unescape(match.group(0))
    return decoded if PLAIN.fullmatch(decoded) else match.group(0)


def neutralize(text):
    # Each pass makes the text shorter, so this ends.
    while (decoded := REFERENCE.sub(plain, text)) != text:
        text = decoded
    text = "\n".join(line for line in text.split("\n") if not MARKER.search(line))
    for pattern, replacement in BREAKS:
        text = pattern.sub(replacement, text)
    return text


def main():
    if len(sys.argv) != 2 or not sys.argv[1].isdigit():
        sys.exit("usage: review-neutralize LIMIT < text")
    text = sys.stdin.buffer.read().decode("utf-8", "replace")
    sys.stdout.buffer.write(neutralize(text)[:int(sys.argv[1])].encode("utf-8"))


if __name__ == "__main__":
    main()
