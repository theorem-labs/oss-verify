#!/usr/bin/env bash
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
#
# Gathers what the review reads, so that the review agent needs no shell, no network and no token:
#
#   GH_TOKEN=<read-only token> REPO=<owner>/<name> PR=<number> NAME=<project> COMMIT=<built commit> \
#     [BUILD=<result line> BINARIES=<table> CHECKS=<report>] [HEAD_SHA=<head commit> LAST_REVIEW=<file>] \
#     .github/scripts/review-gather <directory>
#   GH_TOKEN=... REPO=... PR=<number> NAME= HEAD_SHA=<head commit> [LAST_REVIEW=<file> RUNS_REPO=<owner>/<name> \
#     RUN_ID=<this run>] .github/scripts/review-gather <directory>
#   GH_TOKEN=... REPO=... ISSUE=<number> .github/scripts/review-gather <directory>
#
# build.yaml's review job runs it from the base branch's checkout, after take-project has put the pull request's
# projects/<name>/ into that checkout. It runs no code of the pull request or of the project: it reads the pull request
# through the API, clones the project's repository at the built commit as data, and runs this repository's own
# tools/validate.py and .github/scripts/triage.py on them, as the validate and triage workflows do. The directory gets
# the files that the section "In CI" of .claude/skills/review-enrollment/SKILL.md lists, the build's results (BUILD,
# BINARIES and CHECKS) among them. A failed read leaves its file with the error in it, and the review says what it could
# not check. LAST_REVIEW is the file the review job keeps beside the last review's session in the Actions cache, one line
# `session=<id> head=<commit>`: when the head descends from that commit, this writes the diff since it and, to
# GITHUB_OUTPUT, `session` and `last`, so that the review resumes that session for the diff alone.
# With NAME empty, a change review (review-change.md), of this repository's pull request or of another's (REPO): only
# the pull request, its diff, its checks and review comments, and each changed file as it is at HEAD_SHA, as data under
# head/. It resumes the session of the last review of the pull request, for context, with the diff from the head that
# review reviewed. That head comes from the runs API of RUNS_REPO, the repository whose build.yaml runs the reviews,
# never from LAST_REVIEW, which sits in a cache that the runs of outside pull requests can write too (main's scope):
# it is the head of the newest Build run before RUN_ID whose review job succeeded, of this pull request. For another
# repository's pull request that is a run started on main and titled `Review <name>#<number> at <head>` (build.yaml's
# run-name: only someone who can start workflows starts one); for this repository's, a run of its own event
# (pull_request_target) on its head branch in its head repository. LAST_REVIEW gives the session's id alone.
# With ISSUE set, the draft reply to an issue (review-issue.md): only the issue's title, body, author and comments, in
# issue.json, and nothing else.
# The runner reads none of its output as a workflow command: the gathered text is the pull request's or the issue's.
resume=$(openssl rand -hex 16) && echo "::stop-commands::$resume"
trap 'echo "::$resume::"' EXIT
set -uo pipefail
export LC_ALL=C

out=${1:?usage: review-gather <directory>}
# Run a command, and keep its standard output and error in a file, whatever its status.
keep() { local file=$1; shift; { "$@"; echo "(exit status $?)"; } > "$out/$file" 2>&1; }
# The head that the newest earlier Build run of this change's pull request reviewed, its review job a success, from the
# runs API alone (the header above); nothing when there is none. At most 10 runs are looked at.
reviewed_head() {
  local runs id head tried=0 ref="" fork="" title
  [[ ${RUNS_REPO:-} =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ && ${RUN_ID:-} =~ ^[0-9]+$
     && $REPO =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 0
  local list="repos/$RUNS_REPO/actions/workflows/build.yaml/runs" mine=".id < $RUN_ID and .path == \".github/workflows/build.yaml\""
  if [ "$REPO" = "$RUNS_REPO" ]; then
    read -r ref fork < <(gh api "repos/$REPO/pulls/$PR" --jq '"\(.head.ref) \(.head.repo.full_name // "")"' 2> /dev/null)
    [[ $ref =~ ^[A-Za-z0-9._/-]+$ && $fork =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 0
    runs=$(gh api "$list?event=pull_request_target&branch=$ref&per_page=100" --jq ".workflow_runs[] | select($mine
      and .event == \"pull_request_target\" and .head_branch == \"$ref\" and .head_repository.full_name == \"$fork\")
      | \"\(.id) \(.head_sha)\"" 2> /dev/null)
  else
    title="Review ${REPO#*/}#$PR at "
    runs=$(gh api "$list?event=workflow_dispatch&branch=main&per_page=100" --jq ".workflow_runs[] | select($mine
      and .event == \"workflow_dispatch\" and .head_branch == \"main\" and (.display_title | startswith(\"$title\")))
      | \"\(.id) \(.display_title | ltrimstr(\"$title\"))\"" 2> /dev/null)
  fi
  while read -r id head; do
    [[ ${id:-} =~ ^[0-9]+$ && ${head:-} =~ ^[0-9a-f]{40}$ ]] || continue
    tried=$((tried + 1)) && [ "$tried" -le 10 ] || return 0
    if [ "$(gh api "repos/$RUNS_REPO/actions/runs/$id/jobs?per_page=100" \
        --jq '[.jobs[] | select(.name == "review")][0].conclusion' 2> /dev/null)" = success ]; then
      echo "$head"
      return 0
    fi
  done <<< "$runs"
}
if [ -n "${ISSUE:-}" ]; then
  [[ $ISSUE =~ ^[0-9]+$ ]] || { echo "review-gather: ISSUE is not a number" >&2; exit 2; }
  mkdir -p "$out"
  keep issue.json gh issue view "$ISSUE" -R "$REPO" --json number,title,author,createdAt,body,comments
  exit 0
fi
mkdir -p "$out/build" "$out/seeds"
printf '%s\n' "${BUILD:-}" > "$out/build/result.md"
printf '%s\n' "${BINARIES:-}" > "$out/build/binaries.md"
printf '%s\n' "${CHECKS:-}" > "$out/build/checks.md"
[[ $PR =~ ^[0-9]+$ ]] || { echo "review-gather: PR is not a number" >&2; exit 2; }
dir="projects/$NAME"

keep pr.json gh pr view "$PR" -R "$REPO" --json \
  number,title,author,isDraft,createdAt,body,headRefOid,files,commits,comments,reviews
# Apart, so that a token that cannot read the checks leaves pr.json whole.
keep checks.json gh pr view "$PR" -R "$REPO" --json statusCheckRollup
gh pr diff "$PR" -R "$REPO" > "$out/pr.diff" 2>&1
keep review-comments.txt gh api --paginate "repos/$REPO/pulls/$PR/comments" \
  --jq '.[] | "\(.user.login) \(.path):\(.line) \(.body)"'
if [ -z "$NAME" ]; then
  # Claude Code reads a CLAUDE.md or .claude/ beside a file it reads as instructions: the pull request's are data.
  # Every file, not only the first 100 that pr.json lists.
  gh api --paginate "repos/$REPO/pulls/$PR/files?per_page=100" --jq '.[].filename' 2> /dev/null \
    | while IFS= read -r path; do
    [[ $path =~ ^[A-Za-z0-9._/-]+$ && $path != *..* && ${HEAD_SHA:-} =~ ^[0-9a-f]{40}$ ]] || continue
    [[ ${path,,} =~ (^|/)(claude[^/]*\.md|agents[^/]*\.md|\.claude)(/|$) ]] && continue
    mkdir -p "$out/head/$(dirname "$path")"
    gh api -H 'Accept: application/vnd.github.raw' "repos/$REPO/contents/$path?ref=$HEAD_SHA" > "$out/head/$path" \
      2> /dev/null || rm -f "$out/head/$path"
  done
  reviewed=$(reviewed_head)
  session=$(sed -n 's/^session=\([0-9a-f-]\{36\}\) head=[0-9a-f]\{40\}$/\1/p' "${LAST_REVIEW:-/nonexistent}" \
    2> /dev/null | head -n 1)
  if [[ -n $reviewed && -n $session && ${HEAD_SHA:-} =~ ^[0-9a-f]{40}$ ]]; then
    status=$(gh api "repos/$REPO/compare/$reviewed...$HEAD_SHA" --jq .status 2> /dev/null) || status=""
    if [ "$status" = ahead ]; then
      keep since-last-review.diff gh api -H 'Accept: application/vnd.github.diff' "repos/$REPO/compare/$reviewed...$HEAD_SHA"
    fi
    if [ "$(tail -n 1 "$out/since-last-review.diff" 2> /dev/null)" = "(exit status 0)" ]; then
      echo "review-gather: the change review resumes the session $session, with the diff from $reviewed, the head its" \
        "last review reviewed (the runs API), to $HEAD_SHA"
      { echo "session=$session"; echo "last=$reviewed"; } >> "${GITHUB_OUTPUT:-/dev/null}"
    else
      echo "review-gather: no diff from $reviewed, the head the last review reviewed, to $HEAD_SHA (compare status" \
        "${status:-unknown}): the review is fresh"
    fi
  fi
  exit 0
fi
[[ $NAME =~ ^[a-z0-9][a-z0-9._-]{0,62}$ ]] || { echo "review-gather: NAME is not a project name" >&2; exit 2; }
# Any user can comment with the triage marker; take only the oss-verify App's comment, which this repository posts.
jq -r '[.comments[]? | select(.author.login == "oss-verify")]
       | map(.body | select(startswith("<!-- oss-verify-triage -->"))) | .[0] // ""' "$out/pr.json" \
  > "$out/triage-comment.md" 2>/dev/null || true
# --full: the review reads every row of the triage (its standing, stars, outside participants, criticality score and
# OSS-Fuzz rows too), not only the five that the public comment carries.
# triage.py reads GITHUB_TOKEN from the environment; the assignment prefix exports it to python3 without it becoming an
# argument of any process (env put it in the argument vector, which another user on the machine can read).
GITHUB_TOKEN="${GH_TOKEN:-}" keep triage-today.md python3 .github/scripts/triage.py --repo "$REPO" --pr "$PR" --full
keep validate.txt python3 tools/validate.py "$dir"
# Claude Code reads a CLAUDE.md beside a file that it reads as instructions. The pull request's are data, so they go
# from the checkout once the validator has reported them (rule 1 of review.md).
find "$dir" -maxdepth 1 \( -iname 'CLAUDE*.md' -o -iname 'AGENTS*.md' \) -delete

# Check B of review.md: each box of the description against today's template.
jq -r '.body // ""' "$out/pr.json" > "$out/description.md" 2>/dev/null
keep checklist.txt python3 - "$NAME" "$out/description.md" <<'EOF'
import re, sys
name, body = sys.argv[1], open(sys.argv[2], encoding="utf-8", errors="replace").read()
box = re.compile(r'^\s*[-*] \[([ xX])\] (.*?)\s*$', re.M)
norm = lambda t: re.sub(r'\s+', ' ', t.replace('<name>', name)).strip()
want = [norm(t) for _, t in box.findall(open('.github/PULL_REQUEST_TEMPLATE.md').read())]
got = {norm(t): m for m, t in box.findall(body.replace('\r', ''))}
for t in want:
    print('ticked  ' if got.get(t, ' ') != ' ' else 'unticked' if t in got else 'MISSING ', t[:90])
for t in got:
    if t not in want:
        print('EXTRA   ', t[:90])
EOF
keep template-history.txt git log --format='%h %cI %s' -- .github/PULL_REQUEST_TEMPLATE.md

# Each seed corpus: its listing, and the first 512 bytes of each of its first 200 inputs, in hexadecimal.
for zip in "$dir"/*_seed_corpus.zip; do
  [ -f "$zip" ] || continue
  target=$(basename "$zip" _seed_corpus.zip)
  keep "seeds/$target.listing.txt" unzip -l "$zip"
  python3 - "$zip" "$out/seeds/$target.hex.txt" <<'EOF'
import sys, zipfile
with zipfile.ZipFile(sys.argv[1]) as archive, open(sys.argv[2], "w") as out:
    for info in [i for i in archive.infolist() if not i.is_dir()][:200]:
        data = archive.read(info)[:512]
        out.write(f"== {info.filename!r}: {info.file_size} bytes\n")
        for at in range(0, len(data), 16):
            row = data[at:at + 16]
            text = "".join(chr(b) if 32 <= b < 127 else "." for b in row)
            out.write(f"{at:04x}  {row.hex(' '):<47}  {text}\n")
EOF
done

# The project's repository: the facts of check G1, and its source at the built commit, as data.
# repo comes from the pull request: it is used only if tools/validate.py's rule for it holds, and its ref is used in
# an API path only if it has no `..` part.
url=$(python3 - "$dir/project.yaml" <<'EOF' 2>/dev/null
import sys
sys.path.insert(0, "tools")
import validate
url = validate.yaml.safe_load(open(sys.argv[1])).get("repo")
print(url if validate.is_https_url(url) else "")
EOF
)
repo=${url%%#*} ref=${url#*#}
[ "$ref" = "$url" ] && ref=""
[[ $ref =~ (^|/)\.\.?(/|$) ]] && ref=""
{
  if [ -z "$url" ]; then
    echo "repo: not read: project.yaml's repo does not follow the rule of tools/validate.py"
  fi
  echo "repo: $repo"
  echo "ref: ${ref:-(the default branch)}"
  echo "built commit: ${COMMIT:-(unknown: the build did not get as far as resolving it)}"
  echo
  echo "== git ls-remote <repo> HEAD <ref> refs/heads/<ref> refs/tags/<ref>"
  [ -z "$repo" ] || GIT_TERMINAL_PROMPT=0 timeout 60 git -c credential.helper= -c protocol.allow=never \
    -c protocol.https.allow=always ls-remote -- "$repo" HEAD ${ref:+"$ref" "refs/heads/$ref" "refs/tags/$ref"}
  echo "(exit status $?)"
  if [[ $repo =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/?$ ]] \
      && [[ ${BASH_REMATCH[1]} != .* && ${BASH_REMATCH[2]} != .* ]]; then
    slug="${BASH_REMATCH[1]}/${BASH_REMATCH[2]%.git}"
    echo
    echo "== the repository on GitHub"
    gh api "repos/$slug" --jq '{full_name, default_branch, fork, archived, pushed_at, created_at, stargazers_count, forks_count, license: .license.spdx_id}'
    echo
    echo "== contributors (the top 5, with their commits)"
    gh api "repos/$slug/contributors?per_page=5" --jq '.[] | "\(.login) \(.contributions)"'
    if [[ ${COMMIT:-} =~ ^[0-9a-f]{40}$ ]]; then
      default=$(gh api "repos/$slug" --jq .default_branch)
      echo
      echo "== the built commit against the default branch ($default): status, ahead, behind"
      gh api "repos/$slug/compare/$default...$COMMIT" --jq '"\(.status) \(.ahead_by) \(.behind_by)"'
      if [ -n "$ref" ]; then
        echo
        echo "== the built commit against the ref now: status, ahead, behind"
        gh api "repos/$slug/compare/$COMMIT...$ref" --jq '"\(.status) \(.ahead_by) \(.behind_by)"'
        echo
        echo "== pull requests whose head branch is the ref"
        gh pr list -R "$slug" --head "$ref" --state all --json number,state,title,url
      fi
    fi
  fi
} > "$out/repository.txt" 2>&1

if [[ ${COMMIT:-} =~ ^[0-9a-f]{40}$ ]]; then
  source="$out/source"
  rm -rf "$source"
  git init -q "$source"
  if GIT_TERMINAL_PROMPT=0 timeout 600 git -C "$source" -c credential.helper= -c protocol.allow=never \
      -c protocol.https.allow=always fetch -q --depth 1 -- "$repo" "$COMMIT" \
      && git -C "$source" -c advice.detachedHead=false checkout -q FETCH_HEAD; then
    # Data only: no git metadata, and no symbolic link, which could point the reader outside the directory.
    rm -rf "$source/.git"
    find "$source" -type l -delete
    # Claude Code reads a CLAUDE.md or .claude/ in a directory whose files it reads as instructions: the project's are
    # data, so they go (rule 1 of review.md).
    find "$source" \( -iname 'CLAUDE*.md' -o -iname 'AGENTS*.md' -o -name .claude \) -prune -exec rm -rf {} +
  else
    rm -rf "$source"
    echo "review-gather: could not fetch $COMMIT from $repo" > "$out/source.txt"
  fi
fi
# The changes to projects/<name>/ since the commit of the last review (LAST_REVIEW), whose session the review then
# resumes: HEAD_SHA is the head commit the build took. GitHub's compare diffs from the merge base, which is the last
# review's commit only when the head descends from it (status "ahead"). After a force-push, or on the same head (an
# edit of the pull request), there is no diff, and the review is fresh.
last=$(sed -n 's/^session=\([0-9a-f-]\{36\}\) head=\([0-9a-f]\{40\}\)$/\1 \2/p' "${LAST_REVIEW:-/nonexistent}" 2> /dev/null \
  | head -n 1)
session=${last% *} since=${last#* }
since_diff() {
  gh api -H 'Accept: application/vnd.github.diff' "repos/$REPO/compare/$since...$HEAD_SHA" \
    | awk -v a="a/$dir/" -v b="b/$dir/" '/^diff --git / { take = index($0, "diff --git " a) == 1 || index($0, " " b) > 0 } take'
}
if [[ -n $last && ${HEAD_SHA:-} =~ ^[0-9a-f]{40}$ ]]; then
  status=$(gh api "repos/$REPO/compare/$since...$HEAD_SHA" --jq .status 2> /dev/null) || status=""
  if [ "$status" = ahead ]; then
    keep since-last-review.diff since_diff
  fi
  if [ "$(tail -n 1 "$out/since-last-review.diff" 2> /dev/null)" = "(exit status 0)" ]; then
    echo "review-gather: the review resumes the session $session, for the diff from $since to $HEAD_SHA"
    { echo "session=$session"; echo "last=$since"; } >> "${GITHUB_OUTPUT:-/dev/null}"
  else
    echo "review-gather: no diff from $since, the last review's commit, to $HEAD_SHA (compare status" \
      "${status:-unknown}): the review is fresh"
  fi
fi
ls -la "$out"
