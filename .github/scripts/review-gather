#!/usr/bin/env bash
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
#
# Gathers what the review reads, so that the review agent needs no shell, no network and no token:
#
#   KIND=enrollment GH_TOKEN=<read-only token> REPO=<owner>/<name> PR=<number> NAME=<project> COMMIT=<built commit> \
#     [BUILD=<result line> BINARIES=<table> CHECKS=<report>] [HEAD_SHA=<head commit> LAST_REVIEW=<file>] \
#     .github/scripts/review-gather <directory>
#   KIND=change GH_TOKEN=... REPO=... PR=<number> HEAD_SHA=<head commit> [LAST_REVIEW=<file>] \
#     .github/scripts/review-gather <directory>
#   KIND=issue GH_TOKEN=... REPO=... ISSUE=<number> .github/scripts/review-gather <directory>
#   KIND=setup FETCHED=<folder> [LAST_REVIEW=<file>] .github/scripts/review-gather <directory>
#
# review.yml's gather job runs it from the checkout of main, after take-project has put the pull request's
# projects/<name>/ into that checkout. It runs no code of the pull request or of the project: it reads the pull request
# through the API, clones the project's repository at the built commit as data, and runs the rules of oss-verify
# validate and .github/scripts/triage.py on them, as the validate and triage workflows do. The directory gets
# the files that the section "In CI" of .claude/skills/review-enrollment/SKILL.md lists, the build's results (BUILD,
# BINARIES and CHECKS, which .github/scripts/take-build-results reads from the Build run) among them. A failed read
# leaves its file with the error in it, and the review says what it could not check, with one exception: when COMMIT
# is a commit id and the project's repository cannot be fetched at it, this exits 1, so that the gather job fails and
# a re-run of its failed jobs fetches again. With no COMMIT (the build did not get as far as resolving it, or its
# results were not read), source.txt says that there is no source. LAST_REVIEW is the file the review job
# keeps beside the last review's session in the Actions cache, and the gather job restores, one line
# `session=<id> head=<commit>`: when the head descends from that commit, this writes the diff since it and, to
# GITHUB_OUTPUT, `session` and `last`, so that the review resumes that session for the diff alone.
# For an enrollment it also writes to GITHUB_OUTPUT `criticality_score`, the repository's criticality score as a JSON
# number, and `oss_fuzz`, true or false for whether the repository is in OSS-Fuzz, as .github/scripts/triage.py --facts
# gives them: each is null when triage.py does not know it. They go in no file of the directory.
# KIND is route's decision in review.yml, or setup in check.yml's review job, and this chooses its path on it once,
# here at its top.
# KIND=change, a change review (review-change.md): only the pull request, its diff, its checks and review comments,
# and each changed file as it is at HEAD_SHA, as data under head/, cut at 1 MiB. It resumes the session of the last
# change review of the pull request, for context, with the diff from the head that review reviewed. That head comes
# from the review comment: the newest comment on the pull request by the oss-verify App (login oss-verify[bot], type
# Bot) that starts with <!-- oss-verify-review -->, from its line <!-- oss-verify-review-head <commit> -->, which
# .github/scripts/review-body writes. It never comes from the runs API, or from LAST_REVIEW, which sits in a cache
# that review.yml's session job writes in main's scope with what the review job kept, after its model read the text
# of the pull request, an outside one too. LAST_REVIEW gives the session's id, which is resumed only when the head
# LAST_REVIEW names is that head.
# KIND=issue, the draft reply to an issue (review-issue.md): only the issue's title, body, author and comments, in
# issue.json, and nothing else.
# KIND=setup, the review of a setup pull request: the pull request on an owner's repository that adds .theorem/.
# check.yml's review job runs it from the checkout of this repository's main, with no token and no build data. It
# reads only FETCHED, the folder that check.yml's fetch job wrote, and LAST_REVIEW. It calls no gh, git, curl or other
# network command, and it runs neither .github/scripts/triage.py nor the rules of .github/scripts/validate_rules/.
# FETCHED has the form setup-fetch/1 (tests/fixtures/setup-fetch/ is one):
#   pr.json                     the setup pull request, as gh pr view --json number,title,author,isDraft,createdAt,
#                               body,headRefOid,files,commits,comments,reviews gives it.
#   pr.diff                     gh pr diff, as this script writes it for an enrollment.
#   review-comments.txt         the review comments, and their authors one login a line, as this script writes
#   review-comment-authors.txt  them for an enrollment.
#   theorem/                    the head's .theorem/ folder, as data.
#   source.tar                  the repository at the head, as GitHub's tarball gives it (gh api
#                               repos/<owner>/<name>/tarball/<head>): one top folder, <owner>-<name>-<commit>/.
#   setup.json, setup.txt       the standard output and the standard error of theorem app setup --at <head>
#                               --repo <owner>/<name> --pr <number> --installer <login> --record record.json --json.
#   record.json                 that command's record: {"installer": <login>, "ticked_by": <login> or null}.
#   repository.json             gh api repos/<owner>/<name>.
#   contributors.json           gh api "repos/<owner>/<name>/contributors?per_page=5".
#   last-review-head.txt        the head that the App's review comment on the pull request names, or nothing.
#   since-last-review.diff      only when that head is an ancestor of the pull request's head: the diff from it.
# A file of the form that is not there stops this with exit status 2, and the message names the file. The directory
# gets pr.json (with keep's last line, below), pr.diff, review-comments.txt, review-comment-authors.txt and
# description.md, as for an enrollment; theorem/, in the place of projects/<name>/; setup.txt, the checks of
# setup.json and the reasons of setup.txt, in the place of validate.txt and the triage comment; record.json as it is;
# repository.txt, from repository.json and contributors.json; source/, from source.tar; the seed listings of the seed
# corpora of theorem/, as for an enrollment; and since-last-review.diff when FETCHED holds it, with only its sections
# of files under .theorem/, as an enrollment's has only those of projects/<name>/. When last-review-head.txt names a
# head, FETCHED holds since-last-review.diff, and LAST_REVIEW names a session kept for that head, it writes `session`
# and `last` to GITHUB_OUTPUT, as for a change.
# The runner reads none of its output as a workflow command: the gathered text is the pull request's or the issue's.
resume=$(openssl rand -hex 16) && echo "::stop-commands::$resume"
trap 'echo "::$resume::"' EXIT
set -uo pipefail
export LC_ALL=C
# The rules of oss-verify validate, for python3 -P -m validate_rules.validate and the import below:
# .github/scripts/validate_rules/, the copy of src/oss_verify/validate.py for the jobs that hold a token, which load no
# code from src/ (.github/scripts/copy-validate-rules). -P keeps the top of the checkout off sys.path, and PYTHONPATH
# names .github/scripts alone.
export PYTHONPATH="$PWD/.github/scripts"

out=${1:?usage: review-gather <directory>}
# Run a command, and keep its standard output and error in a file, whatever its status.
keep() { local file=$1; shift; { "$@"; echo "(exit status $?)"; } > "$out/$file" 2>&1; }
# The head that the last change review of this pull request reviewed, from its review comment alone (the header
# above); nothing when there is none. The comment job edits that comment for each new review, so the newest comment is
# the one with the newest edit. Only review-body writes its head line: review-neutralize takes each line that holds
# oss-verify-review out of the review's text. A comment whose head line is not one commit id gives nothing.
reviewed_head() {
  local newest head
  newest=$(gh api --paginate "repos/$REPO/issues/$PR/comments?per_page=100" --jq '.[]
      | select(.user.login == "oss-verify[bot]" and .user.type == "Bot"
               and (.body // "" | startswith("<!-- oss-verify-review -->")))
      | [(.updated_at // .created_at // ""), (.id | tostring),
         ([.body | split("\n")[] | capture("^<!-- oss-verify-review-head (?<head>[0-9a-f]{40}) -->$").head]
          | if length == 1 then .[0] else "" end)]
      | join("\u001f")' 2> /dev/null | sort -t $'\x1f' -k1,1 -k2,2n | tail -n 1) || return 0
  IFS=$'\x1f' read -r _ _ head <<< "$newest"
  if [[ ${head:-} =~ ^[0-9a-f]{40}$ ]]; then echo "$head"; fi
  return 0
}
# Each seed corpus of the folder $1: its listing, and the first 512 bytes of each of its first 200 inputs, in
# hexadecimal. The zip is the pull request's. read() with no size decompresses the whole member before it cuts the
# member, so this reads 512 bytes through open(). zipfile decompresses bzip2 and lzma with no bound, also for a read
# with a size. So this reads only a stored or deflated member, and gives a line for each other member that says that
# it is not read. open() raises RuntimeError for an encrypted member, because this gives no password. So this reads no
# member whose bit 0x1 of the general purpose bit flag is set, as read_member of .github/scripts/artifact.py does, and
# gives a line for it too.
seed_listings() {
  local zip target
  for zip in "$1"/*_seed_corpus.zip; do
    [ -f "$zip" ] || continue
    target=$(basename "$zip" _seed_corpus.zip)
    keep "seeds/$target.listing.txt" unzip -l "$zip"
    python3 -P - "$zip" "$out/seeds/$target.hex.txt" <<'EOF'
import sys, zipfile
with zipfile.ZipFile(sys.argv[1]) as archive, open(sys.argv[2], "w") as out:
    for info in [i for i in archive.infolist() if not i.is_dir()][:200]:
        out.write(f"== {info.filename!r}: {info.file_size} bytes\n")
        if info.compress_type not in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED):
            out.write(f"(not read: compression method {info.compress_type}, not stored or deflated)\n")
            continue
        if info.flag_bits & 0x1:
            out.write("(not read: encrypted)\n")
            continue
        with archive.open(info) as member:
            data = member.read(512)
        for at in range(0, len(data), 16):
            row = data[at:at + 16]
            text = "".join(chr(b) if 32 <= b < 127 else "." for b in row)
            out.write(f"{at:04x}  {row.hex(' '):<47}  {text}\n")
EOF
  done
}
# KIND=setup (the header above): each command reads a file of FETCHED or LAST_REVIEW, or writes in the directory. No
# command reads the network.
gather_setup() {
  local name reviewed="" session="" kept=""
  [[ -n ${FETCHED:-} && -d $FETCHED && ! -L $FETCHED ]] || { echo "review-gather: FETCHED is not a folder" >&2; exit 2; }
  for name in pr.json pr.diff review-comments.txt review-comment-authors.txt theorem/ source.tar setup.json setup.txt \
      record.json repository.json contributors.json last-review-head.txt; do
    if [[ $name == */ ]]; then
      [[ -d $FETCHED/$name && ! -L $FETCHED/${name%/} ]] && continue
    else
      [[ -f $FETCHED/$name && ! -L $FETCHED/$name ]] && continue
    fi
    echo "review-gather: FETCHED has no $name, which the form setup-fetch/1 has" >&2
    exit 2
  done
  mkdir -p "$out/seeds"
  # pr.json with keep's last line, as the screen and the review read it: the status is jq's, which fails on a file
  # that is not JSON.
  keep pr.json jq -c . "$FETCHED/pr.json"
  cp -- "$FETCHED/pr.diff" "$FETCHED/review-comments.txt" "$FETCHED/review-comment-authors.txt" \
    "$FETCHED/record.json" "$out/"
  jq -r '.body // ""' "$FETCHED/pr.json" > "$out/description.md" 2> /dev/null
  # The head's .theorem/, in the place of projects/<name>/, as data: regular files and folders alone. cp -R copies a
  # symbolic link as a link and follows none, and find then takes out each file that is not a regular file or a
  # folder. Claude Code reads a CLAUDE.md, an AGENTS.md or a .claude/ beside a file that it reads as instructions:
  # the pull request's are data, so they go too (rule 1 of review.md).
  rm -rf "$out/theorem"
  cp -R -- "$FETCHED/theorem" "$out/theorem"
  find "$out/theorem" -mindepth 1 ! -type f ! -type d -delete
  find "$out/theorem" \( -iname 'CLAUDE*.md' -o -iname 'AGENTS*.md' -o -name .claude \) -prune -exec rm -rf {} +
  # The checks of theorem app setup and their reasons, in the place of validate.txt and the triage comment. A check's
  # name is a short word, so that no line of setup.json can look like another check.
  {
    echo "== the checks of theorem app setup (setup.json): each check's name, and pass or fail"
    jq -r 'if type == "array" and all(.[]; type == "object" and (.name | type == "string" and
               test("\\A[a-z][a-z0-9_-]{0,63}\\z")) and (.result == "pass" or .result == "fail"))
           then .[] | "\(.name) \(.result)"
           else error("setup.json is not a list of checks, each with a name and the result pass or fail") end' \
      "$FETCHED/setup.json"
    echo "(exit status $?)"
    echo
    echo "== the reasons (setup.txt, the standard error of theorem app setup)"
    cat -- "$FETCHED/setup.txt"
    echo "(exit status $?)"
  } > "$out/setup.txt" 2>&1
  # The repository's facts, in the form of an enrollment's repository.txt (below) where FETCHED has them.
  {
    jq -r '"repo: \(.html_url)"' "$FETCHED/repository.json"
    echo "Not read for a setup pull request, which reads no network: git ls-remote, the comparisons, and the pull" \
      "requests of a ref."
    echo
    echo "== the repository on GitHub"
    jq -cS '{full_name, default_branch, fork, archived, pushed_at, created_at, stargazers_count, forks_count,
             license: .license.spdx_id}' "$FETCHED/repository.json"
    echo "(exit status $?)"
    echo
    echo "== contributors (the top 5, with their commits)"
    jq -r '.[] | "\(.login) \(.contributions)"' "$FETCHED/contributors.json"
    echo "(exit status $?)"
  } > "$out/repository.txt" 2>&1
  # The repository at the head, as data, from GitHub's tarball. Each of its members is in one top folder,
  # <owner>-<name>-<commit>/, and source/ gets what is in that folder. It takes only a folder or a regular file. It
  # does not take a symbolic link or a hard link, a device, a FIFO, a sparse file, a member whose path is absolute or
  # has a part "..", or a member outside the top folder, and it names each one that it does not take. A PAX header can
  # make a member of the type of a regular file sparse, with holes of any size that the tar holds no byte of, so a
  # member is a sparse file by its header (issparse), whatever its type. It makes each folder and each file itself,
  # and it makes no link, so nothing that it writes is outside source/. A tar that it cannot read gives no source/,
  # and source.txt says so.
  rm -rf "$out/source" "$out/source.txt"
  if python3 -P - "$FETCHED/source.tar" "$out/source" <<'EOF'
import os, shutil, sys, tarfile
tar, into = sys.argv[1], sys.argv[2]
top, refused = None, []
try:
    with tarfile.open(tar, "r:*") as archive:
        os.mkdir(into)
        for member in archive:
            parts = member.name.split("/")
            if member.name.startswith("/") or ".." in parts:
                refused.append((member.name, "its path leaves the folder"))
                continue
            top = parts[0] if top is None else top
            rest = [part for part in parts[1:] if part not in ("", ".")]
            if parts[0] in ("", ".") or parts[0] != top or not (rest or member.isdir()):
                refused.append((member.name, "it is not in the top folder"))
                continue
            path = os.path.join(into, *rest)
            try:
                if member.isdir():
                    os.makedirs(path, exist_ok=True)
                elif member.issparse():
                    refused.append((member.name, "it is a sparse file"))
                elif member.type in (tarfile.REGTYPE, tarfile.AREGTYPE):
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    file = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
                    with os.fdopen(file, "wb") as out, archive.extractfile(member) as data:
                        shutil.copyfileobj(data, out)
                else:
                    refused.append((member.name, f"it is not a folder or a regular file (tar type {member.type!r})"))
            except (FileExistsError, NotADirectoryError, IsADirectoryError):
                refused.append((member.name, "another member has its path"))
except Exception as e:
    sys.exit(f"review-gather: source.tar is not a tar file that can be read: {type(e).__name__}: {e}")
for name, why in refused[:20]:
    print(f"review-gather: source.tar: not taken: {name!r}: {why}", file=sys.stderr)
if len(refused) > 20:
    print(f"review-gather: source.tar: not taken: {len(refused) - 20} more members", file=sys.stderr)
EOF
  then
    find "$out/source" \( -iname 'CLAUDE*.md' -o -iname 'AGENTS*.md' -o -name .claude \) -prune -exec rm -rf {} +
  else
    rm -rf "$out/source"
    echo "Not gathered: source.tar of the fetch job could not be read as a tar file, so there is no source to read." \
      > "$out/source.txt"
  fi
  seed_listings "$out/theorem"
  # The diff since the last review, with only its sections of files under .theorem/, as since_diff (below) keeps only
  # those of projects/<name>/ for an enrollment: a setup pull request changes only .theorem/, but a merge of the
  # default branch into theorem/setup puts each change of that branch in the diff from the last review's head.
  if [[ -f $FETCHED/since-last-review.diff && ! -L $FETCHED/since-last-review.diff ]]; then
    keep since-last-review.diff awk -v a="a/.theorem/" -v b="b/.theorem/" \
      '/^diff --git / { take = index($0, "diff --git " a) == 1 || index($0, " " b) > 0 } take' \
      "$FETCHED/since-last-review.diff"
  fi
  # As for a change: the head that the last review reviewed comes from the App's review comment, which the fetch job
  # read (last-review-head.txt), and LAST_REVIEW gives the session's id only when it names that same head.
  IFS= read -r reviewed < "$FETCHED/last-review-head.txt"
  [[ $reviewed =~ ^[0-9a-f]{40}$ ]] || reviewed=""
  read -r session kept < <(sed -n 's/^session=\([0-9a-f-]\{36\}\) head=\([0-9a-f]\{40\}\)$/\1 \2/p' \
    "${LAST_REVIEW:-/nonexistent}" 2> /dev/null | head -n 1)
  if [[ -n $reviewed && -n $session && $kept != "$reviewed" ]]; then
    echo "review-gather: the session in the cache was kept for $kept, not $reviewed: the review is fresh"
  elif [[ -n $reviewed && -n $session ]]; then
    if [ "$(tail -n 1 "$out/since-last-review.diff" 2> /dev/null)" = "(exit status 0)" ]; then
      echo "review-gather: the setup review resumes the session $session, with the diff from $reviewed, the head its" \
        "last review reviewed (its review comment)"
      { echo "session=$session"; echo "last=$reviewed"; } >> "${GITHUB_OUTPUT:-/dev/null}"
    else
      echo "review-gather: no diff from $reviewed, the head the last review reviewed: the review is fresh"
    fi
  fi
}
case ${KIND:-} in
  setup)
    gather_setup
    exit 0
    ;;
  issue)
    [[ ${ISSUE:-} =~ ^[0-9]+$ ]] || { echo "review-gather: ISSUE is not a number" >&2; exit 2; }
    mkdir -p "$out"
    keep issue.json gh issue view "$ISSUE" -R "$REPO" --json number,title,author,createdAt,body,comments
    exit 0
    ;;
  change) ;;
  enrollment)
    [[ ${NAME:-} =~ ^[a-z0-9][a-z0-9._-]{0,62}$ ]] || { echo "review-gather: NAME is not a project name" >&2; exit 2; }
    ;;
  *)
    echo "review-gather: KIND is not enrollment, change, issue or setup" >&2
    exit 2
    ;;
esac
[[ ${PR:-} =~ ^[0-9]+$ ]] || { echo "review-gather: PR is not a number" >&2; exit 2; }
mkdir -p "$out"

keep pr.json gh pr view "$PR" -R "$REPO" --json \
  number,title,author,isDraft,createdAt,body,headRefOid,files,commits,comments,reviews
# Apart, so that a token that cannot read the checks leaves pr.json whole.
keep checks.json gh pr view "$PR" -R "$REPO" --json statusCheckRollup
gh pr diff "$PR" -R "$REPO" > "$out/pr.diff" 2>&1
# One read gives both files: the review comments as the review reads them, and their authors, one login a line, which
# review.yml's gather job asks GitHub about (an account without write access has the screen read the text first).
gh api --paginate "repos/$REPO/pulls/$PR/comments" \
  --jq '.[] | [(.user.login // "-"), "\(.user.login) \(.path):\(.line) \(.body)"]' > "$out/review-comments.json" 2>&1
status=$?
{ jq -r '.[1]' "$out/review-comments.json" 2> /dev/null || cat "$out/review-comments.json"
  echo "(exit status $status)"; } > "$out/review-comments.txt"
# A read that failed names "-", no account, so the gather job takes it as an account without write access.
{ { [ "$status" = 0 ] && jq -r '.[0]' "$out/review-comments.json" 2> /dev/null; } || echo "-"
  echo "(exit status $status)"; } > "$out/review-comment-authors.txt"
rm -f "$out/review-comments.json"
if [ "$KIND" = change ]; then
  # Claude Code reads a CLAUDE.md or .claude/ beside a file it reads as instructions: the pull request's are data.
  # Every file, not only the first 100 that pr.json lists.
  gh api --paginate "repos/$REPO/pulls/$PR/files?per_page=100" --jq '.[].filename' 2> /dev/null \
    | while IFS= read -r path; do
    [[ $path =~ ^[A-Za-z0-9._/-]+$ && $path != *..* && ${HEAD_SHA:-} =~ ^[0-9a-f]{40}$ ]] || continue
    [[ ${path,,} =~ (^|/)(claude[^/]*\.md|agents[^/]*\.md|\.claude)(/|$) ]] && continue
    mkdir -p "$out/head/$(dirname "$path")"
    # Cut at 1 MiB: the pull request's author chooses each file's size. gh stopped by head at the cut (status 141)
    # read the file; any other failure leaves no file.
    gh api -H 'Accept: application/vnd.github.raw' "repos/$REPO/contents/$path?ref=$HEAD_SHA" 2> /dev/null \
      | head -c 1048576 > "$out/head/$path"
    status=${PIPESTATUS[0]}
    [ "$status" = 0 ] || [ "$status" = 141 ] || rm -f "$out/head/$path"
  done
  reviewed=$(reviewed_head)
  # The cache's file gives the session's id, and its head must be the one the review comment gave: a session kept for
  # another head (a review whose save did not happen, an older run's entry) is not the session of that review.
  read -r session kept < <(sed -n 's/^session=\([0-9a-f-]\{36\}\) head=\([0-9a-f]\{40\}\)$/\1 \2/p' \
    "${LAST_REVIEW:-/nonexistent}" 2> /dev/null | head -n 1)
  if [[ -n $reviewed && -n ${session:-} && ${kept:-} != "$reviewed" ]]; then
    echo "review-gather: the session in the cache was kept for $kept, not $reviewed: the review is fresh"
  elif [[ -n $reviewed && -n ${session:-} && ${HEAD_SHA:-} =~ ^[0-9a-f]{40}$ ]]; then
    status=$(gh api "repos/$REPO/compare/$reviewed...$HEAD_SHA" --jq .status 2> /dev/null) || status=""
    if [ "$status" = ahead ]; then
      keep since-last-review.diff gh api -H 'Accept: application/vnd.github.diff' "repos/$REPO/compare/$reviewed...$HEAD_SHA"
    fi
    if [ "$(tail -n 1 "$out/since-last-review.diff" 2> /dev/null)" = "(exit status 0)" ]; then
      echo "review-gather: the change review resumes the session $session, with the diff from $reviewed, the head its" \
        "last review reviewed (its review comment), to $HEAD_SHA"
      { echo "session=$session"; echo "last=$reviewed"; } >> "${GITHUB_OUTPUT:-/dev/null}"
    else
      echo "review-gather: no diff from $reviewed, the head the last review reviewed, to $HEAD_SHA (compare status" \
        "${status:-unknown}): the review is fresh"
    fi
  fi
  exit 0
fi
mkdir -p "$out/build" "$out/seeds"
printf '%s\n' "${BUILD:-}" > "$out/build/result.md"
printf '%s\n' "${BINARIES:-}" > "$out/build/binaries.md"
printf '%s\n' "${CHECKS:-}" > "$out/build/checks.md"
dir="projects/$NAME"
# Any user can comment with the triage marker; take only the oss-verify App's comment, which this repository posts.
jq -r '[.comments[]? | select(.author.login == "oss-verify")]
       | map(.body | select(startswith("<!-- oss-verify-triage -->"))) | .[0] // ""' "$out/pr.json" \
  > "$out/triage-comment.md" 2>/dev/null || true
# --full: the review reads every row of the triage (its standing, stars, outside participants, criticality score and
# OSS-Fuzz rows too), not only the five that the public comment carries. --facts: the same run writes the criticality
# score and OSS-Fuzz as JSON, for the step's outputs (below), to a file beside the directory and not in it, so that
# what the screen and the review read does not change.
# triage.py reads GITHUB_TOKEN from the environment; the assignment prefix exports it to python3 without it becoming an
# argument of any process (env put it in the argument vector, which another user on the machine can read).
GITHUB_TOKEN="${GH_TOKEN:-}" keep triage-today.md python3 .github/scripts/triage.py --repo "$REPO" --pr "$PR" --full --facts "$out.facts.json"
# The step's outputs criticality_score and oss_fuzz: a value of another JSON type is null, and both are null when
# triage.py wrote no file, or a file that is not one JSON object. The file goes after the read, whatever it held.
facts=$(jq -rs 'if length == 1 and (.[0] | type) == "object" then .[0] else {} end
  | "criticality_score=\(.criticality_score | if type == "number" then tojson else "null" end)",
    "oss_fuzz=\(.oss_fuzz | if type == "boolean" then tojson else "null" end)"' "$out.facts.json" 2> /dev/null) \
  || facts=$'criticality_score=null\noss_fuzz=null'
rm -f "$out.facts.json"
echo "$facts" >> "${GITHUB_OUTPUT:-/dev/null}"
keep validate.txt python3 -P -m validate_rules.validate "$dir"
# Claude Code reads a CLAUDE.md beside a file that it reads as instructions. The pull request's are data, so they go
# from the checkout once the validator has reported them (rule 1 of review.md).
find "$dir" -maxdepth 1 \( -iname 'CLAUDE*.md' -o -iname 'AGENTS*.md' \) -delete

# Check B of review.md: each box of the description against today's template.
jq -r '.body // ""' "$out/pr.json" > "$out/description.md" 2>/dev/null
keep checklist.txt python3 -P - "$NAME" "$out/description.md" <<'EOF'
import re, sys
name, body = sys.argv[1], open(sys.argv[2], encoding="utf-8", errors="replace").read()
box = re.compile(r'^\s*[-*] \[([ xX])\] (.*?)\s*$', re.M)
norm = lambda t: re.sub(r'\s+', ' ', t.replace('<name>', name)).strip()
want = [norm(t) for _, t in box.findall(open('.github/PULL_REQUEST_TEMPLATE.md').read())]
got = {norm(t): m for m, t in box.findall(body.replace('\r', ''))}
for t in want:
    print('ticked  ' if got.get(t, ' ') != ' ' else 'unticked' if t in got else 'MISSING ', t[:90])
for t in got:
    if t not in want:
        print('EXTRA   ', t[:90])
EOF
keep template-history.txt git log --format='%h %cI %s' -- .github/PULL_REQUEST_TEMPLATE.md

# The seed listings of each seed corpus of projects/<name>/ (seed_listings, above).
seed_listings "$dir"

# The project's repository: the facts of check G1, and its source at the built commit, as data.
# repo comes from the pull request: it is used only if oss-verify validate's rule for it holds, and its ref is used in
# an API path only if it has no `..` part.
url=$(python3 -P - "$dir/project.yaml" <<'EOF' 2>/dev/null
import sys
from validate_rules import validate
url = validate.yaml.safe_load(open(sys.argv[1])).get("repo")
print(url if validate.is_https_url(url) else "")
EOF
)
repo=${url%%#*} ref=${url#*#}
[ "$ref" = "$url" ] && ref=""
[[ $ref =~ (^|/)\.\.?(/|$) ]] && ref=""
{
  if [ -z "$url" ]; then
    echo "repo: not read: project.yaml's repo does not follow the rule of oss-verify validate"
  fi
  echo "repo: $repo"
  echo "ref: ${ref:-(the default branch)}"
  echo "built commit: ${COMMIT:-(unknown: the build did not get as far as resolving it)}"
  echo
  echo "== git ls-remote <repo> HEAD <ref> refs/heads/<ref> refs/tags/<ref>"
  [ -z "$repo" ] || GIT_TERMINAL_PROMPT=0 timeout 60 git -c credential.helper= -c protocol.allow=never \
    -c protocol.https.allow=always ls-remote -- "$repo" HEAD ${ref:+"$ref" "refs/heads/$ref" "refs/tags/$ref"}
  echo "(exit status $?)"
  if [[ $repo =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/?$ ]] \
      && [[ ${BASH_REMATCH[1]} != .* && ${BASH_REMATCH[2]} != .* ]]; then
    slug="${BASH_REMATCH[1]}/${BASH_REMATCH[2]%.git}"
    echo
    echo "== the repository on GitHub"
    gh api "repos/$slug" --jq '{full_name, default_branch, fork, archived, pushed_at, created_at, stargazers_count, forks_count, license: .license.spdx_id}'
    echo
    echo "== contributors (the top 5, with their commits)"
    gh api "repos/$slug/contributors?per_page=5" --jq '.[] | "\(.login) \(.contributions)"'
    if [[ ${COMMIT:-} =~ ^[0-9a-f]{40}$ ]]; then
      default=$(gh api "repos/$slug" --jq .default_branch)
      echo
      echo "== the built commit against the default branch ($default): status, ahead, behind"
      gh api "repos/$slug/compare/$default...$COMMIT" --jq '"\(.status) \(.ahead_by) \(.behind_by)"'
      if [ -n "$ref" ]; then
        echo
        echo "== the built commit against the ref now: status, ahead, behind"
        gh api "repos/$slug/compare/$COMMIT...$ref" --jq '"\(.status) \(.ahead_by) \(.behind_by)"'
        echo
        echo "== pull requests whose head branch is the ref"
        gh pr list -R "$slug" --head "$ref" --state all --json number,state,title,url
      fi
    fi
  fi
} > "$out/repository.txt" 2>&1

if [[ ${COMMIT:-} =~ ^[0-9a-f]{40}$ ]]; then
  source="$out/source"
  rm -rf "$source"
  git init -q "$source"
  if GIT_TERMINAL_PROMPT=0 timeout 600 git -C "$source" -c credential.helper= -c protocol.allow=never \
      -c protocol.https.allow=always fetch -q --depth 1 -- "$repo" "$COMMIT" \
      && git -C "$source" -c advice.detachedHead=false checkout -q FETCH_HEAD; then
    # Data only: no git metadata, and no symbolic link, which could point the reader outside the directory.
    rm -rf "$source/.git"
    find "$source" -type l -delete
    # Claude Code reads a CLAUDE.md or .claude/ in a directory whose files it reads as instructions: the project's are
    # data, so they go (rule 1 of review.md).
    find "$source" \( -iname 'CLAUDE*.md' -o -iname 'AGENTS*.md' -o -name .claude \) -prune -exec rm -rf {} +
  else
    rm -rf "$source"
    echo "review-gather: could not fetch $COMMIT from $repo" >&2
    exit 1
  fi
else
  echo "Not gathered: no commit of the project's repository came from the Build run, so there is no source to read." \
    > "$out/source.txt"
fi
# The changes to projects/<name>/ since the commit of the last review (LAST_REVIEW), whose session the review then
# resumes: HEAD_SHA is the head commit the build took. GitHub's compare diffs from the merge base, which is the last
# review's commit only when the head descends from it (status "ahead"). After a force-push, or on the same head (an
# edit of the pull request), there is no diff, and the review is fresh.
last=$(sed -n 's/^session=\([0-9a-f-]\{36\}\) head=\([0-9a-f]\{40\}\)$/\1 \2/p' "${LAST_REVIEW:-/nonexistent}" 2> /dev/null \
  | head -n 1)
session=${last% *} since=${last#* }
since_diff() {
  gh api -H 'Accept: application/vnd.github.diff' "repos/$REPO/compare/$since...$HEAD_SHA" \
    | awk -v a="a/$dir/" -v b="b/$dir/" '/^diff --git / { take = index($0, "diff --git " a) == 1 || index($0, " " b) > 0 } take'
}
if [[ -n $last && ${HEAD_SHA:-} =~ ^[0-9a-f]{40}$ ]]; then
  status=$(gh api "repos/$REPO/compare/$since...$HEAD_SHA" --jq .status 2> /dev/null) || status=""
  if [ "$status" = ahead ]; then
    keep since-last-review.diff since_diff
  fi
  if [ "$(tail -n 1 "$out/since-last-review.diff" 2> /dev/null)" = "(exit status 0)" ]; then
    echo "review-gather: the review resumes the session $session, for the diff from $since to $HEAD_SHA"
    { echo "session=$session"; echo "last=$since"; } >> "${GITHUB_OUTPUT:-/dev/null}"
  else
    echo "review-gather: no diff from $since, the last review's commit, to $HEAD_SHA (compare status" \
      "${status:-unknown}): the review is fresh"
  fi
fi
ls -la "$out"
