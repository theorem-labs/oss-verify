"""Print the primary_contact that the text of a project.yaml on standard input sets, as oss-verify validate reads it:

    PYTHONPATH=src python3 .github/scripts/primary-contact < project.yaml

.github/workflows/terms.yaml runs it from its checkout of the base branch, with PYTHONPATH set to the src/ of that
checkout. The program writes the text into a new temporary directory as project.yaml, and reads it there with
oss_verify.validate.load, the reader of oss-verify validate: at most validate.MAX_CONFIG_BYTES, as UTF-8, with
yaml.safe_load, which makes only plain data and runs no code.

It prints the value of the key primary_contact as a JSON string when that value is a string. Else it prints ?, and the
contact is unknown: load refuses the text (it is too large, or it does not parse), the text is not a mapping, the key
is not there, or the value is not a string (a number, a list, a mapping, a date, null). It makes JSON of a string only:
a short text of YAML aliases can load to a graph whose JSON is megabytes long. It reads at most
validate.MAX_CONFIG_BYTES + 1 bytes of its standard input, so that a longer text uses no more memory than that. load
refuses that text for its size. The exit status is 0 when the program prints an answer. Without PyYAML, the import of
oss_verify.validate stops the program with another status.
"""
import json
import pathlib
import sys
import tempfile

from oss_verify import validate


def contact(text):
    """The answer for the bytes `text` of a project.yaml: its primary_contact as a JSON string, or ?."""
    with tempfile.TemporaryDirectory() as directory:
        directory = pathlib.Path(directory)
        (directory / "project.yaml").write_bytes(text)
        try:
            config = validate.load(directory)
        except ValueError:
            return "?"
    value = config.get("primary_contact") if isinstance(config, dict) else None
    return json.dumps(value) if isinstance(value, str) else "?"


if __name__ == "__main__":
    print(contact(sys.stdin.buffer.read(validate.MAX_CONFIG_BYTES + 1)))
