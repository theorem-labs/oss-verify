                                       "load_source", "load_module", "load_package"})
# The directory that the scripts put first on sys.path, where a module's name is looked up.
SCRIPTS = ".github/scripts"


def read_as_text(root, path):
    """The text of the file `path` of the checkout `root`, with bytes that are no UTF-8 replaced: a file that a job
    names may be data of any kind."""
    try:
        return (pathlib.Path(root) / path).read_bytes().decode("utf-8", "replace")
    except OSError as error:
        raise Unreadable(f"{path}: it cannot be read: {error}") from None


def line_of(text, at):
    """The line number of the place `at` of `text`."""
    return text.count("\n", 0, at) + 1


class Reading:
    """What the check reads of one text: the code in it, as named reads it; the paths that it names whole (`paths`);
    the Python modules that it imports, each (name, level), and the directories that PYTHONPATH adds for them
    (`python_paths`); the siblings of its script that it names; the files that an interpreter runs, with how (`runs`
    and, for a sibling, `sibling_runs`: "python" or "shell"); and each construct of it outside SUPPORTED, as a
    problem."""

    def __init__(self, where, text=None, base=None):
        self.where, self.text, self.base = where, text, base
        self.code, self.paths, self.imported, self.python_paths, self.siblings = [], [], [], [], []
        self.runs, self.sibling_runs, self.problems = {}, {}, []

    def location(self, at=None, snippet=None):
        """The place `at` of the text, or the line that holds `snippet` in the file that it is in, as <file>:<line>,
        or <file> alone when neither can be found."""
        if at is not None and self.text is not None:
            return f"{self.where}:{line_of(self.text, at)}"
        if snippet is not None and self.text is not None and snippet.strip():
            # As the file writes it: plain, or in YAML's double quotes (escaped as JSON escapes) or single quotes.
            forms = (snippet.strip(), json.dumps(snippet.strip())[1:-1], snippet.strip().replace("'", "''"))
            found = next((at for form in forms if (at := self.text.find(form)) >= 0), None)
            if found is not None:
                return f"{self.where}:{line_of(self.text, found)}"
        return self.where

    def cannot(self, what, at=None, snippet=None):
        """A problem at the place `at` of the text, or at the line that holds `snippet` in the file that it is in."""
        self.problems.append(f"{self.location(at, snippet)}: {what}: {CANNOT}")

    def take(self, other, placed=None):
        """Add what `other` read. With `placed` (at, snippet) in this text, each problem of `other` that names no line
        is placed there: `other` read a program that this text holds."""
        self.code += other.code
        self.paths += other.paths
        self.imported += other.imported
        self.python_paths += [path for path in other.python_paths if path not in self.python_paths]
        self.siblings += other.siblings
        self.runs.update(other.runs)
        self.sibling_runs.update(other.sibling_runs)
        if placed is None:
            self.problems += other.problems
            return
        location = self.location(*placed)
        self.problems += [location + problem[len(other.where):] if problem.startswith(f"{other.where}: ") else problem
                          for problem in other.problems]


def python_reads(text, reading, at=None, snippet=None, root=None):
    """Read the Python program `text` into `reading` (a Reading): its strings but docstrings, as code that names
    files; its imports; each command that it runs (PYTHON_RUNNERS), read as command_reads reads shell; and its
    constructs outside SUPPORTED (a dynamic load of code, a change of sys.path but the insert of its own directory, a
    command or a directory that the check cannot read). A program that ast cannot read is a problem. `at` or
    `snippet` places a problem of a program that is part of another text. `root` is the checkout."""
    def where(node):
        if at is None and snippet is None:
            return sum(len(line) + 1 for line in lines[:node.lineno - 1]), None
        return at, snippet

    def cannot(what, node):
        reading.cannot(what, *where(node))

    lines = text.split("\n")
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError, RecursionError, MemoryError) as error:
        reading.cannot(f"it is no Python that the check can read ({type(error).__name__})", at=at, snippet=snippet)
        return
    docstrings, strings = set(), []
    for node in ast.walk(tree):
        if isinstance(node, (ast.Module, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) and node.body \
                and isinstance(node.body[0], ast.Expr) and isinstance(node.body[0].value, ast.Constant):
            docstrings.add(id(node.body[0].value))

    def self_based(node):
        return any(isinstance(inner, ast.Name) and inner.id == "__file__" for inner in ast.walk(node))

    def dump(node):
        return ast.dump(node, annotate_fields=False)

    def text_of_node(node):
        return node.value if isinstance(node, ast.Constant) and isinstance(node.value, str) else None

    own_directory = dump(ast.parse("os.path.dirname(os.path.realpath(__file__))", mode="eval").body)
    executable = dump(ast.parse("sys.executable", mode="eval").body)
    # The names under which this program has each module of PYTHON_RUNNERS, and each of their functions.
    modules, functions = {}, {}
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name in PYTHON_RUNNERS:
                    modules[alias.asname or alias.name] = alias.name
        elif isinstance(node, ast.ImportFrom) and node.module in PYTHON_RUNNERS and node.level == 0:
            for alias in node.names:
                if alias.name in PYTHON_RUNNERS[node.module] or alias.name == "*":
                    functions[alias.asname or alias.name] = (node.module, alias.name)

    def runner(function):
        """(module, function) of PYTHON_RUNNERS that a call of `function` calls, or None."""
        if isinstance(function, ast.Attribute) and isinstance(function.value, ast.Name) \
                and function.value.id in modules and function.attr in PYTHON_RUNNERS[modules[function.value.id]]:
            return modules[function.value.id], function.attr
        if isinstance(function, ast.Name) and function.id in functions:
            return functions[function.id]
        return None

    context = ShellContext(root, ShellText(""), set(), lambda place: (place, None) if at is None and snippet is None
                           else (at, snippet))

    def run_command(node, module, name):
        """Read the command of the call `node` of module.name."""
        first = node.args[0] if node.args else None
        keywords = {keyword.arg: keyword.value for keyword in node.keywords if keyword.arg}
        place = where(node)[0]
        shell = keywords.get("shell")
        string = text_of_node(first) if first is not None else None
        if name in ("chdir", "fchdir") or "cwd" in keywords:
            directory = first if name in ("chdir", "fchdir") else keywords["cwd"]
            value = text_of_node(directory)
            word = Word([(value, True)], value, 0) if value is not None else Word([("$VALUE", False)], "$VALUE", 0)
            directory_reads(word, f"{module}.{name}", reading, context, place)
            if name in ("chdir", "fchdir"):
                return
        if module == "os" and name in ("system", "popen") or module == "subprocess" and name in (
                "getoutput", "getstatusoutput") or module == "subprocess" and isinstance(shell, ast.Constant) \
                and shell.value is True:
            if string is None:
                cannot(f"{module}.{name}() with a shell command that is no literal string", node)
                return
            inner = Reading(reading.where)
            shell_reads(string, inner, root)
            reading.take(inner, placed=where(node))
            return
        if module == "subprocess" and shell is None and name in ("run", "call", "check_call", "check_output", "Popen"):
            if isinstance(first, (ast.List, ast.Tuple)) and first.elts:
                words = []
                for element in first.elts:
                    value = text_of_node(element)
                    if value is not None:
                        words.append(Word([(value, True)], shlex.quote(value), place or 0))
                    elif dump(element) == executable:
                        words.append(Word([("python3", True)], "python3", place or 0))
                    else:
                        words.append(Word([("$VALUE", False)], "$VALUE", place or 0))
                if words[0].raw == "$VALUE":
                    cannot(f"{module}.{name}() of a program that the check cannot read", node)
                    return
                command = Command(place or 0, None)
                command.words = words
                if words[0].value == "python3" and isinstance(keywords.get("env"), ast.Dict):
                    for key, value in zip(keywords["env"].keys, keywords["env"].values):
                        if text_of_node(key) == "PYTHONPATH":
                            raw = text_of_node(value) if text_of_node(value) is not None else "$VALUE"
                            python_path(Word([(f"PYTHONPATH={raw}", True)], f"PYTHONPATH={raw}", place or 0),
                                        reading, context, place)
                command_reads(command, reading, context)
                return
            if string is not None:
                command = Command(place or 0, None)
                command.words = [Word([(string, True)], shlex.quote(string), place or 0)]
                command_reads(command, reading, context)
                return
        cannot(f"{module}.{name}() with a command that the check cannot read", node)

    for node in ast.walk(tree):
        if isinstance(node, ast.Constant) and isinstance(node.value, str) and id(node) not in docstrings:
            strings.append(node.value)
        elif isinstance(node, ast.Import):
            reading.imported += [(alias.name, 0) for alias in node.names]
        elif isinstance(node, ast.ImportFrom):
            prefix = f"{node.module}." if node.module else ""
            reading.imported += [(node.module or "", node.level)] + [(prefix + alias.name, node.level)
                                                                     for alias in node.names]
        elif isinstance(node, ast.Call):
            function = node.func
            name = function.id if isinstance(function, ast.Name) else getattr(function, "attr", None)
            # A sibling of the script: Path(__file__)...with_name("<name>").
            if name == "with_name" and isinstance(function, ast.Attribute) and self_based(function.value) \
                    and node.args and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str):
                reading.siblings.append(node.args[0].value)
            if isinstance(function, ast.Name) and name in PYTHON_DYNAMIC_NAMES \
                    or isinstance(function, ast.Attribute) and name in PYTHON_DYNAMIC_ATTRIBUTES:
                cannot(f"{name}(), which loads code that no import names", node)
            if name == "SourceFileLoader" and not (len(node.args) == 2 and any(
                    isinstance(inner, ast.Call) and getattr(inner.func, "attr", None) == "with_name"
                    and self_based(inner.func) for inner in ast.walk(node.args[1]))):
                cannot("SourceFileLoader of a file that is no sibling named as Path(__file__)...with_name()", node)
            if isinstance(function, ast.Attribute) and isinstance(function.value, ast.Attribute) \
                    and function.value.attr == "path" and getattr(function.value.value, "id", None) == "sys" \
                    and not (name == "insert" and len(node.args) == 2 and dump(node.args[1]) == own_directory):
                cannot(f"sys.path.{name}(), which changes where imports are found", node)
            if (found := runner(function)) is not None:
                run_command(node, *found)
        elif isinstance(node, (ast.Assign, ast.AugAssign, ast.AnnAssign)):
            for target in node.targets if isinstance(node, ast.Assign) else [node.target]:
                inner = target.value if isinstance(target, ast.Subscript) else target
                if isinstance(inner, ast.Attribute) and inner.attr == "path" \
                        and getattr(inner.value, "id", "") == "sys":
                    cannot("an assignment to sys.path, which changes where imports are found", node)
    reading.code.append("\n".join(strings))


class Word:
    """A word of shell text: `parts`, each (text, literal), where a literal part holds the text that the shell gives
    (its quotes removed) and any other part the text as written ($x, $(...), a glob); `raw`, the word as written; and
    `start`, where it starts in the text that holds it."""

    __slots__ = ("parts", "raw", "start")

    def __init__(self, parts, raw, start):
        self.parts, self.raw, self.start = parts, raw, start

    @property
    def value(self):
        return "".join(text for text, _ in self.parts)

    @property
    def literal(self):
        return all(literal for _, literal in self.parts)

    @property
    def bare(self):
        """A literal word with no quote and no backslash in it, as a keyword must be written."""
        return self.literal and self.raw == self.value


class Command:
    """A simple command of shell text: its words (the first names the program), the assignments before them, its
    redirections as (operator, Word), its here-strings, its heredocs as (body, literal, where the body starts), where
    it starts, and the text of the command substitution that holds it, if any."""

    __slots__ = ("words", "assignments", "redirects", "here_strings", "heredocs", "start", "inside", "function")

    def __init__(self, start, inside, function=None):
        self.words, self.assignments, self.redirects, self.here_strings, self.heredocs = [], [], [], [], []
        self.start, self.inside, self.function = start, inside, function


class ShellText:
    """A parse of shell text, as bash reads a step's run or a script: each simple command (`commands`), from each
    nested $( ), ` `, <( ) and >( ) too; each word read (`words`); the functions that it defines (`functions`); and
    what it cannot parse (`problems`, each (what, where))."""

    def __init__(self, text):
        self.text = text
        self.commands, self.words, self.functions, self.problems = [], [], set(), []
        self.loop_variables = set()
        _ShellParser(self, 0, len(text), None).parse()


class _ShellParser:
    """The parser of one range of a ShellText's text: [start, end), inside the command substitution `inside`."""

    def __init__(self, owner, start, end, inside):
        self.owner, self.text, self.i, self.end, self.inside = owner, owner.text, start, end, inside
        self.pending = []  # The heredocs whose bodies start after the next newline: (command, marker, strip tabs).

    def problem(self, what, at):
        self.owner.problems.append((what, at))

    def skip_blanks(self):
        text = self.text
        while self.i < self.end:
            char = text[self.i]
            if char in " \t":
                self.i += 1
            elif text.startswith("\\\n", self.i):
                self.i += 2
            elif char == "#":
                end = text.find("\n", self.i, self.end)
                self.i = self.end if end < 0 else end
            else:
                return

    def token(self):
        """The next token: ("eof", None, at), ("newline", None, at), ("op", operator, at), ("redirect", operator,
        at) or ("word", Word, at)."""
        self.skip_blanks()
        text, at = self.text, self.i
        if at >= self.end:
            return "eof", None, at
        if text[at] == "\n":
            self.i += 1
            self.read_heredocs()
            return "newline", None, at
        if text.startswith(("<(", ">("), at):
            return "word", self.read_word(), at
        match = SHELL_REDIRECT.match(text, at, self.end)
        if match:
            self.i = match.end()
            return "redirect", match["op"], at
        for operator in SHELL_OPERATORS:
            if text.startswith(operator, at):
                self.i = at + len(operator)
                return "op", operator, at
        return "word", self.read_word(), at

    def close(self, at, opener, closer):
        """Where the `closer` that matches an `opener` just before `at` stands, or -1."""
        text, depth, i = self.text, 1, at
        while i < self.end:
            char = text[i]
            if char == "\\":
                i += 2
                continue
            if char == "'":
                end = text.find("'", i + 1, self.end)
                if end < 0:
                    return -1
                i = end + 1
                continue
            if char in '"`':
                i = self.skip_quoted(i + 1, char)
                if i < 0:
                    return -1
                continue
            if text.startswith(("$(", "${"), i):
                end = self.close(i + 2, text[i + 1], ")" if text[i + 1] == "(" else "}")
                if end < 0:
                    return -1
                i = end + 1
                continue
            if char == opener:
                depth += 1
            elif char == closer:
                depth -= 1
                if depth == 0:
                    return i
            i += 1
        return -1

    def skip_quoted(self, at, quote):
        """The place after the `quote` (" or `) that closes the string that starts at `at`, or -1."""
        text, i = self.text, at
        while i < self.end:
            char = text[i]
            if char == "\\":
                i += 2
                continue
            if char == quote:
                return i + 1
            if quote == '"' and text.startswith(("$(", "${"), i):
                end = self.close(i + 2, text[i + 1], ")" if text[i + 1] == "(" else "}")
                if end < 0:
                    return -1
                i = end + 1
                continue
            if quote == '"' and char == "`":
                i = self.skip_quoted(i + 1, "`")
                if i < 0:
                    return -1
                continue
            i += 1
        return -1

    def substitutions(self, start, end):
        """Parse each command substitution in [start, end) of text that is not itself a command (an arithmetic
        expression, a ${ }, a heredoc that the shell expands)."""
        text, i = self.text, start
        while i < end:
            if text.startswith("$(", i) and not text.startswith("$((", i):
                close = self.close(i + 2, "(", ")")
                if close < 0 or close > end:
                    self.problem("a $( that is not closed", i)
                    return
                _ShellParser(self.owner, i + 2, close, text[i + 2:close]).parse()
                i = close + 1
            elif text[i] == "`":
                close = self.skip_quoted(i + 1, "`")
                if close < 0 or close > end:
                    self.problem("a ` that is not closed", i)
                    return
                self.backticks(i, close - 1)
                i = close
            else:
                i += 1

    def backticks(self, at, close):
        """Parse the command substitution ` ` from `at` to `close`, its backslashes read as bash reads them there."""
        body = re.sub(r"\\([\\`$])", r"\1", self.text[at + 1:close])
        inner = ShellText(body)
        for command in inner.commands:
            command.start, command.inside = at, body
            for word in [*command.words, *command.assignments]:
                word.start = at
            self.owner.commands.append(command)
        for word in inner.words:
            word.start = at
        self.owner.words += inner.words
        self.owner.functions |= inner.functions
        self.owner.problems += [(what, at) for what, _ in inner.problems]

    def read_dollar(self, i, parts):
        """Read the expansion that starts with the $ at `i` into `parts`; return where it ends."""
        text = self.text
        if text.startswith("$(", i):
            close = self.close(i + 2, "(", ")")
            if close < 0:
                self.problem("a $( that is not closed", i)
                return self.end
            if text.startswith("$((", i) and text[close - 1] == ")":
                self.substitutions(i + 3, close - 1)
            else:
                _ShellParser(self.owner, i + 2, close, text[i + 2:close]).parse()
            parts.append((text[i:close + 1], False))
            return close + 1
        if text.startswith("${", i):
            close = self.close(i + 2, "{", "}")
            if close < 0:
                self.problem("a ${ that is not closed", i)
                return self.end
            self.substitutions(i + 2, close)
            parts.append((text[i:close + 1], False))
            return close + 1
        match = SHELL_PARAMETER.match(text, i)
        if match:
            parts.append((match[0], False))
            return match.end()
        parts.append(("$", True))
        return i + 1

    def read_word(self):
        """Read the word at the current place, and each command substitution in it."""
        text, start, parts, bare = self.text, self.i, [], []
        i = start
        if text.startswith(("<(", ">("), i):
            close = self.close(i + 2, "(", ")")
            if close < 0:
                self.problem("a process substitution that is not closed", i)
                close = self.end - 1
            else:
                _ShellParser(self.owner, i + 2, close, text[i + 2:close]).parse()
            parts.append((text[i:close + 1], False))
            i = close + 1
        while i < self.end:
            char = text[i]
            if char in " \t\n;&|<>()":
                break
            if char == "\\":
                if text.startswith("\\\n", i):
                    i += 2
                    continue
                parts.append((text[i + 1:i + 2], True))
                i += 2
                continue
            if text.startswith("$'", i):
                j = i + 2
                while j < self.end and text[j] != "'":
                    j += 2 if text[j] == "\\" else 1
                parts.append((text[i:j + 1], False))
                i = j + 1
                continue
            if char == "'":
                end = text.find("'", i + 1, self.end)
                if end < 0:
                    self.problem("a ' that is not closed", i)
                    i = self.end
                    break
                parts.append((text[i + 1:end], True))
                i = end + 1
                continue
            if char == '"' or text.startswith('$"', i):
                i += 2 if char == "$" else 1
                while i < self.end and text[i] != '"':
                    if text[i] == "\\" and text[i + 1:i + 2] in ('"', "\\", "$", "`", "\n"):
                        parts.append((text[i + 1] if text[i + 1] != "\n" else "", True))
                        i += 2
                    elif text[i] == "$" and SHELL_EXPANDS.match(text, i + 1):
                        i = self.read_dollar(i, parts)
                    elif text[i] == "`":
                        close = self.skip_quoted(i + 1, "`")
                        if close < 0:
                            self.problem("a ` that is not closed", i)
                            i = self.end
                            break
                        self.backticks(i, close - 1)
                        parts.append((text[i:close], False))
                        i = close
                    else:
                        parts.append((text[i], True))
                        i += 1
                if i >= self.end:
                    self.problem('a " that is not closed', start)
                    break
                i += 1
                continue
            if char == "$":
                i = self.read_dollar(i, parts)
                continue
            if char == "`":
                close = self.skip_quoted(i + 1, "`")
                if close < 0:
                    self.problem("a ` that is not closed", i)
                    i = self.end
                    break
                self.backticks(i, close - 1)
                parts.append((text[i:close], False))
                i = close
                continue
            parts.append((char, True))
            bare.append(char)
            i += 1
        self.i = i
        # A glob, a brace expansion or a leading ~: the shell makes the word, so it is no literal.
        if SHELL_GLOB.search("".join(bare)) or text.startswith("~", start):
            parts.append(("", False))
        word = Word(parts, text[start:i], start)
        self.owner.words.append(word)
        return word

    def read_heredocs(self):
        """Read the bodies of the pending heredocs, which start at the current place, the line after their marker."""
        text = self.text
        for command, marker, strip in self.pending:
            start = position = self.i
            while True:
                end = text.find("\n", position, self.end)
                line = text[position:self.end if end < 0 else end]
                if (line.lstrip("\t") if strip else line) == marker.value:
                    body, self.i = text[start:position], self.end if end < 0 else end + 1
                    break
                if end < 0:
                    self.problem(f"a heredoc with no line {marker.value} to end it", marker.start)
                    body, self.i = text[start:self.end], self.end
                    break
                position = end + 1
            if strip:
                body = "\n".join(line.lstrip("\t") for line in body.split("\n"))
            quoted = marker.raw != marker.value
            if not quoted:
                self.substitutions(start, start + len(body))
            command.heredocs.append((body, quoted or not re.search(r"[$`\\]", body), start))
        self.pending = []

    def until(self, done):
        """Read tokens until `done(kind, value)` holds or the text ends; their words are no commands."""
        while True:
            kind, value, _ = self.token()
            if kind == "eof" or done(kind, value):
                return

    def parse(self):
        # The braces open at this place: each the name of the function whose body it holds, or None.
        command, expect, cases, braces, defining = None, True, [], [], None

        def finish():
            nonlocal command
            if command is not None:
                self.owner.commands.append(command)
            command = None

        def current(at):
            nonlocal command
            if command is None:
                command = Command(at, self.inside, next((name for name in reversed(braces) if name), None))
            return command

        while True:
            kind, value, at = self.token()
            if kind == "eof":
                finish()
                for _, marker, _ in self.pending:
                    self.problem(f"a heredoc with no line {marker.value} to end it", marker.start)
                return
            if cases and cases[-1] == "pattern":
                # case ... in: the patterns of an item, up to its ).
                if kind == "op" and value == ")":
                    cases[-1], expect = "body", True
                elif kind == "word" and value.bare and value.value == "esac":
                    cases.pop()
                    expect = False
                continue
            if kind == "newline" or kind == "op" and value in (";", "&", "&&", "||", "|", "|&"):
                finish()
                expect = True
                continue
            if kind == "op" and value in (";;", ";&", ";;&"):
                finish()
                if cases:
                    cases[-1] = "pattern"
                expect = True
                continue
            if kind == "op" and value == "(":
                self.skip_blanks()
                if command is not None and len(command.words) == 1 and not command.redirects \
                        and self.text.startswith(")", self.i):
                    # name ( ): a function.
                    self.i += 1
                    self.owner.functions.add(command.words[0].value)
                    defining, command, expect = command.words[0].value, None, True
                elif command is not None and not command.words and command.assignments \
                        and command.assignments[-1].start + len(command.assignments[-1].raw) == at:
                    # name=( ... ): an array.
                    self.until(lambda kind, value: kind == "op" and value == ")")
                elif expect and command is None and self.text.startswith("(", at + 1):
                    # (( ... )): arithmetic.
                    close = self.close(at + 2, "(", ")")
                    if close >= 0 and self.text.startswith(")", close + 1):
                        self.substitutions(at + 2, close)
                        self.i, expect = close + 2, False
                    else:
                        expect = True
                else:
                    finish()
                    expect = True
                continue
            if kind == "op" and value == ")":
                finish()
                expect = False
                continue
            if kind == "redirect":
                target = current(at)
                self.skip_blanks()
                if value in ("<<", "<<-"):
                    self.pending.append((target, self.read_word(), value == "<<-"))
                elif self.i < self.end and (self.text[self.i] not in "\n;&|()<>"
                                            or self.text.startswith(("<(", ">("), self.i)):
                    word = self.read_word()
                    if value == "<<<":
                        target.here_strings.append(word)
                    else:
                        target.redirects.append((value, word))
                continue
            word = value
            if command is None and expect and word.bare:
                name = word.value
                if name in SHELL_PREFIXES:
                    if name == "{":
                        braces.append(defining)
                        defining = None
                    continue
                if name in SHELL_CLOSERS or name == "esac" and cases:
                    if name == "esac":
                        cases.pop()
                    if name == "}" and braces:
                        braces.pop()
                    expect = False
                    continue
                if name == "case":
                    self.until(lambda kind, value: kind == "word" and value.bare and value.value == "in")
                    cases.append("pattern")
                    continue
                if name in ("for", "select"):
                    self.skip_blanks()
                    if self.text.startswith("((", self.i):
                        close = self.close(self.i + 1, "(", ")")
                        self.substitutions(self.i + 2, max(close, self.i + 2))
                        self.i = self.end if close < 0 else close + 1
                    else:
                        kind, value, _ = self.token()
                        if kind == "word":
                            self.owner.loop_variables.add(value.value)
                        self.until(lambda kind, value: kind == "newline" or kind == "op" and value == ";")
                    continue
                if name == "function":
                    kind, value, _ = self.token()
                    if kind == "word":
                        self.owner.functions.add(value.value)
                        defining = value.value
                    self.skip_blanks()
                    if self.text.startswith("()", self.i):
                        self.i += 2
                    continue
                if name == "[[":
                    # A literal $( ) or ` ` in a name that [[ evaluates (-v 'a[$(cmd)]') runs that command.
                    while True:
                        kind, value, place = self.token()
                        if kind == "eof" or kind == "word" and value.bare and value.value == "]]":
                            break
                        if kind == "word" and value.literal and ("$(" in value.value or "`" in value.value):
                            self.problem("a command substitution in a name that [[ evaluates", place)
                    expect = False
                    continue
            if (command is None or not command.words) and SHELL_ASSIGNMENT.match(word.raw):
                current(at).assignments.append(word)
                continue
            current(at).words.append(word)
            expect = False


class ShellContext:
    """What the reader of one shell text knows: the checkout `root`; the functions that the text defines, and of those
    that pass their arguments ("$@") to a command, how many arguments each shifts first (None when the check cannot
    count them) and each such command (`wrappers`); each variable's values in the assignments of the text (`values`),
    and the variables that something else sets (`unknown`: read, for, mapfile, getopts, printf -v); the variables
    that hold the script's own directory (`own`); and how a problem is placed (`locate`, a place of the text to (at,
    snippet))."""

    def __init__(self, root, shell, own, locate):
        self.root, self.functions, self.own, self.locate = root, shell.functions, own, locate
        self.values, self.unknown, self.wrappers, self.calling = {}, set(shell.loop_variables), {}, set()
        shifts, templates = {}, {}
        for command in shell.commands:
            head = command.words[0] if command.words else None
            words = list(command.assignments)
            if head is not None and head.literal and head.value in ("export", "local", "declare", "typeset",
                                                                  "readonly"):
                words += command.words[1:]
            for word in words:
                match = SHELL_ASSIGNMENT.match(word.raw)
                if match:
                    name = match[0].rstrip("=").rstrip("+").split("[", 1)[0]
                    if "[" in match[0] or match[0].endswith("+="):
                        self.unknown.add(name)
                    else:
                        self.values.setdefault(name, []).append(word.raw[match.end():])
            if head is not None and head.literal and head.value in ("read", "mapfile", "readarray", "getopts",
                                                                  "printf"):
                self.unknown |= {word.value for word in command.words[1:]
                                 if word.literal and re.fullmatch(r"[A-Za-z_]\w*", word.value)}
            if command.function and head is not None:
                if head.literal and head.value == "shift":
                    count = command.words[1].value if len(command.words) > 1 else "1"
                    if command.function in shifts and shifts[command.function] is not None and count.isdigit():
                        shifts[command.function] += int(count)
                    elif command.function not in shifts and count.isdigit():
                        shifts[command.function] = int(count)
                    else:
                        shifts[command.function] = None
                if passes_arguments(command):
                    templates.setdefault(command.function, []).append(command)
        self.wrappers = {name: (shifts.get(name, 0), found) for name, found in templates.items()}

    def starts(self, first, depth):
        """The places where the expansion `first`, the first part of a word, starts a path, each (where: "outside",
        "top", "own" or "literal"; the path to it), or None when the check cannot know them."""
        text = first.lstrip('"').rstrip('"')
        if re.match(r"\$\(\s*mktemp\b", text):
            return [("outside", "")]
        if re.fullmatch(r"\$\{\{\s*github\.workspace\s*\}\}|\$\(pwd\)", text):
            return [("top", "")]
        if SELF_DIRNAME.fullmatch(text) or SELF_CD_START.match(text) or SELF_CD.fullmatch(text):
            return [("own", "")]
        match = re.fullmatch(r"\$(?:\{(\w+)\}|(\w+))", text)
        if not match:
            return None
        name = match[1] or match[2]
        if name in OUTSIDE_VARIABLES:
            return [("outside", "")]
        if name in ("GITHUB_WORKSPACE", "PWD"):
            return [("top", "")]
        if name in self.own:
            return [("own", "")]
        if name in self.unknown or name not in self.values or depth > 8:
            return None
        found = []
        for value in self.values[name]:
            words = ShellText(value).words
            for start, path in self.path(words[0], depth + 1) if words else [("literal", "")]:
                if start is None:
                    return None
                found.append((start, path))
        return found

    def path(self, word, depth=0):
        """The paths that `word` can name, each (where it starts: "outside", "top", "own" or "literal"; the path after
        that start), or [(None, the word as written)] when the shell makes it from what the check cannot know."""
        if word.literal:
            return [("outside" if word.value.startswith(("/", "~")) else "literal", word.value)]
        first, literal = word.parts[0]
        rest = word.parts[1:]
        tail = "".join(text for text, _ in rest)
        starts = None if literal or not all(literal for _, literal in rest) or tail and not tail.startswith("/") \
            else self.starts(first, depth)
        if starts is None:
            return [(None, word.raw)]
        return [(start, f"{path}{tail}".lstrip("/") if path else tail.lstrip("/")) for start, path in starts]


def checkout_path(path):
    """`path` from the top of the checkout, without ./ and a trailing /, or None when it leaves the checkout."""
    parts = [part for part in path.split("/") if part not in ("", ".")]
    return None if ".." in parts else "/".join(parts)


def operand_reads(word, kind, program, reading, context, at):
    """Read the file `word` that `program` (an interpreter, or source) runs as `kind` ("python" or "shell"): a file of
    the checkout, named whole from the top or from the script's own directory, is run as `kind`; one outside the
    checkout, or that the job makes, is no file of it; one that the shell names from what the check cannot know is a
    problem."""
    for start, path in context.path(word):
        if start in ("literal", "top"):
            relative = checkout_path(path)
            if relative and context.root is not None and (pathlib.Path(context.root) / relative).is_file():
                reading.paths.append(relative)
                reading.runs[relative] = kind
        elif start == "own" and path and ".." not in path.split("/"):
            reading.siblings.append(path)
            reading.sibling_runs[path] = kind
        elif start != "outside":
            reading.cannot(f"{program} {word.raw}, a file that the shell names from what the check cannot know",
                           *context.locate(at))
            return


def directory_reads(word, program, reading, context, at):
    """Read a change of the working directory to `word` by `program` (cd, pushd, git -C, env -C, os.chdir, cwd=):
    into a directory of the checkout, named whole, it is a problem, as a path from the top then names another file; to
    one outside it, to the top, or to one that the job makes, it is not. After a change to a directory that the shell
    or the program makes from parts, a relative name is a path assembled from parts: the limit (LIMIT)."""
    if word is None or word.literal and word.value in ("-", "~"):
        return
    for start, path in context.path(word):
        relative = checkout_path(path) if start in ("literal", "top") else None
        if relative and context.root is not None and (pathlib.Path(context.root) / relative).is_dir():
            reading.cannot(f"{program} {word.raw}, after which a path from the top names another file",
                           *context.locate(at))
            return


def python_command(words):
    """What the words after python3 run, as (kind, Word): ("program", the -c program), ("module", the -m module),
    ("file", the file), ("stdin", None) for - or no program, ("none", None) for --version and --help, or ("problem",
    what) for an option that the check does not read."""
    index = 0
    while index < len(words):
        word = words[index]
        index += 1
        if not word.literal:
            return "file", word
        value = word.value
        if value == "-":
            return "stdin", None
        if not value.startswith("-"):
            return "file", word
        if value.startswith("--"):
            name = value.split("=", 1)[0]
            if name in PYTHON_LONG_WITH_ARGUMENT:
                index += "=" not in value
                continue
            if name in PYTHON_LONG:
                return "none", None
            return "problem", f"python3's option {value}, which the check does not read"
        flags = value[1:]
        for n, flag in enumerate(flags):
            if flag in "cm":
                kind = "program" if flag == "c" else "module"
                if flags[n + 1:]:
                    return kind, Word([(flags[n + 1:], True)], flags[n + 1:], word.start)
                if index < len(words):
                    return kind, words[index]
                return "problem", f"python3 -{flag} with no {kind}"
            if flag in PYTHON_WITH_ARGUMENT:
                index += not flags[n + 1:]
                break
            if flag not in PYTHON_FLAGS:
                return "problem", f"python3's option -{flag}, which the check does not read"
    return "stdin", None


def shell_command(words):
    """What the words after bash or sh run, as (kind, Word): ("program", the -c program), ("file", the file),
    ("stdin", None), or ("problem", what) for an option that the check does not read."""
    index = 0
    while index < len(words):
        word = words[index]
        index += 1
        if not word.literal:
            return "file", word
        value = word.value
        if value in ("-o", "+o"):
            index += 1
        elif value == "--":
            break
        elif value == "-s":
            return "stdin", None
        elif SHELL_FLAGS.fullmatch(value):
            continue
        elif re.fullmatch(r"-[eEuxvnfhBCHmPTabklpt]*c[eEuxvnfhBCHmPTabklpt]*", value):
            if index < len(words):
                return "program", words[index]
            return "problem", "a shell's -c with no program"
        elif value.startswith(("-", "+")):
            return "problem", f"a shell's option {value}, which the check does not read"
        else:
            return "file", word
    return ("file", words[index]) if index < len(words) else ("stdin", None)


def stdin_program(command, language, reading, context, read):
    """Read the program that `language` reads from its standard input: the heredoc or here-string that `command` gives
    it, which the shell must not expand. Any other standard input (a pipe, a file) is a problem."""
    if command.heredocs:
        body, literal, at = command.heredocs[0]
        if literal:
            read(body, at)
        else:
            reading.cannot(f"a heredoc for {language} that the shell expands", *context.locate(at))
    elif command.here_strings:
        word = command.here_strings[0]
        if word.literal:
            read(word.value, word.start)
        else:
            reading.cannot(f"a here-string for {language} that the shell expands", *context.locate(word.start))
    else:
        reading.cannot(f"{language} that reads its program from its standard input, which is no heredoc",
                       *context.locate(command.start))


def unwrap(words, reading, context, at):
    """The words of the command that the wrapper words[0] (WRAPPERS) runs, its own options and assignments read; an
    empty list when it runs no command (command -v), or when it is a problem."""
    name = pathlib.PurePosixPath(words[0].value).name
    takes = WRAPPERS[name]
    index = 1
    while index < len(words):
        word = words[index]
        value = word.value if word.literal else None
        if name == "env" and SHELL_ASSIGNMENT.match(word.raw):
            assignment_reads(word, reading, context, at)
            index += 1
            continue
        if value is None or not value.startswith("-") or value == "-":
            break
        index += 1
        if value == "--":
            break
        if name == "command" and value in ("-v", "-V"):
            return []
        if name == "env" and value.startswith(("-S", "--split-string")):
            reading.cannot(f"env {value}, whose command the check cannot read", *context.locate(at))
            return []
        if name == "env" and value in ("-C", "--chdir"):
            directory_reads(words[index] if index < len(words) else None, "env -C", reading, context, at)
        if value in takes:
            index += 1
    if name == "timeout" and index < len(words):
        index += 1  # The duration.
    return words[index:]


def python_path(word, reading, context, at):
    """Read the assignment PYTHONPATH=<value> `word`, which adds directories where python3 finds a module: each named
    from the top of the checkout is searched (Reading.python_paths), each outside it is no file of the checkout, and
    any other is a problem."""
    value = word.raw.split("=", 1)[1]
    for part in value.strip('"').split(":"):
        if part in ("", "$PYTHONPATH", "${PYTHONPATH}", "${PYTHONPATH:-}"):
            continue
        words = ShellText(part).words
        inner = words[0] if words else Word([(part, True)], part, at)
        for start, path in context.path(inner):
            if start == "outside":
                continue
            relative = checkout_path(path) if start in ("literal", "top") else None
            if relative is None:
                reading.cannot(f"PYTHONPATH={value}, a directory that the check cannot know", *context.locate(at))
                return
            reading.python_paths.append(relative)


def assignment_reads(word, reading, context, at):
    """Read the assignment `word` (NAME=value, before a command, in env or in export): PYTHONPATH's directories
    (python_path), and the command that a variable of PROGRAM_VARIABLES names, read as shell text; one that the shell
    makes is a problem."""
    name, _, value = word.raw.partition("=")
    if name == "PYTHONPATH":
        python_path(word, reading, context, at)
    elif name in PROGRAM_VARIABLES:
        words = ShellText(value).words
        if words and not all(part.literal for part in words):
            reading.cannot(f"{name}={value}, a command that the shell makes", *context.locate(at))
        elif words:
            inner = Reading(reading.where)
            shell_reads(" ".join(part.value for part in words), inner, context.root)
            reading.take(inner, placed=context.locate(at))


def git_problem(arguments):
    """How git with `arguments` can run a program that the check does not read, in words, or None: a setting outside
    GIT_SAFE_SETTINGS (-c, --config-env, git config), --exec-path, a subcommand of GIT_RUNS or one that the shell
    makes, or an option that names a program (GIT_PROGRAM_OPTIONS, -u of clone and ls-remote, -x of rebase)."""
    def setting(text, given):
        key, _, value = text.partition("=")
        if key.lower() == "credential.helper":
            return None if given and value == "" else key
        return None if GIT_SAFE_SETTINGS.fullmatch(key) else key

    index, subcommand = 0, None
    while index < len(arguments):
        word = arguments[index]
        value = word.value if word.literal else None
        index += 1
        if value in ("-c", "--config-env"):
            if index >= len(arguments) or not arguments[index].literal:
                return f"git {value} with a setting that the shell makes"
            if (key := setting(arguments[index].value, value == "-c")) is not None:
                return f"git {value} {key}, a setting that can run a program"
            index += 1
            continue
        if value is not None and value.startswith("--config-env="):
            if (key := setting(value.split("=", 1)[1], False)) is not None:
                return f"git --config-env {key}, a setting that can run a program"
            continue
        if value is not None and value.startswith("--exec-path"):
            return "git --exec-path, which says where git finds the programs it runs"
        if value in ("-C", "--git-dir", "--work-tree", "--namespace"):
            index += 1
            continue
        if value is not None and value.startswith("-"):
            continue
        if value is None:
            return f"git {word.raw}, a subcommand that the shell makes"
        subcommand = value
        break
    if subcommand is None:
        return None
    if subcommand in GIT_RUNS:
        return f"git {subcommand}, which runs a program"
    rest = [word.value for word in arguments[index:] if word.literal]
    if subcommand == "config" and not any(value in ("--get", "--get-all", "--get-regexp", "--list", "-l")
                                          for value in rest):
        key = next((value for value in rest if not value.startswith("-")), "")
        if setting(key, False) is not None:
            return f"git config {key}, a setting that can run a program"
    for value in rest:
        if value.startswith(GIT_PROGRAM_OPTIONS) or subcommand in ("clone", "ls-remote") and value == "-u" \
                or subcommand == "rebase" and value == "-x":
            return f"git {subcommand} {value.split('=', 1)[0]}, an option that names a program"
    return None


def program_problem(name, arguments):
    """How the command `name` (git, gh, tar, sort, dpkg, apt-get, apt) with `arguments` can run a program that the
    check does not read, in words, or None."""
    values = [word.value if word.literal else None for word in arguments]
    first = next((value for value in values if value is None or not value.startswith("-")), "")
    if name == "git":
        return git_problem(arguments)
    if name == "gh" and first is None:
        return "gh with a subcommand that the shell makes: an alias or an extension runs a program"
    if name == "gh" and first and first not in GH_SUBCOMMANDS:
        return f"gh {first}, which is no command of gh's own: an alias or an extension runs a program"
    if name == "tar" and any(value is not None and (value.startswith(TAR_RUNS) or re.match(r"-[A-Za-z]*[IF]", value))
                             for value in values):
        return "tar with an option that runs a program"
    if name == "tar" and values and values[0] is not None and re.fullmatch(r"[A-Za-z]*[IF][A-Za-z]*", values[0]):
        return "tar with an option that runs a program"
    if name == "sort" and any(value is not None and value.startswith("--compress-program") for value in values):
        return "sort --compress-program, which runs a program"
    if name == "dpkg" and next((value for value in values if value is None or value.startswith("-")),
                               None) not in DPKG_QUERIES:
        return "dpkg with an action that is no query: installing a package runs its scripts"
    if name in ("apt-get", "apt") and any(value is None or "/" in value or value.endswith(".deb")
                                          or value.startswith(("-o", "--option", "-c", "--config-file"))
                                          for value in values):
        return f"{name} with a file, a setting or an argument that the shell makes: a package's scripts or a " \
               "setting can run a program"
    return None


ALL_ARGUMENTS = ('"$@"', "$@", '"${@}"', "${@}")


def passes_arguments(command):
    """Whether `command` passes all the arguments of the function that it is in ("$@") on, as its program or not."""
    return any(word.raw in ALL_ARGUMENTS for word in command.words)


def command_reads(command, reading, context):
    """Read the simple command `command` into `reading`, in the forms of SUPPORTED: by its program's name, an
    interpreter, a wrapper, cd, git, find, source, docker, uv, a function that the text defines, a tool of TOOL_FILES
    or a command of DATA_COMMANDS, whose arguments are text that names files. A program that a variable holds is each
    program that the text assigns it. A command in a function that passes the function's arguments on ("$@") is read
    at each call of the function, with that call's arguments in their place. A program that is a file of the checkout
    runs that file; one that the job makes is no file of it. Any other program is a problem."""
    for word in command.assignments:
        assignment_reads(word, reading, context, word.start)
    if command.function in context.wrappers and passes_arguments(command):
        return  # Read at each call of the function (below).
    words = list(command.words)
    while words:
        head, at = words[0], words[0].start
        arguments = words[1:]
        candidates = context.path(head)
        if any(start is None or start in ("own", "top") and not path for start, path in candidates):
            reading.cannot(f"{head.raw}, a program that the shell names from what the check cannot know",
                           *context.locate(at))
            return
        names = []
        for start, path in candidates:
            if start == "own":
                reading.siblings.append(path)
            elif start in ("literal", "top") and "/" in path:
                relative = checkout_path(path)
                if relative and context.root is not None and (pathlib.Path(context.root) / relative).is_file():
                    reading.paths.append(relative)
            else:
                names.append(path.rsplit("/", 1)[-1])
        if not names:
            return
        if len(names) > 1 or not head.literal:
            # Each program that the head can name, with the same arguments.
            for name in dict.fromkeys(names):
                inner = Command(command.start, command.inside, command.function)
                inner.words = [Word([(name, True)], name, at), *arguments]
                inner.heredocs, inner.here_strings = command.heredocs, command.here_strings
                command_reads(inner, reading, context)
            return
        name = names[0]
        if name in WRAPPERS:
            words = unwrap(words, reading, context, at)
            if name == "xargs" and words and re.fullmatch(r"python[0-9.]*|bash|sh|dash|source|\.",
                                                          pathlib.PurePosixPath(words[0].value).name):
                reading.cannot("xargs that runs an interpreter on what it reads", *context.locate(at))
                return
            continue
        if name in context.wrappers:
            # A function that passes its arguments on, after it shifts some of them: each of its commands that does,
            # with this call's arguments in the place of "$@".
            shifts, templates = context.wrappers[name]
            if shifts is None:
                reading.cannot(f"{name}, a function that passes its arguments on after shifts that the check cannot "
                               "count", *context.locate(at))
                return
            if name in context.calling:
                return  # A function that calls itself: its commands are read at the first call.
            context.calling.add(name)
            for template in templates:
                inner = Command(at, command.inside, None)
                inner.words = [part for word in template.words
                               for part in (arguments[shifts:] if word.raw in ALL_ARGUMENTS else [word])]
                # The function's standard input is the call's, unless the command takes its own.
                own_input = template.heredocs or template.here_strings or any(op == "<" for op, _ in template.redirects)
                inner.heredocs = template.heredocs if own_input else command.heredocs
                inner.here_strings = template.here_strings if own_input else command.here_strings
                command_reads(inner, reading, context)
            context.calling.discard(name)
            return
        if name == "docker":
            subcommand = next((word.value for word in arguments if word.literal and not word.value.startswith("-")),
                              None)
            if subcommand not in DOCKER_SUBCOMMANDS:
                reading.cannot(f"docker {subcommand}, which runs code that the check does not read",
                               *context.locate(at))
            return
        if name == "uv":
            subcommand = next((word.value for word in arguments if word.literal and not word.value.startswith("-")),
                              None)
            if subcommand in ("run", "tool") or subcommand is None:
                reading.cannot(f"uv {subcommand}, which runs a command that the check does not read",
                               *context.locate(at))
            return
        if name in PACKAGE_COMMANDS:
            # The package's own command runs the package, as python3 -m does.
            reading.imported.append((PACKAGE_COMMANDS[name], 0))
            reading.python_paths.append("src")
            return
        if name == "trap":
            # trap ACTION SIGNAL...: ACTION is shell text that runs later.
            action = next((word for word in arguments if not (word.literal and word.value.startswith("-"))), None)
            if action is not None and not (action.literal and action.value in ("", "-")):
                if not action.literal:
                    reading.cannot("trap with a command that the shell makes", *context.locate(at))
                else:
                    inner = Reading(reading.where)
                    shell_reads(action.value, inner, context.root)
                    reading.take(inner, placed=context.locate(at))
            return
        if name == "flock":
            # flock [options] FILE|FD [-c COMMAND | COMMAND ARGS...]: what follows the lock is a command.
            index = 0
            while index < len(arguments) and arguments[index].literal and arguments[index].value.startswith("-"):
                value = arguments[index].value
                if value not in FLOCK_FLAGS and value not in FLOCK_WITH_ARGUMENT \
                        and not value.startswith(tuple(f"{option}=" for option in FLOCK_WITH_ARGUMENT
                                                       if option.startswith("--"))):
                    # A cluster (-nw 1) or any other form: the check cannot tell the lock from an option's value.
                    reading.cannot(f"flock {value}, an option that the check does not read", *context.locate(at))
                    return
                index += 1 + (value in FLOCK_WITH_ARGUMENT)
            rest = arguments[index + 1:]
            if rest and rest[0].literal and rest[0].value in ("-c", "--command"):
                if len(rest) > 1 and rest[1].literal:
                    inner = Reading(reading.where)
                    shell_reads(rest[1].value, inner, context.root)
                    reading.take(inner, placed=context.locate(at))
                else:
                    reading.cannot("flock -c with a command that the shell makes", *context.locate(at))
                return
            words = rest
            continue
        if name in ("mapfile", "readarray") and any(word.literal and word.value.startswith("-C")
                                                     for word in arguments):
            reading.cannot(f"{name} -C, which runs a command", *context.locate(at))
            return
        if name == "hash" and any(word.literal and word.value.startswith("-p") for word in arguments):
            reading.cannot("hash -p, which names the program that a command runs", *context.locate(at))
            return
        if name in EVALUATED_NAMES and any(word.literal and ("$(" in word.value or "`" in word.value)
                                           for word in arguments):
            # bash evaluates a name or an arithmetic expression here: a $( ) in a[$( )] runs.
            reading.cannot(f"{name} with a command substitution in a name that bash evaluates", *context.locate(at))
            return
        if name in context.functions or name in DATA_COMMANDS or name in TOOL_FILES:
            if (problem := program_problem(name, arguments)) is not None and name not in context.functions:
                reading.cannot(problem, *context.locate(at))
                return
            if name in ("export", "local", "declare", "readonly", "typeset"):
                for word in arguments:
                    if SHELL_ASSIGNMENT.match(word.raw):
                        assignment_reads(word, reading, context, at)
            if name == "git":
                for n, word in enumerate(arguments[:-1]):
                    if word.literal and word.value in ("-C", "--git-dir", "--work-tree"):
                        directory_reads(arguments[n + 1], f"git {word.value}", reading, context, at)
            if name == "find":
                for n, word in enumerate(arguments):
                    if word.literal and word.value in ("-exec", "-execdir", "-ok", "-okdir"):
                        end = next((m for m in range(n + 1, len(arguments)) if arguments[m].value in (";", "+")),
                                   len(arguments))
                        inner = Command(at, command.inside, command.function)
                        inner.words = arguments[n + 1:end]
                        command_reads(inner, reading, context)
            if name in ("awk", "gawk", "mawk") and any(AWK_RUNS.search(word.value) for word in arguments):
                reading.cannot(f"{name} with a program that runs a command", *context.locate(at))
            if name == "sed" and any(SED_RUNS.search(word.value) for word in arguments):
                reading.cannot("sed with a program that runs a command (e)", *context.locate(at))
            return
        if name in ("cd", "pushd"):
            targets = [word for word in arguments if not (word.literal and word.value in ("-L", "-P", "--"))]
            # $(cd ... && pwd) runs nothing in the directory: it only names it.
            if not SELF_CD_SUBSTITUTION.fullmatch(command.inside or ""):
                directory_reads(targets[0] if targets else None, name, reading, context, at)
            return
        if name in ("source", "."):
            if arguments:
                operand_reads(arguments[0], "shell", name, reading, context, at)
            else:
                reading.cannot(f"{name} with no file", *context.locate(at))
            return
        if re.fullmatch(r"python[0-9.]*", name):
            kind, value = python_command(arguments)
            where = context.locate(at)
            if kind == "problem":
                reading.cannot(value, *where)
            elif kind == "module":
                if value.literal:
                    reading.imported.append((value.value, 0))
                else:
                    reading.cannot(f"python3 -m {value.raw}, a module that the shell names", *where)
            elif kind == "program":
                if value.literal:
                    python_reads(value.value, reading, *where, root=context.root)
                else:
                    reading.cannot("python3 -c with a program that the shell expands", *where)
            elif kind == "file":
                operand_reads(value, "python", name, reading, context, at)
            elif kind == "stdin":
                stdin_program(command, "python3", reading, context,
                              lambda body, place: python_reads(body, reading, *context.locate(place),
                                                               root=context.root))
            return
        if name in ("bash", "sh", "dash"):
            kind, value = shell_command(arguments)

            def read_program(program, place):
                inner = Reading(reading.where)
                shell_reads(program, inner, context.root)
                reading.take(inner, placed=context.locate(place))

            if kind == "problem":
                reading.cannot(value, *context.locate(at))
            elif kind == "program":
                if value.literal:
                    read_program(value.value, at)
                else:
                    reading.cannot(f"{name} -c with a program that the shell expands", *context.locate(at))
            elif kind == "file":
                operand_reads(value, "shell", name, reading, context, at)
            else:
                stdin_program(command, name, reading, context, read_program)
            return
        if name == "eval":
            reading.cannot("eval, which runs text that the check cannot read", *context.locate(at))
            return
        reading.cannot(f"{name}, a command that the check does not know", *context.locate(at))
        return


def shell_reads(text, reading, root=None):
    """Read the shell text `text` into `reading` (a Reading): its code, comments blanked, as code that names files;
    each word, as a path that it may name whole; each simple command, in the forms of SUPPORTED (command_reads); the
    siblings that it names as $(dirname "$0")/<name>; and each construct outside SUPPORTED, or that the parse cannot
    read, as a problem. `root` is the checkout, for the files and directories that the text names."""
    code = "\n".join(" " * len(line) if line.lstrip().startswith("#") else line for line in text.split("\n"))
    reading.code.append(code)

    def locate(position):
        """(at, snippet) for a problem at `position`: the place itself when `text` is the text of the file, else the
        line that holds it, which cannot finds in that file."""
        if reading.text == text:
            return position, None
        line_start = text.rfind("\n", 0, position) + 1
        line_end = text.find("\n", position)
        return None, text[line_start:len(text) if line_end < 0 else line_end]

    shell = ShellText(text)
    for what, at in shell.problems:
        reading.cannot(f"shell text that the check cannot parse ({what})", *locate(at))

    # The script's own directory, in its supported forms, and the siblings that they name. Each substitution keeps
    # the length of what it replaces, so that each place keeps its line.
    def keep_length(replacement):
        return lambda match: " " * max(0, len(match[0]) - len(replacement)) + replacement

    expanded = without_quotes(code)
    self_text = SELF_CD.sub(keep_length(HERE), SELF_DIRNAME.sub(keep_length(HERE), expanded))
    own = {match[1] for match in SELF_ASSIGN.finditer(self_text)}
    for variable in own:
        self_text = SELF_ASSIGN.sub(lambda match: " " * len(match[0]) if match[1] == variable else match[0],
                                    self_text)
        self_text = re.sub(r"\$\{?" + re.escape(variable) + r"\}?(?!\w)", keep_length(HERE), self_text)
    for match in SELF_USE.finditer(self_text):
        if ".." in match[1].split("/"):
            reading.cannot(f"a path above the script's own directory ({match[1]})", *locate(match.start()))
        else:
            reading.siblings.append(match[1])
    for match in SELF_LEFT.finditer(SELF_USE.sub(lambda match: " " * len(match[0]), self_text)):
        reading.cannot("the script's own path ($0, BASH_SOURCE) other than as $(dirname \"$0\")/<name>",
                       *locate(match.start()))
    context = ShellContext(root, shell, own, locate)
    # Each word that names a path whole, its quotes removed, as a path that the text names: also one with a space in
    # it, which the scan of the code splits; also the path after an option's = or curl's @.
    for word in shell.words:
        for start, path in context.path(word):
            if start not in ("literal", "top"):
                continue
            for candidate in {path, path.split("=", 1)[-1], path[1:] if path.startswith("@") else path}:
                relative = checkout_path(candidate) if "\n" not in candidate and len(candidate) < 1024 else None
                if relative:
                    reading.paths.append(relative)
    for command in shell.commands:
        command_reads(command, reading, context)


def without_quotes(text):
    """`text` with what the shell does not expand blanked, each character but a newline made a space, so that each
    place keeps its line: each string in single quotes outside double quotes, each heredoc's body, and each comment (a
    # at the start of a word, to the end of its line). A backslash keeps the next character."""
    out, i, double = list(text), 0, False

    def blank(start, end):
        for n in range(start, min(end, len(text))):
            if out[n] != "\n":
                out[n] = " "

    while i < len(text):
        char = text[i]
        if char == "\\":
            i += 2
            continue
        if double:
            double = char != '"'
            i += 1
            continue
        if char == '"':
            double = True
        elif char == "'":
            end = text.find("'", i + 1)
            end = len(text) - 1 if end < 0 else end
            blank(i, end + 1)
            i = end + 1
            continue
        elif char == "#" and (i == 0 or text[i - 1] in " \t\n;&|("):
            end = text.find("\n", i)
            end = len(text) if end < 0 else end
            blank(i, end)
            i = end
            continue
        elif text.startswith("<<", i) and (marker := HEREDOC_MARKER.match(text, i)):
            line_end = text.find("\n", i)
            if line_end >= 0:
                lines = text[line_end + 1:].split("\n")
                stop = next((n for n, line in enumerate(lines)
                             if (line.lstrip("\t") if marker[1] else line) == marker[3]), None)
                if stop is not None:
                    length = sum(len(line) + 1 for line in lines[:stop])
                    blank(line_end + 1, line_end + 1 + length)
                    i = line_end + 1 + length
                    continue
        i += 1
    return "".join(out)


def module_files(root, tops, base, name, level, reading):
    """The files of the checkout `root` that an import of the module `name` can run, as Python finds them. An absolute
    import (level 0) is looked up in each directory of `tops` (each that can come first on sys.path, and PYTHONPATH's),
    and the files found in each are counted, which may count more than Python runs but never fewer; a relative one in
    the package `level` - 1 directories above `base`. In one directory a package (a directory with __init__.py) comes
    before a module (<part>.py). The files are the __init__.py of each package on the way, and the module's own file.
    A part that no directory holds as a package or a module but one holds as a namespace package (a directory without
    __init__.py, which Python joins from every directory of the search path) is a problem of `reading`."""
    root = pathlib.Path(root)
    parts = [part for part in name.split(".") if part]
    found = set()

    def resolve(directories, parts):
        part, rest = parts[0], parts[1:]
        packages = [directory / part for directory in directories if (root / directory / part / "__init__.py").is_file()]
        modules = [directory / f"{part}.py" for directory in directories
                   if not (root / directory / part / "__init__.py").is_file()
                   and (root / directory / f"{part}.py").is_file()]
        if not packages and not modules:
            namespace = [directory / part for directory in directories if (root / directory / part).is_dir()]
            if namespace:
                reading.cannot(f"an import of {name}, whose {part} is a namespace package (no __init__.py: "
                               f"{', '.join(path.as_posix() for path in namespace)})")
            return
        found.update((package / "__init__.py").as_posix() for package in packages)
        found.update(module.as_posix() for module in modules)
        if rest and packages:
            resolve(packages, rest)

    if parts:
        starts = list(dict.fromkeys(tops)) if level == 0 else [base.parents[level - 2] if level > 1 else base]
        resolve(starts, parts)
    return found


def named(root, reading, script=None):
    """The files of the checkout `root` that `reading` (a Reading) names: a path from the top, in its code or whole
    (Reading.paths), a local action's metadata, the files of each module that it imports (module_files), and for the
    script `script`, each sibling that it names, which it runs as Reading.sibling_runs says. A citation of a document
    names it without reading it."""
    root = pathlib.Path(root)
    code = "\n".join(reading.code)
    for citation in CITATIONS:
        code = citation.sub("", code)
    found = set()
    for token in [*PATH_TOKEN.findall(code), *reading.paths]:
        token = token.rstrip(".") if token not in reading.paths else token
        while token.startswith("./"):
            token = token[2:]
        # .git is git's own: a file in a linked worktree, a directory in a clone.
        if not token or ".." in token.split("/") or token.split("/")[0] == ".git" or "\0" in token:
            continue
        try:
            if os.path.islink(root / token) or (root / token).is_file():
                found.add(token)
            elif (root / token).is_dir():
                found |= {f"{token}/{name}" for name in ("action.yml", "action.yaml")
                          if (root / token / name).is_file()}
        except OSError:
            continue
    base = pathlib.PurePosixPath(script).parent if script else pathlib.PurePosixPath(SCRIPTS)
    if script:
        for name in reading.siblings:
            if os.path.islink(root / base / name) or (root / base / name).is_file():
                found.add((base / name).as_posix())
                if name in reading.sibling_runs:
                    reading.runs[(base / name).as_posix()] = reading.sibling_runs[name]
    # Where python3 looks a module up: the script's own directory, or for a program of a job the top of the checkout,
    # its working directory; .github/scripts/, which the scripts put first on sys.path; and PYTHONPATH's.
    tops = [base if script else pathlib.PurePosixPath("."), pathlib.PurePosixPath(SCRIPTS),
            *(pathlib.PurePosixPath(path) for path in reading.python_paths)]
    for name, level in reading.imported:
        if level == 0 or script and level <= len(base.parts):
            found |= module_files(root, tops, base, name, level, reading)
    return found


def job_reads(job, where, text=None, root=None, python_paths=()):
    """What a job, or the runs of a local action, reads, as a Reading: its if, env, with and uses as code that names
    files, the PYTHONPATH of its env and of each step's, and each step's run read as its shell reads it (shell_reads,
    or python_reads for shell: python), its if, uses, with and env. A working-directory: is read as a cd
    (directory_reads), and a shell that the check does not read is a problem. `text` is the text of the file that
    holds it, which places a problem on its line; `root` is the checkout; `python_paths` are the directories of the
    workflow's PYTHONPATH."""
    def values(value):
        if isinstance(value, dict):
            return [v for item in value.values() for v in values(item)]
        if isinstance(value, list):
            return [v for item in value for v in values(item)]
        return [] if value is None else [str(value)]

    reading = Reading(where, text)
    reading.python_paths += list(python_paths)

    def settings(holder, snippet):
        """Read the PYTHONPATH of `holder`'s env, and its working-directory:."""
        context = ShellContext(root, ShellText(""), set(), lambda at: (None, snippet))
        env = holder.get("env")
        if isinstance(env, dict) and env.get("PYTHONPATH") is not None:
            value = str(env["PYTHONPATH"])
            python_path(Word([(f"PYTHONPATH={value}", "$" not in value)], f"PYTHONPATH={value}", 0), reading,
                        context, None)
        for name in sorted(PROGRAM_VARIABLES & set(env)) if isinstance(env, dict) else ():
            # A program that the step's commands run: read as an assignment of the shell is.
            value = "" if env[name] is None else str(env[name])
            literal = not re.search(r"\$|`", value)
            word = Word([(f"{name}={value}", literal)], f"{name}={shlex.quote(value)}" if literal else
                        f"{name}={value}", 0)
            assignment_reads(word, reading, ShellContext(root, ShellText(""), set(),
                                                         lambda at, name=name: (None, f"{name}:")), None)
        directory = holder.get("working-directory")
        if directory is not None:
            value = str(directory)
            word = (ShellText(value).words or [Word([(value, True)], value, 0)])[0]
            directory_reads(word, "working-directory:", reading,
                            ShellContext(root, ShellText(""), set(),
                                         lambda at: (None, f"working-directory: {value}")), None)

    reading.code += values([job.get(key) for key in ("if", "env", "with", "uses")])
    settings(job, "PYTHONPATH")
    default = ((job.get("defaults") or {}).get("run") or {}) if isinstance(job.get("defaults"), dict) else {}
    if isinstance(default, dict):
        settings(default, "working-directory:")
    steps = job.get("steps")
    for step in steps if isinstance(steps, list) else []:
        if not isinstance(step, dict):
            continue
        reading.code += values([step.get(key) for key in ("if", "uses", "with", "env")])
        settings(step, "PYTHONPATH")
        if "run" not in step:
            continue
        run = str(step["run"])
        shell = str(step.get("shell") or (default.get("shell") if isinstance(default, dict) else None) or "bash")
        inner = Reading(where, text)
        if re.fullmatch(r"(?:bash|sh)(?:\s.*\{0\})?", shell, re.S):
            shell_reads(run, inner, root)
        elif re.fullmatch(r"python[0-9.]*(?:\s.*\{0\})?", shell, re.S):
            python_reads(run, inner, snippet=run.split("\n", 1)[0], root=root)
        else:
            inner.cannot(f"shell: {shell}, which the check does not read", snippet=f"shell: {shell}")
        reading.take(inner)
    return reading


def interpreter_of(text):
    """How a script runs, from its first line: "python", "shell", or the interpreter that a #! names otherwise."""
    first = text.split("\n", 1)[0]
    if not first.startswith("#!"):
        return "shell"
    words = first[2:].split()
    if words and pathlib.PurePosixPath(words[0]).name == "env":
        words = [word for word in words[1:] if not word.startswith("-") and "=" not in word]
    name = pathlib.PurePosixPath(words[0]).name if words else ""
    if re.fullmatch(r"python[0-9.]*", name):
        return "python"
    return "shell" if name in ("bash", "sh", "dash") else name or "a #! with no interpreter"


def script_names(root, path, text, reading, kind=None):
    """The files that the file `path` of the checkout `root`, whose text is `text`, names as code, read into `reading`
    (its code, imports and problems). A workflow file names nothing here (followed reads its jobs). A local action
    names what its steps and its main, pre, post and image name; one that runs no composite steps is a problem. A file
    that an interpreter runs is code of the `kind` that it runs ("python" or "shell"); else a file under
    .github/scripts/, a .py file or one that starts with #! is code: Python when its name ends in .py or its #! names
    python, shell when it names bash or sh or none; any other interpreter is a problem. Any other file is data and
    names nothing."""
    pure = pathlib.PurePosixPath(path)
    if WORKFLOW_FILE.fullmatch(path):
        return set()
    if pure.name in ("action.yml", "action.yaml") and kind is None:
        action = parse(text, path).get("runs")
        action = action if isinstance(action, dict) else {}
        steps_shape(action, f"{path}, its runs")
        directory = pure.parent.as_posix()
        # ${{ github.action_path }} is the action's own directory, which GitHub writes in before the shell reads.
        action_path = re.compile(r"\$\{\{\s*github\.action_path\s*\}\}")
        steps = action.get("steps")
        if isinstance(steps, list):
            action = {**action, "steps": [{**step, "run": action_path.sub(directory, str(step["run"]))}
                                          if isinstance(step, dict) and "run" in step else step for step in steps]}
        inner = job_reads(action, path, text, root)
        if action.get("using") != "composite":
            inner.cannot(f"runs: using: {action.get('using')}, which runs code that the check does not read",
                         snippet="using:")
        inner.code = [re.sub(r"\$\{\{\s*github\.action_path\s*\}\}", directory, code) for code in inner.code]
        found = named(root, inner)
        for key in ("main", "pre", "post", "image"):
            if isinstance(action.get(key), str):
                found.add(f"{directory}/{action[key]}")
        reading.take(inner)
        return found
    if kind is None and not (path.startswith(f"{SCRIPTS}/") or pure.suffix == ".py" or text.startswith("#!")):
        return set()
    inner = Reading(path, text)
    # The PYTHONPATH of the jobs that run it (each env: of the workflow, the job and the step): where its imports are
    # found too.
    inner.python_paths = list(reading.python_paths)
    kind = kind or ("python" if pure.suffix == ".py" else interpreter_of(text))
    if kind == "python":
        python_reads(text, inner, root=root)
    elif kind == "shell":
        shell_reads(text, inner, root)
    else:
        inner.cannot(f"#! {kind}, an interpreter that the check does not read", at=0)
    found = named(root, inner, script=path)
    reading.take(inner)
    return found


def link_in(root, path):
    """The first symbolic link on the way to `path` from the top of the checkout `root` (a directory or the file
    itself), as (the link, where it points), or None."""
    current = pathlib.Path(root)
    for part in pathlib.PurePosixPath(path).parts:
        current = current / part
        if current.is_symlink():
            return current.relative_to(root).as_posix(), os.readlink(current)
    return None


def followed(root, start, within=""):
    """What the workflow `start` of the checkout `root` runs or reads, as (the files; the workflows that NOT_FOLLOWED
    takes out for `start` and that it names; the problems: each construct outside SUPPORTED; the code read, for
    TOOL_FILES). The files are `start`, each workflow that it calls at every level, each file that their jobs name
    (job_reads, named), and each file that those name in turn (script_names), of those whose path starts with
    `within`; a file outside it is left out. A workflow that one of them names is a run whose checks, artifact or
    completion it acts on, so what its jobs name is followed too, but for the workflows of NOT_FOLLOWED; for one of the
    four (REQUIRED_CHECKS), as for the four themselves, only what is under .github/: what a test in tests/ or the
    package in src/ runs is the pull request's choice, which an owner here would not change. A symbolic link on the
    way to a file is a problem, and the file is not read."""
    root = pathlib.Path(root)
    reading = Reading(start)
    workflows, pending = {}, [start]
    while pending:
        current = pending.pop()
        if current in workflows:
            continue
        workflows[current] = load(root, current)
        for job in jobs(workflows[current]).values():
            called = LOCAL_WORKFLOW.fullmatch(str(job.get("uses", "")))
            if called and (root / called[1]).is_file():
                pending.append(called[1])
    files, skipped, done, todo = set(), set(), {}, [(path, within) for path in workflows]

    def read_jobs(path, workflow, scope):
        text = read_as_text(root, path)
        scope = ".github/" if path in REQUIRED_CHECKS else scope
        top = job_reads(workflow, path, text, root)
        for job in [workflow, *jobs(workflow).values()]:
            inner = top if job is workflow else job_reads(job, path, text, root, top.python_paths)
            todo.extend((file, scope) for file in named(root, inner))
            reading.take(inner)

    for path, workflow in workflows.items():
        read_jobs(path, workflow, within)
    while todo:
        current, scope = todo.pop()
        # How an interpreter runs it, if one does: a file read before as something else is read again.
        kind = reading.runs.get(current)
        if current in done and done[current] == kind or current in skipped or not current.startswith(scope):
            continue
        if (start, current) in NOT_FOLLOWED:
            skipped.add(current)
            continue
        done[current] = kind
        files.add(current)
        if (link := link_in(root, current)) is not None:
            reading.problems.append(f"{link[0]}: a symbolic link (to {link[1]}), on the way to {current}: {CANNOT}")
            continue
        text = read_as_text(root, current)
        if WORKFLOW_FILE.fullmatch(current):
            if current not in workflows:
                read_jobs(current, workflow_of(text, current), scope)
            continue
        todo.extend((file, scope) for file in script_names(root, current, text, reading, kind))
        todo.extend((file, scope) for file, how in reading.runs.items() if file in done and done[file] != how)
    return files, skipped, list(dict.fromkeys(reading.problems)), "\n".join(reading.code)


def github_files(root):
    """Each file under .github/ of the checkout `root` that git tracks, or would add as it is not ignored, from the top
    of the checkout, sorted: a tracked file counts wherever it is, and what python3 writes in a __pycache__ directory,
    which .gitignore ignores, does not. A symbolic link is a file, as git keeps it. Unreadable when `root` is not the
    top of a git work tree, or git cannot list it: the check must not pass on a list that it could not read."""
    top = pathlib.Path(root).resolve()
    env = {key: value for key, value in os.environ.items() if key not in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")}

    def git(subcommand, call):
        """The output of git's `subcommand`, which `call` runs (each with a literal list, which this check reads)."""
        try:
            run = call()
        except OSError as error:
            raise Unreadable(f"{root}: git cannot run ({error}), so the check cannot list the files under .github/") \
                from None
        if run.returncode:
            said = " ".join(run.stderr.split()) or f"exit status {run.returncode}"
            raise Unreadable(f"{root}: git {subcommand} failed ({said}), so the check cannot list the files under "
                             ".github/")
        return run.stdout

    toplevel = git("rev-parse", lambda: subprocess.run(["git", "-C", str(top), "rev-parse", "--show-toplevel"],
                                                       capture_output=True, text=True, env=env)).strip()
    if pathlib.Path(toplevel).resolve() != top:
        raise Unreadable(f"{root}: not the top of a git work tree (git's top is {toplevel}), so the check cannot list "
                         "the files under .github/")
    listed = git("ls-files", lambda: subprocess.run(
        ["git", "-C", str(top), "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", ".github/"],
        capture_output=True, text=True, env=env)).split("\0")
    return sorted({path for path in listed if path and os.path.lexists(top / path)})


def inventory(root, names):
    """R10's inventory of the checkout `root`, whose workflow files are `names`, as ({path: [(class, why)]}, each class
    of CLASSES that holds the file, in that order; {class: why it is empty}; the problems: of REQUIRED_CHECKS, of
    NOT_FOLLOWED, and each construct outside SUPPORTED in what the four and the workflows with a credential run). Each
    file is under .github/ but for what a workflow with a credential reads, which is wherever it is."""
    root = pathlib.Path(root)
    found, empty, problems = {}, {}, []

    def add(path, kind, why):
        reasons = found.setdefault(path, [])
        if kind not in {k for k, _ in reasons}:
            reasons.append((kind, why))

    add(CODEOWNERS, CLASSES[0], "it says who owns each file")
    if (root / DEPENDABOT).is_file():
        add(DEPENDABOT, CLASSES[1], "its registries can send Dependabot's secrets to any host")
    else:
        empty[CLASSES[1]] = f"{DEPENDABOT} is absent"
    holding = {}
    for name in names:
        path = f"{WORKFLOWS}/{name}"
        workflow = load(root, path)
        for job_name, job in jobs(workflow).items():
            what = ", ".join(holds(root, workflow, job, (path,)))
            if what:
                holding.setdefault(path, f"the job {job_name} holds {what}")
    for path, why in holding.items():
        add(path, CLASSES[2], why)
    if not holding:
        empty[CLASSES[2]] = f"no job of the {len(names)} workflow files holds a credential"
    four, called_four, reached, codes = [], set(), {}, {}
    for path, check in REQUIRED_CHECKS.items():
        if not (root / path).is_file():
            problems.append(f"{path}: no such file, but it is the workflow of the required check {check} (R10), so "
                            "the check cannot read what decides that check")
            continue
        four.append(path)
        add(path, CLASSES[3], f"it is the workflow of the required check {check}")
        for job_name, job in jobs(load(root, path)).items():
            for called, via in calls(root, job):
                via = f" through {', '.join(via)}" if via else ""
                called_four.add(called)
                add(called, CLASSES[4], f"the job {job_name} of {path}, the workflow of the required check {check}, "
                                        f"calls it{via}")
        # Only what files under .github/ run or read: what a file elsewhere runs (a test in tests/, the package in src/,
        # neither of which has an owner) is that file's choice, which an owner here would not change.
        files, _, unresolved, codes[path] = followed(root, path, ".github/")
        problems += unresolved
        for file in files:
            reached.setdefault(file, set()).add(pathlib.PurePosixPath(path).name)
    if four and not called_four:
        empty[CLASSES[4]] = f"no job of {', '.join(four)} calls a workflow of this repository"
    runs = {path: by for path, by in reached.items()
            if path.startswith(".github/") and path not in REQUIRED_CHECKS and path not in called_four}
    for path, by in sorted(runs.items()):
        add(path, CLASSES[5], f"{', '.join(sorted(by))}, the workflow of a required check, runs or reads it")
    if four and not runs:
        empty[CLASSES[5]] = f"no job of {', '.join(four)} names a file under .github/"
    # A workflow with a credential: a job of it holds one, itself or in a workflow that it calls (holds).
    readers, skipped = {}, set()
    for path in holding:
        files, passed, unresolved, codes[path] = followed(root, path)
        problems += unresolved
        skipped |= {(path, file) for file in passed}
        for file in files - {path}:
            readers.setdefault(file, set()).add(pathlib.PurePosixPath(path).name)
    for path, by in sorted(readers.items()):
        add(path, CLASSES[7], f"{', '.join(sorted(by))}, which hold a credential, run or read it")
    if not readers:
        empty[CLASSES[7]] = ("no workflow with a credential names a file" if holding
                             else "no workflow holds a credential")
    # The files that a tool reads from its place, where the tool's name is a word of what one of those runs.
    ran = {tool: sorted(pathlib.PurePosixPath(path).name for path, code in codes.items()
                        if re.search(rf"(?<![\w.-]){re.escape(tool)}(?![\w-])", code))
           for tool in TOOL_FILES}
    for tool, by in ran.items():
        for path in TOOL_FILES[tool] if by else ():
            if os.path.lexists(root / path):
                add(path, CLASSES[6], f"{', '.join(by)} {'runs' if len(by) == 1 else 'run'} {tool}, which reads it "
                                      f"from its place, and it can change what {tool} finds")
                if (link := link_in(root, path)) is not None:
                    problems.append(f"{link[0]}: a symbolic link (to {link[1]}), which {tool} reads: {CANNOT}")
    if not any(kind == CLASSES[6] for reasons in found.values() for kind, _ in reasons):
        empty[CLASSES[6]] = "; ".join(
            f"{', '.join(by)} runs {tool}, but none of {', '.join(TOOL_FILES[tool])} is here" if by
            else f"no job of these workflows runs {tool}" for tool, by in ran.items())
    for reader, file in NOT_FOLLOWED:
        if (reader, file) not in skipped:
            problems.append(f"{file}: NOT_FOLLOWED of .github/scripts/workflow-credentials takes it out of what "
                            f"{reader} reads, but {reader} holds no credential or does not name it")
    return found, empty, list(dict.fromkeys(problems))


def owners(codeowners, path):
    """The owners that the text of CODEOWNERS gives `path`, and the pattern that gives them: the last pattern that
    matches it decides. A field that starts with # starts a comment."""
    found, pattern = [], None
    for line in codeowners.splitlines():
        fields = line.split()
        if fields and not fields[0].startswith("#") and steering.matches(fields[0], path):
            rest = fields[1:]
            found = rest[:next((i for i, field in enumerate(rest) if field.startswith("#")), len(rest))]
            pattern = fields[0]
    return found, pattern


def owner_problems(codeowners, found, files):
    """Each file of the inventory `found` that the text of CODEOWNERS does not give to both TEAMS, and each other file
    of `files` (those under .github/) that it gives an owner, as a problem. When none of `files` is left without an
    owner, that is a problem too: the check would show no file that R10 leaves without one."""
    problems = []
    for path, reasons in sorted(found.items()):
        given, _ = owners(codeowners, path)
        if not set(TEAMS) <= set(given):
            whom = "no owner" if not given else f"only {' '.join(given)}, not {' and '.join(TEAMS)}"
            problems.append(f"{path}: {reasons[0][1]}, but {CODEOWNERS} gives {path} {whom}")
    others = [path for path in files if path not in found]
    for path in others:
        given, pattern = owners(codeowners, path)
        if given:
            problems.append(f"{path}: {CODEOWNERS} gives it {' '.join(given)} (the pattern {pattern}), but it is no "
                            "file of R10's inventory, so it has no code owner")
    if not files:
        problems.append(".github/ holds no file that the check could read, so it shows no file without an owner")
    elif not [path for path in others if not owners(codeowners, path)[0]]:
        problems.append(f"no file under .github/ but those of the inventory is without a code owner ({len(files)} "
                        f"files there, {len(files) - len(others)} of the inventory), so the check shows no file that "
                        "R10 leaves without one")
    return problems


def pull_request_holds(root, name):
    """Each way the workflow .github/workflows/<name> of the checkout `root` breaks (r), as "<file>, <where>: <why>" or
    "<file>: <why>"; none when it starts neither on pull_request nor on pull_request_target. A job that calls a
    workflow of this repository (uses: ./.github/workflows/<file>) runs that file's jobs in its own run, with its own
    permissions at most: they are held to the same, and run only on push when the calling job does."""
    root = pathlib.Path(root)
    top = f"{WORKFLOWS}/{name}"
    problems = []

    def check(path, push_only, chain):
        text = text_of(root, path)
        workflow = parse(text, path)
        file = pathlib.PurePosixPath(path).name
        if reads_secret(workflow):
            problems.append(f"{file}: it reads a secret")
        holders = [("the workflow", workflow, push_only)] + [
            (f"the job {n}", job, push_only or condition(job) == PUSH_ONLY) for n, job in jobs(workflow).items()]
        for where, holder, push in holders:
            if holder is not workflow:
                if "environment" in holder:
                    problems.append(f"{file}, {where}: it has an environment")
                if "secrets" in holder:
                    problems.append(f"{file}, {where}: it passes secrets to {holder.get('uses')}")
                if "uses" in holder:
                    called = LOCAL_WORKFLOW.fullmatch(str(holder["uses"]))
                    if not called or not (root / called[1]).is_file():
                        problems.append(f"{file}, {where}: it calls {holder['uses']}, a workflow of no file here")
                    elif called[1] not in chain:
                        check(called[1], push, (*chain, called[1]))
            permissions = holder.get("permissions")
            if permissions is None:
                # A job with no permissions of its own takes its workflow's, which the workflow that starts on
                # pull_request must give. A called workflow's jobs take the calling job's.
                if holder is workflow and path == top:
                    problems.append(f"{file}, {where}: no permissions are given")
                continue
            if isinstance(permissions, str):
                # write-all grants id-token: write too, which even a push-only job must not hold.
                if permissions == "write-all":
                    problems.append(f"{file}, {where}: it has id-token: write")
                if permissions != "read-all":
                    problems.append(f"{file}, {where}: permissions {permissions}, but "
                                    + (PUSH_WRITES if push else f"its if is not {PUSH_ONLY}"))
                continue
            if not isinstance(permissions, dict):
                problems.append(f"{file}, {where}: permissions {permissions!r}, which GitHub does not read")
                continue
            if "id-token" in permissions:
                problems.append(f"{file}, {where}: it has id-token: {permissions['id-token']}")
            for scope, level in permissions.items():
                if level in ("read", "none"):
                    continue
                if holder is workflow:
                    why = "the workflow's permissions reach every job"
                elif not push:
                    why = f"its if is not {PUSH_ONLY}"
                elif (scope, level) != ("security-events", "write"):
                    why = PUSH_WRITES
                else:
                    continue
                problems.append(f"{file}, {where}: {scope}: {level}, but {why}")

    on = triggers(load(root, top))
    if "pull_request_target" in on:
        problems.append(f"{name}: it starts on pull_request_target")
    if "pull_request" in on:
        check(top, False, (top,))
    return problems


# The steps of github/codeql-action: init starts an analysis, analyze extracts and analyses. GitHub reads the owner and
# the repository of a uses: in any case, so these do too. An expression that names an input of the workflow.
CODEQL_INIT = re.compile(r"\s*github/codeql-action/init@", re.IGNORECASE)
CODEQL_STEP = re.compile(r"\s*github/codeql-action/", re.IGNORECASE)
INPUT = re.compile(r"\$\{\{\s*inputs\.([\w-]+)\s*\}\}")
# The languages whose CodeQL extractor reads source alone and runs none of it, in any build mode.
SOURCE_ONLY = ("actions", "javascript", "javascript-typescript", "typescript", "ruby")
# The compiled languages whose CodeQL extractor, in build mode none, reads source without a build and runs none of it:
# C and C++ alone. Another build mode (autobuild, manual) runs the project's build. C#'s extractor in build mode none
# runs dotnet restore on the repository's projects (github/codeql csharp/extractor/Semmle.Extraction.CSharp.
# DependencyFetching/NugetPackageRestorer.cs and DotNet.cs at e54be546741e764e42f1fe396b0a4816e28c327f), whose MSBuild
# targets can run code; Java's and Kotlin's read build files that can run code to resolve dependencies.
BUILDLESS = ("c", "cpp", "c-cpp")
# Python's extractor probes its interpreter with python -S -c "import gzip" in the checkout (github/codeql
# python/extractor/buildtools/index.py at the same commit, site_flag), and python -c puts the working directory first
# on sys.path: an entry at the top named for gzip, or for a module that gzip imports, would run. PYTHONSAFEPATH would
# keep it off sys.path, but then the extractor cannot import its own tracer. So Python reads source alone only in a job
# whose steps are: actions/checkout alone; then the step PYTHON_GUARD, its run exactly GUARD_RUN, which fails when an
# entry at the top of the checkout is named for a module of the standard library, with nothing that skips it, lets it
# fail or moves it (if, continue-on-error, working-directory, shell, a job's or a workflow's defaults); then CodeQL's
# steps alone, none with an if, so that nothing changes the top between the guard and the extraction and nothing runs
# CodeQL after a failed guard. Its CodeQL steps get no PYTHONPATH, which could name the checkout, and no step writes
# $GITHUB_ENV. Every other language counts as running code of the packages it reads: Rust's extractor loads each Cargo
# package with rust-analyzer, which runs cargo check, and with it each build script, and runs proc macros through the
# sysroot's proc-macro server (rust/extractor/src/config.rs at the same commit, lines 164 and 235:
# load_out_dirs_from_check: true), in any build mode; Go builds; and a language that this check does not know, or
# cannot read, counts too.
PYTHON_GUARD = "No entry at the top of the checkout is named for a module of Python's standard library"
GUARD_RUN = """python3 -I -c '
import os, sys
names = set(sys.stdlib_module_names)
found = sorted(entry for entry in os.listdir(".") if entry.split(".")[0] in names)
for entry in found:
    print("::error::" + entry + ": an entry at the top of the checkout named for the standard-library module "
          + entry.split(".")[0] + ", which CodeQL" + chr(39) + "s Python extractor could import from here")
sys.exit(1 if found else 0)
'
"""
CHECKOUT = re.compile(r"\s*actions/checkout@", re.IGNORECASE)
# How a problem says that python can import from the checkout.
PYTHON_UNSAFE = (" with the top of the checkout importable (no checkout, PYTHON_GUARD as written and CodeQL's steps "
                 "alone, in that order, a PYTHONPATH or a write of $GITHUB_ENV)")


def guards_python(workflow, job, steps):
    """Whether `steps` of `job` of `workflow` are actions/checkout alone, then PYTHON_GUARD as GUARD_RUN with no key
    but name and run, then github/codeql-action steps alone with no if, and neither the job nor the workflow sets
    defaults."""
    if workflow.get("defaults") is not None or job.get("defaults") is not None:
        return False
    at = next((index for index, step in enumerate(steps) if step.get("name") == PYTHON_GUARD), None)
    if at is None or set(steps[at]) != {"name", "run"} or steps[at]["run"] != GUARD_RUN:
        return False
    before, after = steps[:at], steps[at + 1:]
    return (all(CHECKOUT.match(str(step.get("uses", ""))) and "run" not in step for step in before)
            and bool(after) and all(CODEQL_STEP.match(str(step.get("uses", ""))) and "if" not in step
                                    and "run" not in step for step in after))


def runs_package_code(language, mode, safe_path):
    """Whether CodeQL's analysis of `language` in the build mode `mode` (None: not given, so CodeQL's default), in a
    job that runs PYTHON_GUARD before init and gives its CodeQL steps no PYTHONPATH when `safe_path`, can run code of
    the packages it reads."""
    if language in SOURCE_ONLY:
        return False
    if language == "python":
        return not safe_path
    return not (language in BUILDLESS and mode == "none")


def environment(workflow, job, step=None):
    """The env that `step` of `job` of `workflow` gets: the workflow's, then the job's, then the step's."""
    found = {}
    for env in (workflow.get("env"), job.get("env"), (step or {}).get("env")):
        if isinstance(env, dict):
            found.update({str(key): value for key, value in env.items()})
    return found


def analyses(root, workflow, job, given=None, through=()):
    """Each CodeQL analysis that `job` of `workflow` runs, at every level of calls, as (language, build mode,
    guard before init, where): from each step github/codeql-action/init, its languages and build-mode. A value
    ${{ inputs.<name> }} takes the input that the calling job gives (`given`, its with:, already resolved in the
    caller); any other expression, or a value that the check cannot resolve, is None. Languages are read as CodeQL
    reads them: lowercase, split at commas and blanks, empty ones dropped; none left, or none given, means that CodeQL
    finds them, so None. A call of a workflow that the check cannot read (of another repository, or of no file here)
    is one analysis of None: the check must not pass what it could not read."""
    def resolve(value):
        if value is None:
            return None
        match = INPUT.fullmatch(str(value).strip())
        if match:
            value = None if given is None else given.get(match[1])
            if value is None:
                return None
        return None if "${{" in str(value) else str(value)

    found = []
    steps = [step for step in job.get("steps") or [] if isinstance(step, dict)]
    codeql = [environment(workflow, job, step) for step in steps if CODEQL_STEP.match(str(step.get("uses", "")))]
    safe_path = (guards_python(workflow, job, steps) and all(env.get("PYTHONPATH") is None for env in codeql)
                 and not any("GITHUB_ENV" in str(step.get("run", "")) for step in steps))
    for step in job.get("steps") or []:
        if isinstance(step, dict) and CODEQL_INIT.match(str(step.get("uses", ""))):
            inputs = step.get("with") or {}
            languages = resolve(inputs.get("languages"))
            mode = resolve(inputs.get("build-mode"))
            mode = mode.strip().lower() if mode else None
            names = [part for part in re.split(r"[\s,]+", languages.lower()) if part] if languages else []
            found += [(language, mode, safe_path, "") for language in names or [None]]
    uses = job.get("uses")
    if uses is None:
        return found
    called = LOCAL_WORKFLOW.fullmatch(str(uses))
    if not called or not (pathlib.Path(root) / called[1]).is_file():
        return found + [(None, None, False, f" in {uses}, which this check cannot read")]
    if called[1] in through:
        return found
    inner = load(root, called[1])
    passed = {str(key): resolve(value) for key, value in (job.get("with") or {}).items()}
    for name, inner_job in jobs(inner).items():
        found += [(language, mode, safe, f" in the job {name} of {called[1]}{where}")
                  for language, mode, safe, where in analyses(root, inner, inner_job, passed, (*through, called[1]))]
    return found


def package_code_problems(root, names):
    """Each job of the workflows `names` that holds a credential (holds) and runs a CodeQL analysis that can run code of
    the packages it reads (runs_package_code), as a problem: that code comes from files that need no code owner, and it
    would run with the credential."""
    problems = []
    for name in names:
        path = f"{WORKFLOWS}/{name}"
        workflow = load(root, path)
        if set(triggers(workflow)) == {"workflow_call"}:
            # Its jobs run only when a job calls it: they are read there, with the inputs that job gives.
            continue
        for job_name, job in jobs(workflow).items():
            what = ", ".join(holds(root, workflow, job, (path,)))
            if not what:
                continue
            for language, mode, safe_path, where in analyses(root, workflow, job, through=(path,)):
                if runs_package_code(language, mode, safe_path):
                    without = PYTHON_UNSAFE if language == "python" else ""
                    problems.append(
                        f"{path}: the job {job_name} holds {what} and runs CodeQL's analysis of "
                        f"{language or 'languages this check cannot read'} in build mode {mode or 'not given'}"
                        f"{without}{where}, which can run code of the packages it reads (build scripts, proc macros, "
                        "a build or the checkout's modules), from files that need no code owner")
    return problems


def check(root):
    """The check of the checkout `root`: it prints what it found, each problem as a line ::error::<problem>, and
    returns the exit status."""
    names = workflow_files(root)
    if not names:
        print(f"::error::{root / WORKFLOWS} holds no workflow file (*.yml, *.yaml): nothing was checked.")
        return 1
    try:
        codeowners = text_of(root, CODEOWNERS)
        found, empty, problems = inventory(root, names)
        files = github_files(root)
        problems = owner_problems(codeowners, found, files) + problems
        starts = 0
        for name in names:
            starts += "pull_request" in triggers(load(root, f"{WORKFLOWS}/{name}"))
            problems += pull_request_holds(root, name)
        problems += package_code_problems(root, names)
    except Unreadable as error:
        print(f"::error::{error}")
        return 1
    except (AttributeError, KeyError, TypeError, ValueError, IndexError) as error:
        # A value of a shape that the check does not read, which GitHub would most likely refuse too: no traceback, and
        # no pass.
        print(f"::error::the check stopped on a value of a workflow that it cannot read ({type(error).__name__}: "
              f"{error}); fix that value, or teach .github/scripts/workflow-credentials to read it")
        return 1
    for problem in problems:
        print(f"::error::{problem}")
    if problems:
        return 1
    owned = [path for path in files if owners(codeowners, path)[0]]
    unowned = [path for path in files if not owners(codeowners, path)[0]]
    print(f"Read {len(names)} workflow files and the {len(files)} files under .github/.")
    print(f"R10's inventory, by class: {CODEOWNERS} gives each of its {len(found)} files to {' and '.join(TEAMS)}.")
    for kind in CLASSES:
        members = sorted(path for path, reasons in found.items() if kind in {k for k, _ in reasons})
        print(f"  {kind} ({len(members)}): {', '.join(members)}" if members else
              f"  {kind}: none, as {empty[kind]}; so no file of this class is shown owned")
    print(f"Under .github/, the {len(owned)} files with a code owner, each a file of the inventory: {', '.join(owned)}")
    print(f"Under .github/, the {len(unowned)} files with no code owner: {', '.join(unowned)}")
    for (reader, file), why in NOT_FOLLOWED.items():
        print(f"Not followed: {file}, which {reader} names: {why}.")
    print(f"Starting on pull_request: {starts}, and none breaks (r). No job with a credential runs a CodeQL analysis "
          "that can run code of the packages it reads.")
    return 0


def main(argv):
    """Run check on the checkout argv[1], the current directory by default, and then print LIMIT, whatever it found."""
    try:
        return check(pathlib.Path(argv[1] if len(argv) > 1 else "."))
    finally:
        print(LIMIT)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
