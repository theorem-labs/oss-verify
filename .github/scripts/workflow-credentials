# command (case, for, select, function and [[ have rules of their own).
SHELL_PREFIXES = frozenset({"if", "then", "elif", "else", "do", "while", "until", "{", "!", "time"})
SHELL_CLOSERS = frozenset({"fi", "done", "}"})
SHELL_ASSIGNMENT = re.compile(r"[A-Za-z_]\w*(?:\[[^\]]*\])?\+?=")
SHELL_PARAMETER = re.compile(r"\$(?:[A-Za-z_]\w*|[0-9@*#?$!-])")
