# A program that runs the command after its own options and assignments, with the options of it that take a value.
WRAPPERS = {
    "env": {"-u", "--unset", "-C", "--chdir"}, "exec": {"-a"}, "command": set(), "nohup": set(), "time": {"-f", "-o"},
