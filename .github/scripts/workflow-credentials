# The script's own directory, in shell: $(dirname "$0"), $(dirname -- "${BASH_SOURCE[0]}"), and either inside
# $(cd -- ... && pwd). Exact, as the check refuses every symbolic link.
HERE = "\0here\0"
SELF_DIRNAME = re.compile(r"\$\(\s*dirname\s+(?:--\s+)?\"?\$(?:0|\{0\}|\{BASH_SOURCE\[0\]\}|\{BASH_SOURCE\}|"
                          r"BASH_SOURCE)\"?\s*\)")
SELF_CD = re.compile(r"\$\(\s*cd\s+(?:--\s+)?\"?\s*" + re.escape(HERE) + r"\"?\s*&&\s*pwd\s*\)")
SELF_ASSIGN = re.compile(r"(?<![\w$])(\w+)=(\"?)[ \t]*" + re.escape(HERE) + r"\2(?=[ \t;\n]|$)")
SELF_USE = re.compile(re.escape(HERE) + r"/((?:[\w.-]+/)*[\w.-]+)")
SELF_LEFT = re.compile(r"\$(?:0(?!\w)|\{0\}|\{?BASH_SOURCE)|" + re.escape(HERE))
# The script's own directory at the start of a word as written, and the command substitution $(cd -- ... && pwd),
# which only names a directory: the cd in it runs nothing there.
SELF_CD_START = re.compile(r"\$\(\s*cd\s+(?:--\s+)?\"?\s*\$\(\s*dirname\b")
SELF_CD_SUBSTITUTION = re.compile(r"\s*cd\s+(?:--\s+)?(?:\"[^\"]*\"|\S+)\s*&&\s*pwd(?:\s+-[LP])?\s*")
# An awk program that runs a command (system(), a pipe to or from a command), and a sed program with the e command
# or the e flag of s.
AWK_RUNS = re.compile(r"\bsystem\s*\(|\|\s*getline|\|&|print[^;\n}]*\|\s*\"")
SED_RUNS = re.compile(r"(?:^|[;\n{}])\s*e\b|^s(.).*\1.*\1[gpIiMm0-9]*e[gpIiMm0-9]*\s*$", re.M)
# The calls of Python that run a command: the check reads subprocess's run, call, check_call, check_output and Popen
# with a literal list or string, and os.system and os.popen with a literal string; any other is a problem.
PYTHON_RUNNERS = {
    "subprocess": {"run", "call", "check_call", "check_output", "Popen", "getoutput", "getstatusoutput"},
    "os": {"system", "popen", "execv", "execve", "execvp", "execvpe", "execl", "execle", "execlp", "execlpe",
           "spawnv", "spawnve", "spawnvp", "spawnvpe", "spawnl", "spawnle", "spawnlp", "spawnlpe", "posix_spawn",
