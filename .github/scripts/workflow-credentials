#!/usr/bin/env python3
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
"""Check the code owners and the credentials of this repository's workflows:

    python3 -I .github/scripts/workflow-credentials [<checkout>]

<checkout> is the top of a checkout, the current directory by default, and of a git work tree. The script reads
.github/CODEOWNERS, each file .github/workflows/*.yml and *.yaml and the files that their jobs and scripts name, all as
data, and runs no code of them; it lists the files under .github/ with git ls-files (the files that git tracks there,
and those that it would add, as they are not ignored). It prints each problem as a line ::error::<problem> and exits
1. Else it prints what it read: R10's inventory by class, the files under .github/ with a code owner and those with
none; and exits 0. Last, on every run, it prints the limit of what it sees (LIMIT). With no workflow file to read, or
no list of files from git, it fails: a check that read nothing has not passed. A value that GitHub would refuse where
the check reads it (steps that are no list, say) fails with ::error::, not a traceback. tests/test_token_jobs.py
checks the other side of a credential: that no job that holds one, or whose outputs such a job reads, loads code from
src/, which has no owner.

The owners: a code owner only where a change can reach a credential or decide a required check (R10,
dispatch://INFRA-5359/spec#b-r10). .github/CODEOWNERS must give each file of R10's inventory to
@theorem-labs/engineering and @theorem-labs/research, and no owner to any other file under .github/: the last pattern
that matches a file decides (steering.matches). The inventory, by class (CLASSES): .github/CODEOWNERS; dependabot.yml,
whose registries can send Dependabot's secrets to any host; each workflow with a job that holds a credential (below);
the workflows of the four required checks (REQUIRED_CHECKS), each workflow that they call at every level, and each file
under .github/ that they run or read; each file that a tool reads from its place (TOOL_FILES), where the tool runs in
a job of these workflows; and each file, anywhere, that a workflow with a credential runs or reads. What a workflow
runs or reads is what followed finds: each file whose path the text of its jobs names, or the text of a script that
names in turn, read in the forms of SUPPORTED; and each workflow that it names, a run whose checks, artifact or
completion it acts on, with what that workflow's jobs name, but for NOT_FOLLOWED. From the four, and from a run of one
of them that a workflow with a credential acts on, only what is under .github/ is followed: what a test in tests/ or
the package in src/ runs is the pull request's choice, which an owner here could not hold. An empty class says why it
is empty, and no file of it is shown owned; .github/ with no file left without an owner fails, as the check would show
nothing of R10's other half. This holds while main's ruleset requires the four checks from the oss-verify App
(integration 5447700), which posts them from main's copy of .github/workflows/required-checks.yml
(theorem-labs/agent-infra#7010): a job of a workflow with no owner cannot report a required check under its name.

Why this is enough: a change to an owned file needs a person's review, so the check need not foresee what owned code
may read later. It shows that the jobs of these workflows, as they are, read only owned files, and it fails, rather
than passes, on a way of running or reading a file that it does not recognise: a form passes only when it is one of
SUPPORTED, not when no refusal matches it.

SUPPORTED, what the check reads in the text of these jobs and of the scripts that they run; any other form fails with
"cannot resolve what this reads", the file and its line:
  - shell text parsed as bash parses it (ShellText): quotes, escapes, $( ), ` `, <( ), heredocs, case, for, [[ ]],
    functions; each simple command is read by its program's name (command_reads), and a program that is not one of
    these fails: an interpreter (below); a wrapper (WRAPPERS: env, exec, timeout, sudo, xargs, ...), whose command is
    read in turn; cd, pushd, git -C, env -C, working-directory:, os.chdir and cwd=, which may not name a directory of
    the checkout; source or . of a file; find -exec, whose command is read in turn; docker with DOCKER_SUBCOMMANDS
    alone; uv but run and tool; the package's own command (PACKAGE_COMMANDS), read as python3 -m of its module; a
    tool of TOOL_FILES; a command of DATA_COMMANDS, whose arguments are text that names files (an awk program that
    runs a command and sed's e fail); a function of the same text; a file of the checkout, or a sibling of the script;
  - a path whole: a literal word (quotes removed), a string of a Python program, or a word that starts at a place the
    check knows: the top ($GITHUB_WORKSPACE, ${{ github.workspace }}, $(pwd)), the script's own directory
    ($(dirname "$0"), $(dirname "${BASH_SOURCE[0]}"), $(cd -- ... && pwd)), outside the checkout ($(mktemp),
    $RUNNER_TEMP, $HOME, ~), or a variable that every assignment of the text gives such a value (each value counts);
    a variable that read, for, mapfile, getopts or printf -v sets is not known;
  - a function that passes its arguments on ("$@"): each such command of it is read at each call, with the call's
    arguments, after the function's shifts, in the place of "$@";
  - python3 (python, python3.12, or a path that ends in it) with only the options -b -B -d -E -h -i -I -O -P -q -R
    -s -S -u -v -V -x, -W <arg>, -X <arg>, --check-hash-based-pycs <arg>, and then a file, -m <module>, or a -c
    program, a heredoc or a here-string that the shell does not expand; bash or sh likewise, with their own options;
  - a script by its #!: bash, sh, dash or python (a .py file is Python), or as the interpreter that runs it;
  - a Python import that resolves to a regular package (a directory with __init__.py) or a module, looked up in the
    script's own directory (or the top, for a program of a job), .github/scripts/ and PYTHONPATH's directories, a
    package before a module; not a namespace package. sys.path changes only by sys.path.insert(0, the script's own
    directory). No exec, eval, compile, __import__, importlib.import_module, runpy or spec_from_file_location;
    SourceFileLoader only of a sibling named as Path(__file__)...with_name("<name>"). subprocess's run, call,
    check_call, check_output and Popen with a literal list or string, and os.system and os.popen with a literal
    string, are read as the command that they run; any other call of PYTHON_RUNNERS fails;
  - uses: ./<local action>, its runs: using: composite and its steps; uses: ./.github/workflows/<file>; a step's
    shell: bash, sh or python;
  - no symbolic link on the way to any file that the check follows.
A path that a job or a script assembles from parts (a variable joined with a name, a loop, a glob), and a relative
name after a change to a directory that the shell makes from parts, are the limit (LIMIT): the check does not see
them, and the code owner's review of the owned file that assembles them is what covers them. A program or a file that
an interpreter runs, named from the top but no file of the checkout, is one that the job makes, and no file of it.

A job holds a credential when it, or the env and the permissions of its workflow that it takes, reads a secret, or
when it has a secrets: key, an environment, a permission that writes (id-token: write is one) or a permissions text
other than read-all. A job with no permissions, in a workflow with none that starts on an event of its own (not only
on workflow_call), holds the token's default permissions, which the settings of the repository decide. A read of a
secret is a reference to the secrets context in an expression: in a ${{ }} of any key or value of the job (a step's
with: and env:, a call's with:), or in an if:, which GitHub reads as an expression with or without ${{ }}. An
expression ends at the first }} outside a string in single quotes, as GitHub reads it, or at the end of the value.
GitHub reads a context's name in any case, so Secrets and SECRETS count, in any form (secrets.X, secrets['X'],
toJSON(secrets), format('{0}', secrets.X)); a name after a dot (inputs.secrets) is a property, not the context. The text
of a run: outside ${{ }} is the shell's, and is not read. A job that calls a workflow (uses:) runs that workflow's jobs
in its own run: it holds what they hold, at every level of calls (a called job's environment gives that job the
environment's secrets). A job that calls a workflow of another repository holds what this script cannot read, and
counts as holding a credential. A job that can save in main's Actions cache holds one too: review.yml restores entries
of that cache for a review, and trusts that only its own session job saved them. A job of a workflow that starts on an
event other than pull_request can, unless its cache-mode (its own, else its workflow's) is none or read. So a workflow
that gains a credential is a file of the inventory, and fails while it has no owner.

The reading. GitHub reads a workflow as YAML 1.2, and PyYAML reads YAML 1.1, so where the two could differ the script
refuses the file: an explicit tag (!!set, !!str, !custom), which can make PyYAML drop or change a value; the merge key
<<; a key that is no plain scalar; and a key repeated in any case, of which PyYAML keeps only the last. Each other key
is the text it is written in: PyYAML would read on, yes and true all as the boolean true, so one job could hide
another.

(r), for each workflow. No workflow starts on pull_request_target. A workflow that starts on pull_request reads no
secret and gives its permissions, and its jobs have no environment, no secrets: key and no id-token. Its
workflow-level permissions write nothing: they reach every job. A job of it that writes has the if
github.event_name == 'push', so that no run on pull_request holds the permission, and it writes security-events alone
(CodeQL's push jobs, which record main's results). Any other write needs a workflow that does not start on
pull_request. A job that calls a workflow of this repository runs that file's jobs in its own run, with its own
permissions at most: they are held to the same, and run only on push when the calling job does.

The analyses. No job that holds a credential runs a CodeQL analysis that can run code of the packages it reads. Only
GitHub Actions, JavaScript, TypeScript and Ruby (SOURCE_ONLY) in any build mode, C and C++ (BUILDLESS) in build mode
none, and Python in a job that runs PYTHON_GUARD before init, with no PYTHONPATH and no write of $GITHUB_ENV, pass:
Rust's extractor runs cargo check, build scripts and proc macros in any build mode; C#'s runs dotnet restore;
autobuild and manual run the project's build; Python's extractor imports from the top of the checkout; and a
language that the check does not know or cannot read fails. Such code comes from files that need no code owner, and
would run with the credential. The script reads the languages and build-mode of each step github/codeql-action/init,
at every level of calls, with ${{ inputs.<name> }} taken from the calling job's with:, resolved in its caller first,
and the languages lowercase, split at commas and blanks; an expression it cannot resolve, and a call of a workflow it
cannot read, fail.

tests.yaml's job suite runs this on the commit of each run: for a pull request, GitHub's merge of it. So a pull request
that leaves a file of the inventory with no owner, gives an owner to another file under .github/, breaks (r), or
analyses such a language in a job with a credential fails the required check tests. .github/CODEOWNERS owns this
script, steering.py, tests.yaml and itself, so a change to the rule needs a person. tests/test_trigger_move.py
(PullRequestWorkflows) and tests/test_check_checks.py (Owners, WorkflowCredentials) test it.
"""
from __future__ import annotations

import ast
import functools
import json
import os
import pathlib
import re
import shlex
import subprocess
import sys

import yaml

# steering.py's match of a pattern of CODEOWNERS with a path, as GitHub matches them.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import steering  # noqa: E402

WORKFLOWS = ".github/workflows"
CODEOWNERS = ".github/CODEOWNERS"
TEAMS = ("@theorem-labs/engineering", "@theorem-labs/research")
# PyYAML's C parser when it is built, else its Python one.
LOADER = getattr(yaml, "CSafeLoader", yaml.SafeLoader)
# A reference to the secrets context in the text of an expression: the name in any case, not after a dot, a letter, a
# digit, _ or -, and not before one of them (secrets.X, Secrets['X'], toJSON(SECRETS)).
SECRET = re.compile(r"(?<![\w.\-])secrets(?![\w\-])", re.IGNORECASE)
# Where an expression starts in a key or a value; it ends at the first }} outside a string (expression_texts).
EXPRESSION_START = "${{"
# A job that calls a workflow of this repository.
LOCAL_WORKFLOW = re.compile(r"\./(\.github/workflows/[^/@]+\.ya?ml)")
# The if of a job that runs only on push. In a workflow that starts on pull_request, a job with a write permission has
# exactly this if, and the permission is security-events: write alone ((r) above).
PUSH_ONLY = "github.event_name == 'push'"
PUSH_WRITES = "a push job may write only security-events"


class Unreadable(Exception):
    """A workflow file that cannot be read, that is no YAML mapping, or that the script refuses to read (the top of this
    file)."""


class Refused(yaml.YAMLError):
    """YAML that GitHub (YAML 1.2) and PyYAML (YAML 1.1) could read differently."""


def construct_mapping(loader, node):
    """A mapping keyed on the text of each key as written. A key that is no plain scalar, the merge key <<, and a key
    repeated in any case are Refused."""
    if not isinstance(node, yaml.MappingNode):
        raise Refused(f"line {node.start_mark.line + 1}: a mapping that is no mapping")
    mapping, seen = {}, {}
    for key_node, value_node in node.value:
        line = key_node.start_mark.line + 1
        # The C parser gives a plain scalar the style '', the Python one None.
        if not isinstance(key_node, yaml.ScalarNode) or key_node.style not in (None, ""):
            raise Refused(f"line {line}: a key that is no plain scalar")
        key = key_node.value
        if key == "<<":
            raise Refused(f"line {line}: the merge key <<")
        if key.casefold() in seen:
            raise Refused(f"line {line}: the key {key!r} repeats the key {seen[key.casefold()]!r}")
        seen[key.casefold()] = key
        mapping[key] = loader.construct_object(value_node, deep=True)
    return mapping


class WorkflowLoader(LOADER):
    """LOADER, with each mapping read by construct_mapping."""


WorkflowLoader.add_constructor("tag:yaml.org,2002:map", construct_mapping)


def workflow_files(root):
    """The names of the workflow files of the checkout `root`, sorted: GitHub runs each file of .github/workflows with
    one of these suffixes, and no file of a directory under it."""
    directory = pathlib.Path(root) / WORKFLOWS
    if not directory.is_dir():
        return []
    return sorted(path.name for path in directory.iterdir() if path.is_file() and path.suffix in (".yml", ".yaml"))


def text_of(root, path):
    """The text of the file `path`, from the top of the checkout `root`."""
    try:
        return (pathlib.Path(root) / path).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        raise Unreadable(f"{path}: it cannot be read: {error}") from None


@functools.lru_cache(maxsize=None)
def parse(text, path):
    """The workflow `text` of the file `path`, parsed with WorkflowLoader: a mapping, else Unreadable. A file with an
    explicit tag, a merge key, a key that is no plain scalar or a key repeated in any case is Unreadable. Each text is
    parsed once in a process; no caller changes what it gets."""
    try:
        for token in yaml.scan(text, Loader=LOADER):
            if isinstance(token, yaml.TagToken):
                raise Refused(f"line {token.start_mark.line + 1}: an explicit tag")
        workflow = yaml.load(text, Loader=WorkflowLoader)
    except Refused as error:
        raise Unreadable(f"{path}: {error}, which GitHub and this check could read differently") from None
    except yaml.YAMLError as error:
        raise Unreadable(f"{path}: it is no YAML: {error}") from None
    if not isinstance(workflow, dict):
        raise Unreadable(f"{path}: it is no YAML mapping")
    return workflow


def steps_shape(holder, where):
    """Refuse, as Unreadable, steps of `holder` (a job, or the runs of a local action) that are no list of mappings,
    and a with: of it or of a step that is no mapping: GitHub refuses such a workflow, and the check reads these keys.
    `where` names the holder."""
    steps = holder.get("steps")
    if steps is not None and not (isinstance(steps, list) and all(isinstance(step, dict) for step in steps)):
        raise Unreadable(f"{where}: its steps are {steps!r:.60}, no list of mappings, which GitHub refuses")
    for at, item in [("", holder), *((f", step {n + 1}", step) for n, step in enumerate(steps or []))]:
        if item.get("with") is not None and not isinstance(item["with"], dict):
            raise Unreadable(f"{where}{at}: its with: is {item['with']!r:.60}, no mapping, which GitHub refuses")


def workflow_of(text, path):
    """The workflow `text` of the file `path`, parsed (parse), with its jobs read as GitHub reads them: jobs a mapping
    of mappings, each with its steps a list of mappings (steps_shape), else Unreadable."""
    workflow = parse(text, path)
    found = workflow.get("jobs")
    if found is not None and not isinstance(found, dict):
        raise Unreadable(f"{path}: its jobs are {found!r:.60}, no mapping, which GitHub refuses")
    for name, job in (found or {}).items():
        if not isinstance(job, dict):
            raise Unreadable(f"{path}: the job {name} is {job!r:.60}, no mapping, which GitHub refuses")
        steps_shape(job, f"{path}, the job {name}")
    return workflow


def load(root, path):
    """The workflow `path` of the checkout `root`, parsed (workflow_of)."""
    return workflow_of(text_of(root, path), path)


def jobs(workflow):
    """The jobs of a workflow, by id: each a mapping."""
    found = workflow.get("jobs")
    return {name: job for name, job in found.items() if isinstance(job, dict)} if isinstance(found, dict) else {}


def triggers(workflow):
    """The events of a workflow's on, as a dict."""
    on = workflow.get("on")
    if isinstance(on, str):
        return {on: None}
    if isinstance(on, list):
        return dict.fromkeys(on)
    return dict(on) if isinstance(on, dict) else {}


def condition(job):
    """A job's if, without ${{ }}, with each run of spaces as one space."""
    text = str(job.get("if", "")).strip()
    inner = re.fullmatch(r"\$\{\{(.*)\}\}", text, re.S)
    return " ".join((inner[1] if inner else text).split())


def expression_texts(text):
    """The text of each expression in a value, as GitHub reads it: from each ${{ to the first }} outside a string in
    single quotes (a quote in a string is written twice, which toggles twice), or to the end of the value when no }}
    ends it."""
    found, start = [], 0
    while (at := text.find(EXPRESSION_START, start)) >= 0:
        end, quoted = at + len(EXPRESSION_START), False
        while end < len(text) and (quoted or not text.startswith("}}", end)):
            quoted ^= text[end] == "'"
            end += 1
        found.append(text[at + len(EXPRESSION_START):end])
        start = end + 2
    return found


def expressions(value, key=None):
    """The text of each expression in a parsed YAML value: each ${{ }} of each key and each value, and each value of an
    if: whole, which GitHub reads as an expression with or without ${{ }}."""
    if isinstance(value, dict):
        return [text for name, item in value.items() for text in expressions(name) + expressions(item, name)]
    if isinstance(value, list):
        return [text for item in value for text in expressions(item)]
    if value is None:
        return []
    found = expression_texts(str(value))
    if key == "if":
        found.append(str(value))
    return found


def reads_secret(value):
    """Whether an expression in a parsed YAML value refers to the secrets context."""
    return any(SECRET.search(text) for text in expressions(value))


def held(workflow, job):
    """The credentials that `job` of `workflow` holds itself (the owners, above), each in words; none when it holds
    none. What a workflow that it calls holds is not counted here (holds)."""
    found = []
    if "environment" in job:
        environment = job["environment"]
        found.append(f"an environment ({environment.get('name') if isinstance(environment, dict) else environment})")
    if "secrets" in job:
        found.append("a secrets: key")
    if reads_secret([workflow.get("env"), job]):
        found.append("a read of a secret")
    permissions = job.get("permissions", workflow.get("permissions"))
    if permissions is None:
        if set(triggers(workflow)) - {"workflow_call"}:
            found.append("the token's default permissions (no permissions are given)")
    elif isinstance(permissions, dict):
        found += [f"{scope}: {level}" for scope, level in permissions.items() if level == "write"]
    elif permissions != "read-all":
        found.append(f"permissions {permissions}")
    uses = job.get("uses")
    if uses is not None and not LOCAL_WORKFLOW.fullmatch(str(uses)):
        found.append(f"a call of {uses}, a workflow of another repository, whose jobs this check cannot read")
    # main's Actions cache: review.yml restores entries of it for a review and trusts that only its session job saved
    # them. A run on pull_request saves only in the pull request's scope; a run on any other event can save in main's,
    # unless its cache-mode is none or read. A job that calls a workflow runs no step itself: its called jobs count.
    mode = job.get("cache-mode", workflow.get("cache-mode"))
    if uses is None and mode not in ("none", "read") and set(triggers(workflow)) - {"pull_request"}:
        found.append(f"write access to main's Actions cache (cache-mode: {mode or 'not given'})")
    return found


def holds(root, workflow, job, through=()):
    """What `job` of `workflow` holds (held), with what each job of the workflow of this repository that it calls
    holds, at every level, each in words. `through` holds the workflows on the way, which are not followed again."""
    found = held(workflow, job)
    called = LOCAL_WORKFLOW.fullmatch(str(job.get("uses", "")))
    if called and called[1] not in through and (pathlib.Path(root) / called[1]).is_file():
        inner = load(root, called[1])
        for name, inner_job in jobs(inner).items():
            found += [f"{what} in the job {name} of {called[1]}"
                      for what in holds(root, inner, inner_job, (*through, called[1]))]
    return found


def calls(root, job, through=()):
    """Each workflow of this repository that `job` calls, at every level, as (its path, the paths of the called
    workflows on the way to it). A workflow on the way is not followed again."""
    called = LOCAL_WORKFLOW.fullmatch(str(job.get("uses", "")))
    if not called or called[1] in through:
        return []
    path = called[1]
    found = [(path, through)]
    if (pathlib.Path(root) / path).is_file():
        for inner in jobs(load(root, path)).values():
            found += calls(root, inner, (*through, path))
    return found


# R10 of dispatch://INFRA-5359/spec: the four workflows whose checks main's ruleset requires, each with its check.
REQUIRED_CHECKS = {
    f"{WORKFLOWS}/tests.yaml": "tests",
    f"{WORKFLOWS}/validate.yaml": "enrollment",
    f"{WORKFLOWS}/build.yaml": "project-builds",
    f"{WORKFLOWS}/terms.yaml": "terms-accepted",
}
DEPENDABOT = ".github/dependabot.yml"
# A workflow that a workflow with a credential names, but whose run it does not act on as code, keyed by (the workflow
# with the credential, the workflow it names), each with why: neither that file nor what its jobs run or read is a file
# that the credential reads. Any other workflow that such a workflow names (a run whose checks, artifact or completion
# it acts on) is followed, and it and what its jobs run or read are read with the credential. An entry that its
# workflow does not name, or that names a workflow with no credential, is a problem.
NOT_FOLLOWED = {
    (f"{WORKFLOWS}/toolchain-images-publish.yaml", f"{WORKFLOWS}/toolchain-images.yaml"): (
        "publish names it in its if, and acts only on a push run of it on main that passed: publish makes each image "
        "again itself from infra/toolchains.tsv (owned), pushes it only when its digest is the one that make made, "
        "and no toolchain uses it until a row of that file names it"),
}
# The classes of R10's inventory, in the order in which the check prints them and gives a file's first reason.
CLASSES = (
    "CODEOWNERS",
    "dependabot.yml",
    "a workflow that holds a credential",
    "a required-check workflow",
    "a workflow that a required-check workflow calls",
    "a script or file under .github/ that a required-check workflow runs or reads",
    "a file that a tool reads from its place, which a job of these workflows runs",
    "a script or file that a workflow with a credential runs or reads",
)
# A tool that reads a file of its own from a fixed place, which no job names: each with those files. The file is in the
# inventory when the tool runs in a job that the inventory follows, however it is started (its name as a word of the
# job's text, or of a script that the job runs). actionlint reads .github/actionlint.yaml or .yml, whose ignore: can
# quiet a finding that would fail a check; shellcheck, which actionlint runs, reads .shellcheckrc from the top of the
# checkout, whose disable= can do the same. Each path is written as its parts, so that this file, which tests.yaml
# runs, names none of them, and each is in the inventory for the tool alone.
TOOL_FILES = {"actionlint": ("/".join((".github", "actionlint.yaml")), "/".join((".github", "actionlint.yml"))),
              "shellcheck": ("." + "shellcheckrc",)}
# What the inventory cannot see (the top of this file). The check prints it on every run.
LIMIT = ("The limit: the check does not see a path that a job or a script assembles from parts (a variable joined with "
         "a name, a loop, a glob); any other way of running or reading a file that it cannot resolve fails the check.")
# How a construct outside SUPPORTED (the top of this file) fails.
CANNOT = "cannot resolve what this reads; write it in the supported form or give it a code owner"
WORKFLOW_FILE = re.compile(r"\.github/workflows/[^/]+\.ya?ml")
# A citation of a document, which names it without reading it: (docs/x.md, a section), a Markdown link to a web page,
# and docs/x.md#section.
CITATIONS = (re.compile(r"\((?:[\w.-]+/)*[\w.-]+\.md,\s[^()\n]*\)"), re.compile(r"\[[^\]\n]+\]\(https?://[^)\n]+\)"),
             re.compile(r"(?:[\w.-]+/)*[\w.-]+\.md#[\w.-]+"))
# A path from the top of the checkout, as code writes it.
PATH_TOKEN = re.compile(r"(?<![\w./+-])[\w.][\w./+-]*")
# The tokens of shell text that are no words: the operators, longest first, and a redirection with its file
# descriptor (2>, {fd}<, &>).
SHELL_OPERATORS = (";;&", ";;", ";&", "&&", "||", "|&", ";", "&", "|", "(", ")")
SHELL_REDIRECT = re.compile(r"(?:\d+|\{\w+\})?(?P<op><<<|<<-|<<|<>|<&|>&|>>|>\||&>>|&>|<|>)")
