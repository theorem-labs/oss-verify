#!/usr/bin/env bash
# Copyright 2026 Theorem Labs, PBC
# SPDX-License-Identifier: Apache-2.0
#
# Takes the pinned qemu-riscv64-static out of its Debian package, into a new directory, and prints the directory that
# holds it:
#
#   .github/scripts/unpack-qemu DIR >> "$GITHUB_PATH"
#
# DIR must not exist: the script makes it. On success, the one line on standard output is the absolute path of
# DIR/usr/bin. A download that fails, a wrong SHA-256, an unpack that fails, or a qemu that does not say version 10.0.11
# exits non-zero, with nothing on standard output.
#
# qemu-riscv64-static runs the fuzz targets for oss-verify check --checks, inside a container of the project image. It
# is taken out of its package, not installed: the package registers qemu with the kernel for riscv64 programs
# (binfmt_misc), and a build.sh could then run the riscv64 programs that it makes. (From #24.) The check of system calls
# reads the runs of qemu 10.0.11 only (src/oss_verify/check_binaries.py QEMU_VERSIONS), so this is Debian 13's
# qemu-user 1:10.0.11+ds-0+deb13u1, pinned by its SHA-256 at its snapshot.debian.org address: the build
# theorem-labs/oss-verify-proofs's toolchain/runner.Dockerfile runs counterexamples with. Its qemu-riscv64 is a static
# binary; the -static name is the one oss-verify check looks for.
#
# build.yaml's project-builds runs it. When it fails, that job goes on without qemu: --checks says that it could not
# measure, and the build is checked as before. tests.yaml's docker job runs it too, and fails when it fails.
set -euo pipefail
dir=${1:?usage: unpack-qemu DIR}
deb=qemu-user_10.0.11+ds-0+deb13u1_amd64.deb
mkdir -- "$dir"
dir=$(realpath -e -- "$dir")
curl -fsSL --retry 3 -o "$dir/$deb" https://snapshot.debian.org/file/a0eaa62f815efb2361d43b1e3f8011c17ad9123a
# sha256sum -c writes a mismatch to standard output, which carries the directory alone.
echo "6b6fea55551fbcc1eb30e146ad5abdfbb49f8fa8c5998016242126de4d7f80df  $dir/$deb" | sha256sum -c --quiet >&2
dpkg-deb -x "$dir/$deb" "$dir"
ln -s qemu-riscv64 "$dir/usr/bin/qemu-riscv64-static"
# The first line, as check_binaries.py QEMU_VERSIONS reads it.
version=$("$dir/usr/bin/qemu-riscv64-static" --version)
[[ $version =~ ^qemu-riscv64\ version\ 10\.0\.11([^0-9]|$) ]] \
  || { echo "unpack-qemu: qemu-riscv64-static --version says '${version%%$'\n'*}', not version 10.0.11" >&2; exit 1; }
echo "$dir/usr/bin"
