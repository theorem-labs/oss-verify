#
# compile: build this image's project once, for the build $SANITIZER names, into $OUT.
#
#     docker run --rm --network=none -e SANITIZER=address -v "$PWD/out:/out" <project image> compile
#
#     SANITIZER           build        flags beyond the common ones (docs/build-contract.md)
#     none                plain        -
#     undefined           ubsan        -fsanitize=undefined -fno-sanitize-recover=all -fsanitize-trap=all
#                                      -fno-sanitize=function
#     address             asan         -fsanitize=address, with the sealed static AddressSanitizer runtime
#     address-undefined   asan-ubsan   both
#
# It sets up that build's compilers and flags (toolchain.sh), compiles the driver ($LIB_FUZZING_ENGINE), and runs
# $SRC/build.sh with bash -eux from the image's working directory. build.sh builds each fuzz target into $OUT, as
# under OSS-Fuzz, by linking it with $LIB_FUZZING_ENGINE through $CC or $CXX. A link that names
# $LIB_ALLOCATION_FAILURE_ENGINE instead makes an allocation-failure fuzz target (docs/build-contract.md).
#
# Such a link is made twice (link-fuzz-target): once as asked, with symbols, and once with --strip-all. The binaries
# in $OUT keep their symbols, so that a fuzz target is found by its symbol table (an executable that defines
# LLVMFuzzerTestOneInput). The stripped twin of each executable in $OUT is saved as $OUT/.stripped/<sha256 of the
# executable>: those are the bytes that are published and that statements are about.
#
# Whole programs: each name in OV_PROGRAMS (space-separated; tools/check passes project.yaml's programs) is a program
# with its own main that build.sh links into $OUT/<name> itself, with $OV_PROGRAM_LDFLAGS and with no driver and no
# seals (docs/build-contract.md, "Whole programs"). After build.sh, compile requires each one to be a static
# executable that does not define LLVMFuzzerTestOneInput, else it stops with status 2 and writes why to
# $OUT/.ov-refused. It saves the stripped twin of each, `$CHOST-strip` of it, as $OUT/.stripped/<sha256 of the
# executable>. compile exports $OV_PROGRAM_LDFLAGS in every build; a fuzz target's link does not use it, and none of
# this changes a fuzz target.
#
# Set OV_OWNER=<uid>:<gid> to have $OUT handed to that owner at the end.
#
# Set OV_RECORD=1 to have each fuzz target's link recorded, with a quiet twin, in $OUT/.records/<sha256 of the
# executable>/ (link-fuzz-target says what a record holds). tools/check --checks sets it for its first build.
set -euo pipefail

LIB=/usr/local/lib/oss-verify

case "${SANITIZER:=none}" in
  none) FLAV=plain BUILD=plain ;;
  address) FLAV=asan BUILD=asan ;;
  undefined) FLAV=ubsan BUILD=ubsan ;;
  address-undefined) FLAV=asanubsan BUILD=asan-ubsan ;;
  *) echo "compile: SANITIZER must be none, address, undefined or address-undefined, not '$SANITIZER'" >&2; exit 2 ;;
esac
export SANITIZER FLAV

[ -f "$SRC/build.sh" ] || { echo "compile: there is no $SRC/build.sh" >&2; exit 2; }
mkdir -p "$OUT" "$WORK"
if [ -n "${OV_OWNER:-}" ]; then
  trap 'chown -R "$OV_OWNER" "$OUT" 2>/dev/null || true' EXIT
fi
export -n OV_OWNER

# A rule break of the project's: say why, write the reason to $OUT/.ov-refused, and stop with status 2. tools/check
# reads the file to report that the project breaks the enrollment rules, not that it does not build (check_build.py,
# compile_build). Status 2 alone does not say so: `bash -eux build.sh` also stops with make's own status 2.
refuse() {
  echo "compile: $1" >&2
  printf '%s\n' "$1" > "$OUT/.ov-refused"
  exit 2
}

echo "compile: the $BUILD build (SANITIZER=$SANITIZER)"

# A Go toolchain image (it sets OFTGO) builds a Go project, with OSS-Fuzz's Go helpers: go/compile-go.
if [ -n "${OFTGO:-}" ]; then
  [ -z "${OV_PROGRAMS:-}" ] || refuse "the Go builder builds fuzz targets only, not programs"
  "$LIB/go/compile-go"
  exit 0
fi

# shellcheck source=toolchain.sh
. "$LIB/toolchain.sh"
real_cc=$CC real_cxx=$CXX

# The project's code gets CFLAGS as the release recipe gives a library and its harness.
suppress_unused_arg_werror
define_fuzzing_build_mode
CXXFLAGS="$CFLAGS -stdlib=libc++"
# With a project's UBSan checks: what its C compiles leave out (OV_UBSAN_C_EXCLUDE), as OSS-Fuzz leaves function out
# of each C compile. C++ compiles keep it.
if [ -n "${OV_UBSAN_C_EXCLUDE:-}" ] && [ -n "${OV_UBSAN_CHECKS:-}" ]; then
  case "$FLAV" in ubsan|asanubsan) CFLAGS="$CFLAGS -fno-sanitize=$OV_UBSAN_C_EXCLUDE" ;; esac
fi

# The driver and the seals are compiled as the release recipe compiles them: with no sanitizer, in every build.
OV=/tmp/ov
rm -rf "$OV"
mkdir -p "$OV/bin" "$OV/twins"
"$DRVCC" $BASE_CFLAGS -c -I"$LIB/driver" "$LIB/driver/cli.c" -o "$OV/cli.o"
"$DRVCC" $BASE_CFLAGS -c -I"$LIB/driver" "$LIB/driver/adapter.c" -o "$OV/adapter.o"
for seal in getenv mkstemp getpid; do
  "$DRVCC" $BASE_CFLAGS -c "$LIB/driver/wrap_$seal.c" -o "$OV/wrap_$seal.o"
done
# An archive, so that a link that does not go through $CC or $CXX still gets a working program.
"$CHOST-ar" rcs "$OV/libFuzzingEngine.a" "$OV/cli.o" "$OV/adapter.o"
LIB_FUZZING_ENGINE=$OV/libFuzzingEngine.a

# With OV_RECORD=1 (tools/check --checks), link-fuzz-target records each link for the checks of the binaries and links
# a quiet twin with the quiet driver: each driver object compiled again with -DHARNESS_QUIET, as <object>-quiet.o, so
# that cli.c's DIAG and the adapter's emit_printf (emit.h) write nothing. The records reach $OUT/.records/ at the end.
# They change no byte of the binaries.
OV_RECORDS=""
if [ "${OV_RECORD:-}" = 1 ]; then
  OV_RECORDS=$OV/records
  mkdir -p "$OV_RECORDS"
  for src in cli adapter allocation_failure; do
    "$DRVCC" $BASE_CFLAGS -DHARNESS_QUIET -c -I"$LIB/driver" "$LIB/driver/$src.c" -o "$OV/$src-quiet.o"
  done
  "$DRVCC" $BASE_CFLAGS -DHARNESS_QUIET -DOV_ALLOCATION_COUNTING -c -I"$LIB/driver" "$LIB/driver/allocation_failure.c" \
    -o "$OV/allocation_counting-quiet.o"
fi
# For the recipes that compile their own adapter, which then compile a quiet one too (OV_ADAPTER_QUIET).
export OV_RECORDS

# The driver of an allocation-failure fuzz target: cli.o with allocation_failure.o, linked only by link-fuzz-target,
# which renames the allocators the project's code calls (OV_AF_RENAME) to allocation_failure.c's. A link that does
# not go through $CC or $CXX would make a program whose allocations never fail, so this is not an archive: such a
# link fails. $LIB_ALLOCATION_COUNTING_ENGINE is the same with counting mode on, for sweep and test builds only.
"$DRVCC" $BASE_CFLAGS -c -I"$LIB/driver" "$LIB/driver/allocation_failure.c" -o "$OV/allocation_failure.o"
"$DRVCC" $BASE_CFLAGS -DOV_ALLOCATION_COUNTING -c -I"$LIB/driver" "$LIB/driver/allocation_failure.c" \
  -o "$OV/allocation_counting.o"
printf 'Not an archive: link an allocation-failure fuzz target with $CC or $CXX (docs/build-contract.md).\n' \
  | tee "$OV/libAllocationFailureEngine.a" > "$OV/libAllocationCountingEngine.a"
LIB_ALLOCATION_FAILURE_ENGINE=$OV/libAllocationFailureEngine.a
LIB_ALLOCATION_COUNTING_ENGINE=$OV/libAllocationCountingEngine.a
af_rename=""
for f in malloc calloc realloc reallocarray aligned_alloc posix_memalign memalign strdup strndup \
         _Znwm _Znam _ZnwmRKSt9nothrow_t _ZnamRKSt9nothrow_t _ZnwmSt11align_val_t _ZnamSt11align_val_t \
         _ZnwmSt11align_val_tRKSt9nothrow_t _ZnamSt11align_val_tRKSt9nothrow_t; do
  af_rename="$af_rename --redefine-sym $f=__ov_$f"
done

silent=""
case "$FLAV" in asan|asanubsan) silent="-Wl,--defsym=__sanitizer_silent_reports=1" ;; esac
# The link flags of a whole program (OV_PROGRAM_LDFLAGS): a fuzz target's link without its driver and its seals
# (link-fuzz-target), and in the AddressSanitizer builds, the driver's __asan_default_options (driver/asan_options.c,
# compiled as the driver is) and the silent reports.
program_ldflags="-static -no-pie -Wl,--gc-sections"
case "$FLAV" in
  asan|asanubsan)
    "$DRVCC" $BASE_CFLAGS -c "$LIB/driver/asan_options.c" -o "$OV/asan_options.o"
    program_ldflags="$program_ldflags $OV/asan_options.o $silent" ;;
esac
cat > "$OV/link.env" <<EOF
OV_LFE='$LIB_FUZZING_ENGINE'
OV_DRIVER='$OV/cli.o $OV/adapter.o'
OV_CLI='$OV/cli.o'
OV_SILENT_LD='$silent'
OV_SEALS='$OV/wrap_getenv.o -Wl,--wrap=getenv $OV/wrap_mkstemp.o -Wl,--wrap=mkstemp -Wl,--wrap=mkostemp -Wl,--wrap=mkstemps -Wl,--wrap=mkostemps $OV/wrap_getpid.o -Wl,--wrap=getpid -Wl,--wrap=getppid'
OV_TWINS='$OV/twins'
OV_AFE='$LIB_ALLOCATION_FAILURE_ENGINE'
OV_AF_DRIVER='$OV/cli.o $OV/allocation_failure.o'
OV_AFC='$LIB_ALLOCATION_COUNTING_ENGINE'
OV_AFC_DRIVER='$OV/cli.o $OV/allocation_counting.o'
OV_RECORDS='$OV_RECORDS'
OV_AF_RENAME='${af_rename# }'
EOF

# $CC and $CXX: the build's compiler, except that a link naming $LIB_FUZZING_ENGINE or $LIB_ALLOCATION_FAILURE_ENGINE
# goes to link-fuzz-target.
write_wrapper() {
  cat > "$1" <<EOF
#!/bin/sh
for a in "\$@"; do
  case "\$a" in -c|-E|-S|-fsyntax-only|-M|-MM|--version|-dumpmachine|-print-*) exec $2 "\$@" ;; esac
done
for a in "\$@"; do
  case "\$a" in "$LIB_FUZZING_ENGINE"|"$LIB_ALLOCATION_FAILURE_ENGINE"|"$LIB_ALLOCATION_COUNTING_ENGINE")
    exec $LIB/link-fuzz-target $2 "\$@" ;; esac
done
exec $2 "\$@"
EOF
  chmod +x "$1"
}
write_wrapper "$OV/bin/$CHOST-clang" "$real_cc"
write_wrapper "$OV/bin/$CHOST-clang++" "$real_cxx"
CC=$OV/bin/$CHOST-clang
CXX=$OV/bin/$CHOST-clang++

# CMake picks this up by itself (CMake 3.21 and later read CMAKE_TOOLCHAIN_FILE from the environment). As the
# release recipe writes it.
cat > "$OV/toolchain.cmake" <<EOF
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
set(CMAKE_SYSROOT "/opt/musl-sysroot")
set(CMAKE_FIND_ROOT_PATH "/opt/musl-sysroot" "/opt/musl-sysroot/usr")
set(CMAKE_C_COMPILER "$CC")
set(CMAKE_CXX_COMPILER "$CXX")
set(CMAKE_C_FLAGS "$CFLAGS" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS "$CXXFLAGS" CACHE STRING "" FORCE)
set(CMAKE_EXE_LINKER_FLAGS "-stdlib=libc++" CACHE STRING "" FORCE)
set(CMAKE_SHARED_LINKER_FLAGS "-stdlib=libc++" CACHE STRING "" FORCE)
set(CMAKE_MODULE_LINKER_FLAGS "-stdlib=libc++" CACHE STRING "" FORCE)
set(CMAKE_AR "/usr/bin/llvm-ar" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "/usr/bin/llvm-ranlib" CACHE FILEPATH "" FORCE)
set(CMAKE_NM "/usr/bin/llvm-nm" CACHE FILEPATH "" FORCE)
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
EOF

# OSS-Fuzz's names, and a few more that cross builds need. FUZZING_ENGINE is "none", OSS-Fuzz's name for a driver
# that runs inputs from files.
export CC CXX CFLAGS CXXFLAGS LIB_FUZZING_ENGINE LIB_ALLOCATION_FAILURE_ENGINE LIB_ALLOCATION_COUNTING_ENGINE
export ARCHITECTURE=riscv64 FUZZING_ENGINE=none OV_PROGRAM_LDFLAGS="$program_ldflags"
export CMAKE_TOOLCHAIN_FILE=$OV/toolchain.cmake
export AR=$CHOST-ar NM=$CHOST-nm RANLIB=$CHOST-ranlib STRIP=$CHOST-strip OBJCOPY=$CHOST-objcopy

echo "compile: CC=$CC"
echo "compile: CFLAGS=$CFLAGS"
echo "compile: CXXFLAGS=$CXXFLAGS"
echo "compile: OV_PROGRAM_LDFLAGS=$OV_PROGRAM_LDFLAGS"
bash -eux "$SRC/build.sh"
# The file is compile's to write: one that build.sh left is not a refusal.
rm -f "$OUT/.ov-refused"

# Save the stripped twin of each executable build.sh left in $OUT.
mkdir -p "$OUT/.stripped"
found=0
for f in "$OUT"/* "$OUT"/.[!.]*; do
  [ -f "$f" ] && [ ! -L "$f" ] || continue
  sum=$(sha256sum "$f" | cut -d' ' -f1)
  if [ -f "$OV/twins/$sum" ]; then
    cp "$OV/twins/$sum" "$OUT/.stripped/$sum"
    if [ -n "$OV_RECORDS" ] && [ -d "$OV_RECORDS/$sum" ]; then
      mkdir -p "$OUT/.records"
      rm -rf "$OUT/.records/$sum"
      cp -R "$OV_RECORDS/$sum" "$OUT/.records/$sum"
    fi
    # Not grep -q: with pipefail, llvm-nm would be killed by the closed pipe and the test would fail.
    if llvm-nm --defined-only "$f" 2>/dev/null | grep ' T LLVMFuzzerTestOneInput$' >/dev/null; then
      echo "compile: fuzz target $(basename "$f")"
      found=$((found + 1))
    fi
  fi
done
echo "compile: $found fuzz target(s) in $OUT, the $BUILD build"

# Each whole program that OV_PROGRAMS names: a static executable that build.sh linked itself, not a fuzz target. Its
# stripped twin, saved under the sha256 of the executable as a fuzz target's is, holds its published bytes.
programs=0
read -r -a program_names <<< "${OV_PROGRAMS:-}"
for name in ${program_names[@]+"${program_names[@]}"}; do
  f=$OUT/$name
  why=""
  if ! [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$ ]]; then
    why="is not a program name (A-Z a-z 0-9 . _ + -, at most 100)"
  elif [ ! -f "$f" ] || [ -L "$f" ]; then
    why="is not a regular file in \$OUT: build.sh must link it into \$OUT/$name"
  elif [ ! -x "$f" ]; then
    why="is not executable"
  # Not grep -q: with pipefail, llvm-readelf or llvm-nm would be killed by the closed pipe and the test would fail.
  elif ! llvm-readelf --file-header "$f" 2>/dev/null | grep -E '^ *Type: +EXEC ' >/dev/null; then
    why="is not an executable ELF file at fixed addresses (ELF type EXEC): link it with \$OV_PROGRAM_LDFLAGS"
  elif llvm-readelf --program-headers "$f" 2>/dev/null | grep -E '^ *(INTERP|DYNAMIC) ' >/dev/null; then
    why="is not statically linked (it has a PT_INTERP or PT_DYNAMIC program header): link it with \$OV_PROGRAM_LDFLAGS"
  elif llvm-nm --defined-only "$f" 2>/dev/null | grep -E ' [TW] LLVMFuzzerTestOneInput$' >/dev/null; then
    why="defines LLVMFuzzerTestOneInput: it is a fuzz target, so leave it out of programs"
  fi
  [ -z "$why" ] || refuse "program $name, which OV_PROGRAMS names, $why (the $BUILD build)"
  sum=$(sha256sum "$f" | cut -d' ' -f1)
  "$CHOST-strip" -o "$OUT/.stripped/$sum" "$f"
  echo "compile: program $name"
  programs=$((programs + 1))
done
[ -z "${OV_PROGRAMS:-}" ] || echo "compile: $programs program(s) in $OUT, the $BUILD build"
# The files the recorded links took from outside the toolchain's /opt, by sha256 (link-fuzz-target).
if [ -n "$OV_RECORDS" ] && [ -d "$OV_RECORDS/store" ]; then
  mkdir -p "$OUT/.records/store"
  cp -R "$OV_RECORDS/store/." "$OUT/.records/store/"
fi
