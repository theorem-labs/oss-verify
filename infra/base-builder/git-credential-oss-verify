#
# git-credential-oss-verify: how git gets the read-only token of a private library, and the only place that token is
# read. git runs it as `git-credential-oss-verify get` (credential.helper=oss-verify in the builder image, the
# absolute path of this file on the host) and reads `username=` and `password=` from its standard output.
#
# The token comes from one of two places, in this order:
#
#   OSS_VERIFY_GIT_TOKEN   the environment of the git process that oss-verify check starts on the host
#                          (src/oss_verify/check_build.py).
#                          An environment is readable only by the user that owns the process.
#   OSS_VERIFY_TOKEN_FILE  the file that holds it, which inside a build is the BuildKit secret mount
#                          /run/secrets/oss-verify-git-token: a tmpfs file that lives only while that RUN step runs.
#
# **It answers for one repository, the one in OSS_VERIFY_TOKEN_REPO (`<host>/<owner>/<name>`), and for nothing
# else.** git asks a helper for every server it reaches, and `git submodule update --recursive` reaches whatever
# servers the tree names: without this check a submodule on another host would be offered our token, which is a
# credential handed to a third party with no attacker involved. The caller sets credential.useHttpPath so that the
# request carries the path; a request with no path is matched on its host alone, and an unset OSS_VERIFY_TOKEN_REPO
# answers any request, which is how the tests drive it.
#
# Why a credential helper and not a URL or a header: a token in the URL is written into .git/config, which is a
# layer, and is printed by `git remote -v`; a token in `-c http.extraHeader` is in a command line, which every other
# process on the host can read. A helper's answer goes down a pipe to git and nowhere else.
#
# With no token, or for another repository, it answers nothing and exits 0: git then has no credential, the fetch
# fails as an unauthorised one, and fetch-commit says so. It never prompts, and it stores nothing: `store` and
# `erase` do nothing, because this token is minted for one build and is not meant to outlive it.
set -eu
set +x

# git's request: one `key=value` a line, ended by a blank line. It is read whatever the operation, so git never
# writes into a closed pipe.
host=
path=
while IFS= read -r line; do
  case $line in
    host=*) host=${line#host=} ;;
    path=*) path=${line#path=} ;;
    "") break ;;
  esac
done

[ "${1:-}" = get ] || exit 0

# Which repository this helper is for. The path git sends may end in .git and may begin with a slash; the value of
# the variable is the repository URL's host and path, as project.yaml gives it.
want=${OSS_VERIFY_TOKEN_REPO:-}
if [ -n "$want" ]; then
  want=${want%/}
  want=${want%.git}
  if [ -n "$path" ]; then
    asked=$host/${path#/}
    asked=${asked%.git}
    [ "$asked" = "$want" ] || exit 0
  else
    # No path: the caller did not set credential.useHttpPath, so the host is all there is to match on.
    [ "$host" = "${want%%/*}" ] || exit 0
  fi
fi

token=${OSS_VERIFY_GIT_TOKEN:-}
if [ -z "$token" ] && [ -n "${OSS_VERIFY_TOKEN_FILE:-}" ] && [ -s "${OSS_VERIFY_TOKEN_FILE}" ]; then
  token=$(cat "$OSS_VERIFY_TOKEN_FILE")
fi
[ -n "$token" ] || exit 0

# x-access-token is the user name GitHub takes for an App installation token; the token is the password.
printf 'username=x-access-token\npassword=%s\n' "$token"
