#
# link-fuzz-target <compiler> <arguments>: the link of a fuzz target, a link whose arguments name
# $LIB_FUZZING_ENGINE. $CC and $CXX hand such a link here; build.sh never calls this itself.
#
# The link is made as the oss-fuzz-theorems 2026.10 release recipe makes it, whose binaries this reproduces
# byte for byte:
#
#     <compiler> -static -no-pie -Wl,--gc-sections <driver> [<silent reports>] <the link's own arguments> <seals>
#
# The driver (cli.o, adapter.o, and msan_options.o in the msan build) comes first, in place of $LIB_FUZZING_ENGINE
# wherever the link named it, and the seals (getenv, mkstemp and getpid, each wrapped; in the msan build, getenv is
# defined instead, for the MemorySanitizer runtime's own wrapper to call) come last: both positions change the bytes.
# A link that already wraps one of those functions has its own seals (a build ported from the release's recipe adds
# them where its pin did), and gets none added. In the AddressSanitizer builds and the msan build,
# --defsym=__sanitizer_silent_reports=1 makes a detection abort without printing a report.
#
# It links twice: the output the link asked for, with its symbols, and the same link with --strip-all, saved under
# the sha256 of the first for compile to collect.
#
# A link that names $LIB_ALLOCATION_FAILURE_ENGINE makes an allocation-failure fuzz target (docs/build-contract.md):
# the same link, with allocation_failure.o in place of the adapter, and with copies of the object files and archives
# it names, whose calls of the allocators are renamed to allocation_failure.c's. Those are the only changes.
# $LIB_ALLOCATION_COUNTING_ENGINE makes the same, with counting mode on (allocation_counting.o), for sweep and test
# builds.
#
# A recipe that compiles its own adapter (rust/recipes.sh, with plugin_rust.h; python/recipes.sh, with
# python_tier_plugin.h) names it in OV_ADAPTER: it takes the place of adapter.o.
#
# With OV_RECORDS set (compile sets it for tools/check --checks), it also records the link for the checks of the
# binaries: the linker's map, the files the link took, and a quiet twin linked with the quiet driver (below, at the
# end). None of this changes a byte of the two outputs.
set -euo pipefail

# shellcheck source=/dev/null
. /tmp/ov/link.env

real=$1
shift
out=a.out
args=()
seals=$OV_SEALS
driver=$OV_DRIVER
while [ $# -gt 0 ]; do
  case "$1" in
    "$OV_LFE") ;;
    "$OV_AFE") driver=$OV_AF_DRIVER ;;
    "$OV_AFC") driver=$OV_AFC_DRIVER ;;
    -Wl,--wrap=getenv|-Wl,--wrap=getpid|-Wl,--wrap=mkstemp)
      seals=""
      args+=("$1") ;;
    -o)
      [ $# -ge 2 ] || { echo "link-fuzz-target: -o needs a file name" >&2; exit 1; }
      out=$2
      shift ;;
    -o?*) out=${1#-o} ;;
    *) args+=("$1") ;;
  esac
  shift
done

if [ -n "${OV_ADAPTER:-}" ]; then
  [ "$driver" = "$OV_DRIVER" ] || { echo "link-fuzz-target: a fuzz target with its own adapter has no allocation-failure form" >&2; exit 1; }
  driver="$OV_CLI $OV_ADAPTER"
fi

if [ "$driver" = "$OV_AF_DRIVER" ] || [ "$driver" = "$OV_AFC_DRIVER" ]; then
  copies=$(mktemp -d /tmp/ov/af.XXXXXX)
  for i in "${!args[@]}"; do
    a=${args[$i]}
    case "$a" in
      # --for-linker is clang's other spelling of -Xlinker, and a --config file can hold -L, -l and -Wl options.
      -l*|-Wl,*|-Xlinker|--for-linker|--for-linker=*|--config|--config=*)
        echo "link-fuzz-target: $a: name an allocation-failure fuzz target's object files and archives directly, without -l, linker forwarding or a configuration file" >&2
        exit 1 ;;
      -*) continue ;;
      @*)
        echo "link-fuzz-target: $a: name an allocation-failure fuzz target's objects on the command line" >&2
        exit 1 ;;
      *.c|*.cc|*.cpp|*.cxx|*.c++|*.C|*.m|*.mm|*.s|*.S)
        echo "link-fuzz-target: $a: compile an allocation-failure fuzz target's sources first, and link the objects" >&2
        exit 1 ;;
    esac
    [ -f "$a" ] || continue
    case "$(head -c 4 -- "$a")" in
      $'\177ELF'|'!<ar') ;;
      'BC'$'\300\336')
        echo "link-fuzz-target: $a: LLVM bitcode; an allocation-failure fuzz target needs object code (no LTO)" >&2
        exit 1 ;;
      *)
        echo "link-fuzz-target: $a: an allocation-failure fuzz target needs object files and archives, not linker scripts or other inputs" >&2
        exit 1 ;;
    esac
    copy="$copies/$i-$(basename -- "$a")"
    cp -- "$a" "$copy"
    # shellcheck disable=SC2086 # a list of options
    llvm-objcopy $OV_AF_RENAME "$copy"
    args[i]=$copy
    # For the record (below): which file the copy stands for.
    if [ -n "${OV_RECORDS:-}" ]; then
      printf '%s\t%s\t%s\n' "$copy" "$(readlink -f -- "$a")" "$(sha256sum < "$a" | cut -d' ' -f1)" >> "$copies/renamed"
    fi
  done
fi

tail=()
link() {
  # shellcheck disable=SC2086 # the lists in link.env are meant to be split
  $real -static -no-pie -Wl,--gc-sections "$@" $driver $OV_SILENT_LD ${args[@]+"${args[@]}"} $seals \
    ${tail[@]+"${tail[@]}"}
}

# With OV_RECORDS (tools/check --checks), the first link also writes the linker's map: every input section the link
# took, with the object or archive member it came from. It is the last argument, so that it is the map the linker
# writes even when the link names one of its own. The map changes no byte of either output.
[ -z "${OV_RECORDS:-}" ] || tail=("-Wl,-Map=$OV_RECORDS/map.$$")
link -o "$out"
tail=()
sum=$(sha256sum "$out" | cut -d' ' -f1)
link -Wl,--strip-all -o "$OV_TWINS/$sum.tmp"
mv -f "$OV_TWINS/$sum.tmp" "$OV_TWINS/$sum"

[ -n "${OV_RECORDS:-}" ] || exit 0
# The record of this link, for the checks of tools/check --checks (tools/check_links.py), in $OV_RECORDS/<sum>/:
#   map         the input sections of the linker's map
#   driver      the driver's objects and the seals, one a line: compiled without a sanitizer in every build, by design
#   inputs.tsv  each file the map names: <path as the map names it> <real path> <sha256> <bytes>
#   renamed     for an allocation-failure link, each copy it made: <copy> <real path of the original> <its sha256>
#   quiet       the quiet twin: the same link, stripped, with each of the driver's objects compiled with -DHARNESS_QUIET
#               (compile makes <object>-quiet.o beside each one; a recipe's own adapter names its quiet build in
#               OV_ADAPTER_QUIET), so that the driver writes nothing. Absent when one of them has no quiet build.
# Every input is also kept, by its sha256, in $OV_RECORDS/store/: what the build made is gone when its container
# ends, and the checks examine its code. A record that cannot be written is left out, with a warning: the link itself
# has succeeded, and the checks then say that the target has no record.
rec=$OV_RECORDS/$sum
# `set -e` does not apply inside the condition of an `if`, so each step says `|| return 1` for itself.
record_link() {
  rm -rf "$rec" || return 1
  mkdir -p "$rec" "$OV_RECORDS/store" || return 1
  awk '{
    line = $0
    sub(/^ *[0-9a-f]+ +[0-9a-f]+ +[0-9a-f]+ +[0-9]+ /, "", line)
    if (substr(line, 1, 8) == "        " && substr(line, 9, 1) != " " && index(line, ":(")) print
  }' "$OV_RECORDS/map.$$" > "$rec/map" || return 1
  [ -s "$rec/map" ] || return 1   # a link whose map names no input section: the record would say nothing
  rm -f "$OV_RECORDS/map.$$" || return 1
  # shellcheck disable=SC2086 # lists of words
  { for word in $driver $seals; do case "$word" in *.o) printf '%s\n' "$word" ;; esac; done; } > "$rec/driver" \
    || return 1
  if [ -n "${copies:-}" ] && [ -f "$copies/renamed" ]; then cp -- "$copies/renamed" "$rec/renamed" || return 1; fi
  awk '{
    sub(/^ *[0-9a-f]+ +[0-9a-f]+ +[0-9a-f]+ +[0-9]+ +/, "")
    at = 0
    for (i = length($0) - 1; i > 0; i--) if (substr($0, i, 2) == ":(") { at = i; break }
    if (!at) next
    file = substr($0, 1, at - 1)
    if (file == "<internal>") next
    if (substr(file, length(file), 1) == ")") { for (i = length(file); i > 0; i--) if (substr(file, i, 1) == "(") break; file = substr(file, 1, i - 1) }
    print file
  }' "$rec/map" | LC_ALL=C sort -u | while IFS= read -r file; do
    real=$(readlink -f -- "$file") && [ -f "$real" ] || continue
    digest=$(sha256sum < "$real" | cut -d' ' -f1) || exit 1
    printf '%s\t%s\t%s\t%s\n' "$file" "$real" "$digest" "$(wc -c < "$real")" || exit 1
    [ -f "$OV_RECORDS/store/$digest" ] \
      || { cp -- "$real" "$OV_RECORDS/store/$digest.$$" && mv -f "$OV_RECORDS/store/$digest.$$" "$OV_RECORDS/store/$digest"; } \
      || exit 1
  done > "$rec/inputs.tsv" || return 1
  local quiet="" word twin
  # shellcheck disable=SC2086 # a list of objects
  for word in $driver; do
    if [ -n "${OV_ADAPTER:-}" ] && [ "$word" = "$OV_ADAPTER" ]; then twin=${OV_ADAPTER_QUIET:-}; else twin=${word%.o}-quiet.o; fi
    if [ -z "$twin" ] || [ ! -f "$twin" ]; then quiet=""; break; fi
    quiet="$quiet $twin"
  done
  if [ -n "$quiet" ]; then
    driver=$quiet
    link -Wl,--strip-all -o "$rec/quiet" || return 1
  fi
  return 0
}
if ! record_link; then
  echo "link-fuzz-target: warning: the record of the link of $out could not be written; its binary checks will say so" >&2
  rm -rf "$rec" "$OV_RECORDS/map.$$"
fi
