#
# run-seeds: runs fuzz targets on their seed inputs for oss-verify check --checks, in a fresh container of the project
# image with no network, so that the binaries a pull request built never run on the host itself:
#
#     docker run --rm --network=none -v <qemu-riscv64-static>:/ovc-qemu:ro -v infra/checks:/ovc:ro \
#         -v <binaries>:/bins:ro -v <inputs>:/inputs:ro -v <results>:/results --entrypoint /ovc/run-seeds \
#         <project image> <jobs> <seconds> [<total seconds>]
#
# It runs /bins/<target> on each /inputs/<target>/<n> with qemu-riscv64, <jobs> at a time, each run in a directory of
# its own and stopped after <seconds>. It writes /results/<target>/<n>.status, the run's exit status (137 when it was
# stopped), and /results/<target>/<n>.profraw, the profile that a coverage build writes. With <total seconds> above 0,
# all runs stop after that time, and an input that did not finish has no status file.
set -eu
jobs=$1 seconds=$2 total=${3:-0}
cd /inputs
limit=""
[ "$total" -gt 0 ] && limit="timeout -s KILL $total"
for target in *; do
  [ -f "/bins/$target" ] || continue
  mkdir -p "/results/$target"
  for input in "$target"/*; do
    [ -f "$input" ] && echo "$input"
  done
done | $limit xargs -P "$jobs" -n 1 sh -c '
  target=${1%%/*} n=${1#*/}
  run=/tmp/ovc-run/$target/$n
  mkdir -p "$run" && cd "$run"
  status=0
  timeout -s KILL "$0" /ovc-qemu "/bins/$target" "/inputs/$1" > /dev/null 2>&1 || status=$?
  echo "$status" > "/results/$target/$n.status"
  [ ! -f default.profraw ] || mv default.profraw "/results/$target/$n.profraw"
  cd / && rm -rf "$run"
' "$seconds" || true
if [ -n "${OV_OWNER:-}" ]; then chown -R "$OV_OWNER" /results; fi
