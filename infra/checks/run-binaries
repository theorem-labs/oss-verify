#
# run-binaries: runs fuzz-target binaries for the binary checks of oss-verify check --checks
# (src/oss_verify/check_binaries.py), in a fresh container of the toolchain image with no network, so that the binaries
# a pull request built never run on the host itself:
#
#     docker run --rm --init --network=none -v <qemu-riscv64-static>:/ovc-qemu:ro -v infra/checks:/ovc:ro \
#         -v <job>:/job:ro -v <results>:/results --entrypoint /ovc/run-binaries <toolchain image> <seconds> <total>
#
# /job/runs has one run on each line: <id> <binary> <input> <name>, the binary and the input relative to /job, and the
# name the program gets as its argv[0] (the fuzz target's name). The runs are made one after the other, each as the
# process model's environment has it: in an empty working directory, /ovb, that holds the input as input.bin, named by
# that relative name; with an empty /tmp; with an /etc that holds only the files written below, so that no file of the
# image's /etc decides what a run does; with no environment; and as user 65534, so that the program cannot write what
# the next run, or the host's files, read. The program can write its own trace (qemu writes it as that user), so like
# the records the runs do not stand against a binary written to deceive them. Each run is stopped after <seconds>, and
# no run starts after <total> seconds.
#
# Each run runs qemu-riscv64 -strace under infra/checks/host-calls.c, which logs the host calls whose arguments qemu's
# log prints in 32 bits only, and the family of each connect's address, which qemu's log does not print. For each run
# it writes /results/<id>.status (the exit status; 137 when it was stopped),
# /results/<id>.out and /results/<id>.err (how many bytes it wrote to standard output and standard error),
# /results/<id>.trace (qemu's -strace log) and /results/<id>.calls (host-calls' log). A run that did not start has no
# status file.
set -eu
seconds=$1 total=$2
end=$(($(date +%s) + total))
guest=65534
# The tracer, compiled with the image's own C compiler before /etc is emptied.
cc -static -O2 -o /ovc-host-calls /ovc/host-calls.c
# The guest's /etc: hosts, resolv.conf and nsswitch.conf as written below, an empty hostname, and nothing else. Docker
# mounts its own hosts, hostname and resolv.conf over the image's; their text is replaced here, in this container only.
# resolv.conf names no search domain, which changes what a resolver asks.
for f in /etc/* /etc/.[!.]*; do
  case "$f" in /etc/hosts|/etc/hostname|/etc/resolv.conf) ;; *) rm -rf -- "$f" ;; esac
done
printf '127.0.0.1 localhost\n::1 localhost\n' > /etc/hosts
printf 'nameserver 127.0.0.1\n' > /etc/resolv.conf
printf 'passwd: files\ngroup: files\nshadow: files\nhosts: files dns\nnetworks: files\nprotocols: files\nservices: files\n' \
  > /etc/nsswitch.conf
: > /etc/hostname   # docker mounts this file, so it cannot be removed; it is emptied instead

while read -r id binary input name; do
  now=$(date +%s)
  [ "$now" -lt "$end" ] || break
  limit=$seconds
  [ $((end - now)) -ge "$limit" ] || limit=$((end - now))
  # Each run starts afresh: no run leaves state for the next, in the working directory or anywhere a program writes.
  rm -rf /ovb /ovt /tmp/* /tmp/.[!.]* /var/tmp/* /var/tmp/.[!.]* /dev/shm/* /dev/shm/.[!.]* 2>/dev/null || true
  mkdir /ovb /ovt
  cp -- "/job/$input" /ovb/input.bin
  chown -R "$guest:$guest" /ovb /ovt
  chmod 1777 /tmp
  status=0
  (cd /ovb && exec timeout -s KILL "$limit" /ovc-host-calls "/results/$id.calls" "$guest" \
     /ovc-qemu -0 "$name" -strace -D /ovt/trace "/job/$binary" input.bin) \
    > /ovr.out 2> /ovr.err < /dev/null || status=$?
  wc -c < /ovr.out > "/results/$id.out"
  wc -c < /ovr.err > "/results/$id.err"
  # The trace, which the guest's user owns: only a regular file, and at most 256 MiB of it.
  if [ -f /ovt/trace ] && [ ! -L /ovt/trace ]; then head -c 268435456 /ovt/trace > "/results/$id.trace"; fi
  # A host-call log over 64 MiB is emptied, not cut: a cut log would look whole, and an empty one reads as missing,
  # so the run decides nothing.
  if [ "$(wc -c < "/results/$id.calls" 2>/dev/null || echo 0)" -gt 67108864 ]; then : > "/results/$id.calls"; fi
  echo "$status" > "/results/$id.status"
done < /job/runs
rm -rf /ovb /ovt /ovr.out /ovr.err /ovc-host-calls
if [ -n "${OV_OWNER:-}" ]; then chown -R "$OV_OWNER" /results; fi
