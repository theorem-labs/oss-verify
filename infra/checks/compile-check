#
# compile-check: a build for oss-verify check --checks (docs/build-contract.md, "The checks of a fuzz target"). It runs
# in a fresh container of the project image, with no network, in place of `compile`, and its binaries are never
# published:
#
#     docker run --rm --network=none -v infra/checks:/ovc:ro [-v <patch>:/ovc-mutant.patch:ro] -v <out>:/out \
#         -e SANITIZER=<sanitizer> [-e OVC_COVERAGE=1 -v <compiler-rt source>:/ovc-rt:ro] <project image> /ovc/compile-check
#
# With /ovc-mutant.patch, it first applies that breakage patch with `git apply`, in the image's working directory,
# where build.sh runs. Then it runs `compile` for the build that SANITIZER names.
#
# With OVC_COVERAGE=1 (only with SANITIZER=none), the build also records which lines and branches each run executes:
#   - each compile and link for riscv64 also gets -O0 -fprofile-instr-generate -fcoverage-mapping (after the build's
#     -Os, so -O0 wins);
#   - each link gets LLVM's profile runtime, which the toolchain image does not have. This builds it from the source
#     of compiler-rt at /ovc-rt, of the toolchain's LLVM version, which oss-verify check downloads and checks, and puts
# it
#     where clang looks for it;
#   - each link gets -Wl,--wrap=abort, and abort_dump.c's __wrap_abort, in that runtime's archive, writes the profile
#     before it aborts. So a profile also counts the abort() call that ended the run.
# The driver's seal makes getenv() return NULL, so the runtime ignores LLVM_PROFILE_FILE and writes default.profraw
# in the current directory.
set -euo pipefail

if [ -f /ovc-mutant.patch ]; then
  echo "compile-check: applying the breakage patch in $PWD"
  # Paths start at this directory: git looks for no repository above it, so it never reads them from the top of an
  # enclosing repository. git apply skips a path outside the directory and still exits 0, so a skip is a failure.
  applied=$(GIT_CEILING_DIRECTORIES=$(dirname "$PWD") git apply --verbose /ovc-mutant.patch 2>&1) || {
    echo "$applied"; exit 3; }
  echo "$applied"
  case $applied in *"Skipped patch"*) echo "compile-check: git apply skipped a file of the patch" >&2; exit 3 ;; esac
fi

if [ "${OVC_COVERAGE:-}" = 1 ]; then
  cfg=/opt/asan-static/musl.cfg
  runtime=$(clang --config=$cfg -print-runtime-dir)
  rt=/ovc-rt/lib/profile
  build=/tmp/ovc-profile
  mkdir -p "$build" /tmp/ovc-bin
  flags=(--config=$cfg -O2 -g0 -fvisibility=hidden -DCOMPILER_RT_HAS_UNAME=1 -DCOMPILER_RT_HAS_ATOMICS=1
         -DCOMPILER_RT_HAS_FCNTL_LCK=1 -I/ovc-rt/include -I"$rt")
  for src in InstrProfiling InstrProfilingBuffer InstrProfilingFile InstrProfilingInternal InstrProfilingMerge \
             InstrProfilingMergeFile InstrProfilingNameVar InstrProfilingPlatformLinux InstrProfilingUtil \
             InstrProfilingValue InstrProfilingVersionVar InstrProfilingWriter; do
    clang "${flags[@]}" -c "$rt/$src.c" -o "$build/$src.o"
  done
  clang++ "${flags[@]}" -fno-exceptions -fno-rtti -c "$rt/InstrProfilingRuntime.cpp" -o "$build/InstrProfilingRuntime.o"
  clang "${flags[@]}" -fvisibility=default -c /ovc/abort_dump.c -o "$build/abort_dump.o"
  llvm-ar rcs "$runtime/libclang_rt.profile.a" "$build"/*.o

  # Each compiler shim of toolchain.sh runs `clang` or `clang++` by name. This directory comes first on PATH, so its
  # wrappers add the flags to each compile and link for riscv64 (those that name one of the toolchain's
  # configurations), and leave a compile for the build machine as it is.
  for compiler in clang clang++; do
    cat > "/tmp/ovc-bin/$compiler" <<EOF
#!/bin/sh
for a in "\$@"; do
  case "\$a" in --config=/opt/asan-static/*|--config=/tmp/asan-musl-sealed*)
    exec /usr/bin/$compiler "\$@" -O0 -fprofile-instr-generate -fcoverage-mapping -Wl,--wrap=abort \\
      -Wno-unused-command-line-argument ;;
  esac
done
exec /usr/bin/$compiler "\$@"
EOF
    chmod +x "/tmp/ovc-bin/$compiler"
  done
  export PATH=/tmp/ovc-bin:$PATH
fi

# OVC_SECONDS above 0: the build is stopped after that time (oss-verify check --checks-budget).
if [ "${OVC_SECONDS:-0}" -gt 0 ]; then exec timeout -s KILL "$OVC_SECONDS" compile; fi
exec compile
